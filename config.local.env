# Local ResearchChemBench configuration template.
# Replace placeholders only on the machine running the benchmark.
# Never commit real credentials, private endpoints, worker targets, or instance IDs.

# Chemistry data services
MP_API_KEY="REPLACE_WITH_MATERIALS_PROJECT_API_KEY"
RESEARCHCHEMBENCH_PUBCHEM_PROXY_URL="REPLACE_WITH_OPTIONAL_PUBCHEM_PROXY_URL"

# Evaluated Agent
OPENAI_API_KEY="REPLACE_WITH_AGENT_API_KEY"
OPENCODE_BASE_URL_VALUE="REPLACE_WITH_AGENT_API_BASE_URL"
OPENCODE_MODEL_VALUE="REPLACE_WITH_AGENT_MODEL_NAME"

# Judge
JUDGE_API_KEY="REPLACE_WITH_JUDGE_API_KEY"
JUDGE_API_BASE="REPLACE_WITH_JUDGE_API_BASE_URL"
JUDGE_MODEL_NAME="REPLACE_WITH_JUDGE_MODEL_NAME"

# Local caches and environments
RESEARCHCHEMBENCH_ENV_ROOT="REPLACE_WITH_ENVIRONMENT_ROOT_PATH"
RESEARCHCHEMBENCH_MODEL_CACHE="REPLACE_WITH_MODEL_CACHE_PATH"

# Distributed execution. Select ssh or sandbox at submission time.
RCB_DISTRIBUTED_TRANSPORT="ssh"
RCB_DISTRIBUTED_WORKER_INVENTORY=".worker_inventory.local.json"
RCB_DISTRIBUTED_SANDBOX_INVENTORY=".sandbox_inventory.local.json"
RCB_DISTRIBUTED_STATE_ROOT="workspaces/.distributed_compute_pool"

# SSH Worker transport
RCB_DISTRIBUTED_KNOWN_HOSTS_FILE=".worker_known_hosts.local"
RCB_DISTRIBUTED_DIRECT_SSH_OPTIONS="-C"
RCB_DISTRIBUTED_REMOTE_INIT_SCRIPT_URL="REPLACE_WITH_OPTIONAL_REMOTE_PROXY_SETUP_URL"

# OpenSandbox transport. The YAML stores this variable name, never its value.
RCB_SANDBOX_API_KEY="REPLACE_WITH_SANDBOX_API_KEY"
