# OpenAI-compatible judge endpoint. Agent CLI authentication is managed by
# Codex/Claude themselves and is intentionally separate from the judge.
JUDGE_API_KEY="sk-xxx"
JUDGE_API_BASE="https://api.openai.com/v1"
JUDGE_MODEL_NAME="gpt-5.1"

# Local ChemGraph checkout and Python environment containing its dependencies.
CHEMGRAPH_ROOT="/absolute/path/to/benchmark/ChemGraph"
CHEMGRAPH_PYTHON="/absolute/path/to/ResearchChemBench/.toolbox_env/bin/python"

# Optional for direct Python/Web UI runs. The shell runner has --mcp-tools.
# Empty/unset exposes tool_config.json; a CSV exposes only the selected tools.
# RESEARCHCHEM_MCP_ENABLED_TOOLS="molecule_name_to_smiles,run_ase"

# Optional runtime limits.
RESEARCHCHEMBENCH_AGENT_TIMEOUT_SECONDS="7200"
RESEARCHCHEMBENCH_MCP_TOOL_TIMEOUT_MS="3600000"
RESEARCHCHEMBENCH_MAX_TURNS="200"

# Optional OpenCode adapter. OPENAI_API_KEY is consumed by the configured
# OpenAI-compatible provider and is never written into opencode.json.
OPENAI_API_KEY=""
RESEARCHCHEMBENCH_OPENCODE_BASE_URL="https://api.deepseek.com/v1"
RESEARCHCHEMBENCH_OPENCODE_MODEL="deepseek/deepseek-v4-flash"
