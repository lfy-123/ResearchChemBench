{
  "pipeline_contract": "researchchembench-data-pipeline/v2",
  "workspace": "runs/current",
  "stop_after": "stage07",
  "policy": "strict",
  "resume_completed_stages": true,
  "registry": {
    "enabled": true,
    "database": "registry/paper_screening_registry.sqlite",
    "export_jsonl": "registry/exports/paper_screening_registry.jsonl",
    "prune_rejected_stage00_assets": true
  },
  "execution": {
    "backend": "local",
    "sandbox": {
      "cpu": 64,
      "memory": "128Gi",
      "lifecycle_minutes": 1440,
      "startup_timeout_seconds": 3600,
      "cleanup": "stop",
      "source": ".sandboxes.local.yaml",
      "inventory": ".sandbox_inventory.local.json",
      "api_key_env": "RCB_SANDBOX_API_KEY"
    }
  },
  "source": {
    "root": "datasets/en-paper-hzzj"
  },
  "stage00": {
    "enabled": false,
    "dataset": "en-paper-hzzj",
    "count": 1000,
    "credentials": "/mnt/shared-storage-user/liyuqiang/benchmark/pipline_demo/pdfs/xinghe.txt",
    "outside": false,
    "resume": true,
    "selection": "remote_order",
    "seed": 0,
    "exclude_selected_manifests": []
  },
  "stage01": {
    "package": {
      "workers": 8,
      "enable_network": true,
      "network_workers": 8,
      "publisher_adapters": ["wiley", "elsevier", "nature", "acs", "rsc", "mdpi"],
      "paper_timeout_seconds": 180,
      "connect_timeout_seconds": 15,
      "read_timeout_seconds": 30,
      "max_attachments_per_paper": 20,
      "max_file_bytes": 104857600,
      "max_total_bytes_per_paper": 262144000
    },
    "normalization": {
      "min_main_characters": 1000,
      "min_supplementary_characters": 100,
      "min_readable_character_ratio": 0.9,
      "max_replacement_character_ratio": 0.01,
      "max_repeated_line_ratio": 0.5,
      "max_chars": 4000000,
      "grobid": {
        "base_url": "http://127.0.0.1:8070",
        "timeout_seconds": 900,
        "retries": 2,
        "workers": 4,
        "reuse_existing": true,
        "pdftotext_timeout_seconds": 300
      }
    }
  },
  "stage02": {
    "model_role": "stage02_screening",
    "workers": 8,
    "max_prompt_characters": 24000,
    "excerpt_characters": 1400,
    "max_computational_excerpts": 8,
    "max_experimental_excerpts": 8,
    "max_deterministic_experiment_evidence": 8,
    "classification_max_tokens": 12288,
    "pass_verification_max_tokens": 6144,
    "workflow_candidate_limit": 3,
    "minimum_confidence": 0.85,
    "review_pass_decisions": true
  },
  "stage03": {
    "model_role": "stage03_screening",
    "workers": 8,
    "max_prompt_payload_bytes": 18000,
    "max_evidence_payload_bytes": 9000,
    "max_tokens": 12288,
    "toolbox_capabilities": "assets/toolbox_capabilities.json",
    "software_aliases": "assets/software_aliases.json",
    "software_coverage_basis": "native_software_catalog_presence",
    "softcite": {
      "enabled": false,
      "manage_service": false,
      "base_url": "http://127.0.0.1:8060",
      "timeout_seconds": 600,
      "retries": 2
    },
    "resource_budget": {
      "cpu_cores": 128,
      "gpus": 1,
      "memory_gb": 256,
      "runtime_hours": 24,
      "core_hours": 3072,
      "gpu_hours": 24,
      "job_count": 1000
    }
  },
  "stage04": {
    "mineru": {
      "enabled": true,
      "managed_gpu": false,
      "gpu_env_dir": ".envs/researchchem-data-pipeline",
      "command": ".envs/researchchem-data-pipeline/bin/mineru",
      "api_concurrency": 3,
      "request_batch_size": 1,
      "method": "auto",
      "backend": "pipeline",
      "timeout_seconds": 3600,
      "reuse_existing": true,
      "min_markdown_chars": 100,
      "min_main_characters": 1000,
      "min_supplementary_characters": 100,
      "extra_args": ["--formula", "true", "--table", "true"],
      "environment": {
        "MINERU_TOOLS_CONFIG_JSON": ".model_cache/mineru/mineru.json"
      }
    }
  },
  "stage05": {
    "model_role": "suitability",
    "router_model_role": "stage05_router",
    "workers": 8,
    "router_candidate_limit": 3,
    "router_index_characters": 60000,
    "router_max_tokens": 3072,
    "auditor_evidence_characters": 90000,
    "auditor_max_tokens": 8192,
    "candidate_limit": 1,
    "contract_retry": true
  },
  "stage06": {
    "harness": "codex",
    "model_role": "builder",
    "scientific_review_model_role": "builder",
    "mode_generation_strategy": "single_agent",
    "preferred_scope": "full_paper_computational_workflow",
    "minimum_complexity": "medium",
    "reject_trivial_single_call": true,
    "workers": 1,
    "timeout_seconds": 7200,
    "task_pair_builder_timeout_seconds": 7200,
    "max_attempts": 3,
    "max_tool_calls": 72,
    "task_pair_builder_max_tool_calls": 72,
    "task_pair_builder_search_max_tool_calls": 36,
    "task_pair_builder_finalization_reserve": 2,
    "finalization_reserve": 2,
    "recovery_max_tool_calls": 8,
    "task_pair_builder_recovery_max_tool_calls": 24,
    "task_pair_builder_recovery_finalization_reserve": 2,
    "scientific_review_max_tool_calls": 24,
    "scientific_review_recovery_max_tool_calls": 16,
    "scientific_review_finalization_reserve": 4,
    "structured_finalization_max_tokens": 32768,
    "autonomous_task_max_tool_calls": 20,
    "autonomous_task_finalization_reserve": 6,
    "reproduction_task_max_tool_calls": 20,
    "reproduction_task_finalization_reserve": 6,
    "hidden_reference_max_tool_calls": 12,
    "hidden_reference_finalization_reserve": 2,
    "retry_backoff_seconds": 5,
    "retry_max_seconds": 60,
    "resume": true,
    "codex_wire_api": "chat_completions",
    "codex_chat_json_schema": true,
    "codex_structured_final_tool": true,
    "max_turns": 32,
    "resource_policy": {
      "cpu_cores": 48,
      "memory_mb": 131072,
      "gpu_count": 0,
      "walltime_hours": 24
    }
  },
  "stage07": {
    "harness": "codex",
    "model_role": "judge",
    "workers": 1,
    "timeout_seconds": 7200,
    "max_attempts": 3,
    "max_tool_calls": 16,
    "audit_max_tool_calls": 8,
    "audit_finalization_reserve": 7,
    "finalization_reserve": 4,
    "recovery_max_tool_calls": 8,
    "audit_recovery_max_tool_calls": 6,
    "retry_backoff_seconds": 5,
    "retry_max_seconds": 60,
    "resume": true,
    "codex_wire_api": "chat_completions",
    "codex_chat_json_schema": true,
    "codex_structured_final_tool": true,
    "max_turns": 24,
    "resource_policy": {
      "cpu_cores": 48,
      "memory_mb": 131072,
      "gpu_count": 0,
      "walltime_hours": 24
    }
  },
  "models": {
