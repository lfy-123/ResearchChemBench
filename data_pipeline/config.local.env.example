# Stage 04 resource interpretation model (OpenAI-compatible API).
RESOURCE_LLM_URL=https://api.deepseek.com/v1
RESOURCE_LLM_API_KEY=
RESOURCE_LLM_MODEL_NAME=deepseek-v4-flash

# OpenSandbox management API. The value is never written to YAML or inventory files.
RCB_SANDBOX_API_KEY=

# Shared OpenAI-compatible endpoint for OpenCode Builder/Judge agents.
JUDGE_API_BASE=https://api.deepseek.com/v1
JUDGE_API_KEY=

# Stage 06 Builder agent: opencode, codex, or claude.
BUILDER_AGENT_CLI=opencode
BUILDER_AGENT_MODEL=deepseek/deepseek-v4-flash
BUILDER_AGENT_BASE_URL=https://api.deepseek.com/v1

# Stage 07 Judge agent: opencode, codex, or claude.
JUDGE_AGENT_CLI=opencode
JUDGE_AGENT_MODEL=deepseek/deepseek-v4-flash
JUDGE_AGENT_BASE_URL=https://api.deepseek.com/v1

# Optional Stage 05 API credentials and polite-pool contact metadata.
SCHOLARLY_API_MAILTO=
OPENALEX_API_KEY=
GITHUB_TOKEN=
OSF_TOKEN=
ZENODO_ACCESS_TOKEN=

# Optional model-download mirror and timeouts.
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DOWNLOAD_TIMEOUT=600
HF_HUB_ETAG_TIMEOUT=60

# Set only when Java from the active Conda environment is not auto-detected.
# GROBID_JAVA_HOME=/path/to/conda/env
