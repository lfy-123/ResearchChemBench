# Local-only data-pipeline configuration. Copy this file to config.local.env.
# Never commit real credentials or internal endpoints.

# OpenSandbox lifecycle management.
RCB_SANDBOX_API_KEY=

# New API gateway used by Stage02, Stage03, and Stage05 in API-only mode.
# The remote-server endpoint requires the user's SSH reverse tunnel on port 13000.
RCB_NEW_API_KEY=
RCB_NEW_API_BASE_URL=http://127.0.0.1:13000/v1
# OPENAI_API_KEY/OPENAI_BASE_URL from `如何调用所有模型.md` are accepted as fallbacks.

# Stage02 and Stage03 screening model. A managed local worker may override these
# values at runtime; these values also support a remote OpenAI-compatible API.
RCB_SCREENING_API_KEY=
RCB_SCREENING_BASE_URL=https://api.deepseek.com/v1
RCB_SCREENING_MODEL=deepseek-v4-flash

# Optional dedicated Stage02/Stage03 overrides. When omitted, JSON configuration applies.
RCB_STAGE02_SCREENING_API_KEY=
RCB_STAGE02_SCREENING_BASE_URL=http://127.0.0.1:13000/v1
RCB_STAGE02_SCREENING_MODEL=DeepSeek-V4-Pro
RCB_STAGE02_SCREENING_FALLBACK_MODELS=Nex-N2-Pro,DeepSeek-V4-Flash,Nex-N2-Pro-w8a8,DeepSeek-V4-Flash-DSpark,MiniMax-M2.7,Mimo-V2.5-Pro,Qwen3.6-27B
RCB_STAGE03_SCREENING_API_KEY=
RCB_STAGE03_SCREENING_BASE_URL=http://127.0.0.1:13000/v1
RCB_STAGE03_SCREENING_MODEL=Nex-N2-Pro
RCB_STAGE03_SCREENING_FALLBACK_MODELS=DeepSeek-V4-Pro,DeepSeek-V4-Flash,Nex-N2-Pro-w8a8,DeepSeek-V4-Flash-DSpark,MiniMax-M2.7,Mimo-V2.5-Pro,Qwen3.6-27B

# Stage05A evidence router.
RCB_STAGE05_ROUTER_API_KEY=
RCB_STAGE05_ROUTER_BASE_URL=https://api.deepseek.com/v1
RCB_STAGE05_ROUTER_MODEL=deepseek-v4-flash

# Stage05B benchmark-suitability auditor.
RCB_SUITABILITY_API_KEY=
RCB_SUITABILITY_BASE_URL=https://api.deepseek.com/v1
RCB_SUITABILITY_MODEL=deepseek-v4-pro

# Stage06 Builder.
RCB_STAGE06_HARNESS=codex
# Keep `builder` by default; `suitability` is an optional escalation only when its API supports the harness.
RCB_STAGE06_REVIEW_MODEL_ROLE=builder
RCB_BUILDER_API_KEY=
RCB_BUILDER_BASE_URL=https://api.deepseek.com/v1
RCB_BUILDER_MODEL=deepseek-v4-flash
# Optional Codex/bridge protocol policy. Use required_until_artifact for
# gateways/models that may terminate without selecting a workspace tool.
RCB_BUILDER_CODEX_WIRE_API=chat_completions
RCB_BUILDER_TOOL_CHOICE_POLICY=auto
RCB_BUILDER_RESPONSE_FORMAT_POLICY=auto

# Stage07 Judge.
RCB_STAGE07_HARNESS=codex
RCB_JUDGE_API_KEY=
RCB_JUDGE_BASE_URL=https://api.deepseek.com/v1
RCB_JUDGE_MODEL=deepseek-v4-flash
RCB_JUDGE_CODEX_WIRE_API=chat_completions
RCB_JUDGE_TOOL_CHOICE_POLICY=auto
RCB_JUDGE_RESPONSE_FORMAT_POLICY=auto

# Optional network and model-download settings.
RCB_SETUP_PROXY=1
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DOWNLOAD_TIMEOUT=600
HF_HUB_ETAG_TIMEOUT=60

# Set only when Java from the active Conda environment is not auto-detected.
# GROBID_JAVA_HOME=/path/to/conda/env
