# Copy this file to config.local.env and fill only the values you need.
# config.local.env is ignored by version control and loaded by run_agent_eval.sh.

# External chemistry services
MP_API_KEY=

# Agent API credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional LLM judge configuration
JUDGE_API_KEY=
JUDGE_API_BASE=
JUDGE_MODEL_NAME=

# Optional manually installed chemistry executables
CHEMGRAPH_ORCA_COMMAND=
CHEMGRAPH_CENSO_COMMAND=
CHEMGRAPH_GNINA_COMMAND=

# Optional location for downloaded model weights. When empty, the project uses
# ResearchChemBench/.model_cache (ignored by Git), not an Agent application's cache.
RESEARCHCHEMBENCH_MODEL_CACHE=
