# ResearchChemBench 本机配置模板。
#
# 使用方法：
#   cp config.local.env.example config.local.env
#   chmod 600 config.local.env
#   ${EDITOR:-vi} config.local.env
#   set -a; source config.local.env; set +a
#
# config.local.env 会被 Git 忽略。不要把真实 API key、token、密码、内部地址或
# worker 身份提交到仓库。空字符串表示禁用相应功能或使用代码中的默认值。
#
# 标记说明：
#   [条件必填] 仅在启用所述功能时必须设置。
#   [可选]     不设置时有默认值，或只在需要覆盖默认行为时设置。
#   [信息字段] 供配置生成器、运维人员或审计使用；当前运行时不直接读取。
#
# 仅使用本机化学后端、不访问受认证数据源、不运行真实 Agent/Judge 时，没有全局
# 必填变量；默认的 `.envs`、`.model_cache`、`.runtime_cache` 和 `.software_cache`
# 布局无需额外配置。


###############################################################################
# 化学数据服务
###############################################################################

# [条件必填：search_materials]
# Materials Project 账户 API key。用于 Materials Project summary REST API，
# 查询材料编号、化学式、结构、稳定性、带隙等数据。
# 申请/查看：https://materialsproject.org/dashboard
# 官方说明：https://docs.materialsproject.org/downloading-data/using-the-api/getting-started
MP_API_KEY=""

# [条件必填：search_catalysis_records]
# Catalysis Hub GraphQL API 的个人 API key。运行时通过 X-API-Key 请求头发送，
# 用于查询反应物、产物、反应能、活化能、表面组成等催化数据。
# 密钥免费并绑定 ORCID；登录或注册 ORCID 后会返回个人 key。
# 申请：https://api.catalysis-hub.org/auth/login
# GraphQL endpoint：https://api.catalysis-hub.org/graphql
CATALYSIS_HUB_API_KEY=""


###############################################################################
# 被评测 Agent（OpenCode / OpenAI-compatible provider）
###############################################################################

# [条件必填：使用真实 opencode Agent]
# OpenCode 调用模型供应商时使用的凭证。变量名由 OpenCode/OpenAI-compatible
# 接口约定，但 key 必须与 OPENCODE_BASE_URL_VALUE 指向的供应商匹配。
# 当前示例使用 DeepSeek：
#   申请：https://platform.deepseek.com/api_keys
#   文档：https://api-docs.deepseek.com/
# 如果改用 OpenAI：
#   申请：https://platform.openai.com/api-keys
# mock Agent 或不运行 Agent 评测时可以留空。
OPENAI_API_KEY=""

# [可选：使用 opencode Agent]
# OpenAI-compatible API 根地址。scripts/run_agent_eval.sh 会把该值转换为
# RESEARCHCHEMBENCH_OPENCODE_BASE_URL。留空时当前代码默认使用
# https://api.deepseek.com/v1。
OPENCODE_BASE_URL_VALUE="https://api.deepseek.com/v1"

# [可选：使用 opencode Agent]
# OpenCode 模型标识。可以使用 provider/model（例如
# deepseek/deepseek-v4-flash），也可以使用当前供应商可识别的模型名。
# 留空时使用 evaluation/settings.py 中的默认模型。
OPENCODE_MODEL_VALUE="deepseek-v4-flash"


###############################################################################
# LLM Judge
###############################################################################

# 以下三个变量在启用 LLM 评分时共同构成一套配置；使用 --no-score 时均可留空。
# Judge key 不会传给被评测 Agent。可以与 Agent 使用同一供应商，但生产评测建议
# 使用独立 key，以便隔离权限、额度和审计记录。

# [条件必填：启用 LLM Judge]
# Judge 供应商 API key。来源取决于 JUDGE_API_BASE；当前示例为 DeepSeek，申请：
# https://platform.deepseek.com/api_keys
JUDGE_API_KEY=""

# [条件必填：启用 LLM Judge]
# Judge 的 OpenAI-compatible API 根地址。
JUDGE_API_BASE="https://api.deepseek.com/v1"

# [条件必填：启用 LLM Judge]
# Judge 使用的供应商模型名。也可以在单次运行时用 --judge-model 覆盖。
JUDGE_MODEL_NAME="deepseek-v4-flash"


###############################################################################
# 项目路径、环境和缓存迁移
###############################################################################

# [可选]
# 全部 Conda 环境的共同根目录。只有整体迁移 .envs 时才设置。
# 默认：<repository>/.envs
RESEARCHCHEMBENCH_ENV_ROOT=""

# [可选]
# framework 环境的精确路径。仅当 researchchembench 环境不位于
# ${RESEARCHCHEMBENCH_ENV_ROOT}/researchchembench 时设置。
# 默认：<env-root>/researchchembench
RESEARCHCHEMBENCH_FRAMEWORK_ENV=""

# [可选]
# 模型权重与模型元数据根目录，供 MACE、DeepMD、NequIP、Allegro 等后端使用。
# 目录中的大模型文件由运维人员单独下载或复制，不由 Git 管理。
# 默认：<repository>/.model_cache
RESEARCHCHEMBENCH_MODEL_CACHE=""

# [可选]
# 可再生运行时缓存目录，同时可作为 XDG_CACHE_HOME。适合放下载缓存、编译缓存、
# embedding 缓存等，不应放唯一副本的模型或软件。
# 默认：<repository>/.runtime_cache
RESEARCHCHEMBENCH_RUNTIME_CACHE=""

# [可选]
# 原生软件缓存根目录。只有整体迁移 .software_cache 时才设置；迁移后的软件启动器
# 和环境构建脚本会使用该路径定位软件、离线 wheel 和运行库。
# 默认：<repository>/.software_cache
RESEARCHCHEMBENCH_SOFTWARE_ROOT=""

# [可选]
# 主节点执行评测前加载的可信代理初始化脚本 URL。run_agent_eval.sh 优先读取本变量，
# 未设置时回退到 RCB_DISTRIBUTED_REMOTE_INIT_SCRIPT_URL。
# 只允许填写可信内部脚本，因为该 URL 的内容会被 source 到当前 shell。
RESEARCHCHEMBENCH_PROXY_SETUP_URL=""


###############################################################################
# 分布式执行：公共选择与状态
###############################################################################

# [可选]
# local 或 distributed。通常由 --execution-mode 设置；留空等价于 local。
RESEARCHCHEMBENCH_EXECUTION_MODE=""

# [可选：distributed]
# ssh 或 sandbox（opensandbox 也会规范化为 sandbox）。命令行
# --distributed-transport 可以覆盖它；未明确设置时脚本默认 ssh。
RCB_DISTRIBUTED_TRANSPORT=""

# [条件必填：distributed，推荐]
# 通用 worker inventory JSON 路径，优先级高于 RCB_DISTRIBUTED_WORKER_INVENTORY。
# 一般由提交脚本根据 transport 自动选择，手工统一覆盖时才设置。
RCB_DISTRIBUTED_INVENTORY=""

# [条件必填：SSH distributed，且未设置通用 inventory 或 inline worker]
# SSH worker inventory JSON。推荐由 scripts/update_worker_inventory.py 根据
# .workers.local.yaml 探测并生成，不要手写过期的 CPU、内存或网络信息。
RCB_DISTRIBUTED_WORKER_INVENTORY=".worker_inventory.local.json"

# [条件必填：Sandbox distributed，且未设置 RCB_DISTRIBUTED_INVENTORY]
# OpenSandbox worker inventory JSON。由 scripts/create_sandbox_pool.sh 或
# scripts/update_sandbox_inventory.py 生成。
RCB_DISTRIBUTED_SANDBOX_INVENTORY=".sandbox_inventory.local.json"

# [可选]
# 分布式 reservation、lease 和调度状态目录。必须位于主节点可写目录。
# 默认：<repository>/workspaces/.distributed_compute_pool
RCB_DISTRIBUTED_STATE_ROOT=""

# [可选]
# worker lease 失效秒数，最小 60，默认 900。只有在长时间网络抖动或特殊调度策略下
# 才调整；设置过大可能延迟回收失联 worker 的资源。
RCB_DISTRIBUTED_LEASE_TIMEOUT_SECONDS=""


###############################################################################
# SSH distributed
###############################################################################

# 推荐流程：
#   1. 在 .workers.local.yaml 中维护 SSH worker 来源。
#   2. 运行：
#      .envs/researchchembench/bin/python scripts/update_worker_inventory.py \
#        --input .workers.local.yaml \
#        --output .worker_inventory.local.json \
#        --known-hosts .worker_known_hosts.local
#   3. 将 RCB_DISTRIBUTED_WORKER_INVENTORY 指向生成的 JSON。

# [条件必填：StrictHostKeyChecking=yes 的 SSH distributed]
# SSH known_hosts 文件。由 update_worker_inventory.py 生成或由管理员提供。
RCB_DISTRIBUTED_KNOWN_HOSTS_FILE=".worker_known_hosts.local"

# [可选：SSH distributed]
# 计算任务实际使用的 ssh 参数。当前运行时会直接读取该变量。不要使用
# StrictHostKeyChecking=no；生产环境应固定 UserKnownHostsFile。
RCB_DISTRIBUTED_DIRECT_SSH_OPTIONS="-o BatchMode=yes -o ConnectTimeout=8 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=.worker_known_hosts.local"

# [可选：SSH worker 初始化]
# 在远端任务启动前加载的可信初始化脚本，例如内部代理配置。该内容会在远端 shell
# 中执行；只有网络访问确实需要时才设置。
RCB_DISTRIBUTED_REMOTE_INIT_SCRIPT_URL=""

# 下列公共字段存在于部分旧版/生成式 config.local.env 中。当前调度器优先使用 JSON
# inventory；这些变量不会替代有效 inventory。保留它们主要用于配置生成、运维说明
# 和向后兼容。

# [信息字段] 是否由外部运维逻辑启用 worker；当前 Python 调度器不直接读取。
RCB_DISTRIBUTED_WORKERS_ENABLED="0"

# [条件必填：不使用 inventory JSON、改用旧版 inline worker 配置]
# inline worker 数量。使用 JSON inventory 时应为 0 或留空。
RCB_DISTRIBUTED_WORKER_COUNT="0"

# [信息字段] 远端计算文件所有者；连接用户应实际写入 EXECUTION_SSH_TARGET。
RCB_DISTRIBUTED_EXECUTION_USER=""

# [信息字段] worker 上可见的仓库绝对路径；现代配置保存在 inventory 中。
RCB_DISTRIBUTED_PROJECT_ROOT=""

# [信息字段] 交互式 gateway ssh 参数；当前任务执行读取 DIRECT_SSH_OPTIONS。
RCB_DISTRIBUTED_GATEWAY_SSH_OPTIONS=""

# [信息字段] inventory 生成阶段的调度策略标签；当前运行时以 inventory 为准。
RCB_DISTRIBUTED_SCHEDULING_POLICY="largest_cpu_first"

# Inline worker 字段模板。仅在没有 RCB_DISTRIBUTED_INVENTORY 和
# RCB_DISTRIBUTED_WORKER_INVENTORY 时，调度器才读取 WORKER_COUNT 以及下列
# WORKER_1_* 字段。需要多个 worker 时复制整个块并把 1 改为 2、3、...，编号上限由
# RCB_DISTRIBUTED_WORKER_COUNT 决定。

# [可选] 是否启用该 worker；默认 1。当前实际配置可以用它临时隔离节点。
RCB_DISTRIBUTED_WORKER_1_ENABLED="1"

# [可选] 调度器唯一 ID；默认 compute-1。多个 worker 不得重复。
RCB_DISTRIBUTED_WORKER_1_ID="compute-1"

# [可选] 人类可读名称；默认与 ID 相同，不参与 SSH 寻址。
RCB_DISTRIBUTED_WORKER_1_NAME="compute-1"

# [信息字段] 交互式 gateway 目标；当前 batch 任务使用 EXECUTION_SSH_TARGET。
RCB_DISTRIBUTED_WORKER_1_GATEWAY_SSH_TARGET=""

# [条件必填：inline SSH worker]
# batch 任务实际连接目标，格式通常为 user@host 或 user@ip。
RCB_DISTRIBUTED_WORKER_1_EXECUTION_SSH_TARGET=""

# [可选] worker 直连 IP，主要用于审计和生成 inventory；不能替代 SSH target。
RCB_DISTRIBUTED_WORKER_1_DIRECT_IP=""

# [信息字段] worker 主机名；inline loader 不依赖它。
RCB_DISTRIBUTED_WORKER_1_HOSTNAME=""

# [条件必填：inline SSH worker]
# Linux affinity 可见的逻辑 CPU 数量，不是物理核数。
RCB_DISTRIBUTED_WORKER_1_LOGICAL_CPUS="0"

# [条件必填：inline SSH worker]
# 实际物理核心数，用于 SMT 语义和资源展示。
RCB_DISTRIBUTED_WORKER_1_PHYSICAL_CORES="0"

# [条件必填：inline SSH worker]
# worker 总内存，单位 MiB。
RCB_DISTRIBUTED_WORKER_1_MEMORY_MB="0"

# [条件必填：inline SSH worker]
# 允许调度器分配的 CPU 数；不得超过对应 affinity/可用物理资源。
RCB_DISTRIBUTED_WORKER_1_AVAILABLE_CPU_CORES="0"

# [条件必填：inline SSH worker]
# 允许调度器分配的内存，单位 MiB；应为系统和 RPC 进程保留余量。
RCB_DISTRIBUTED_WORKER_1_AVAILABLE_MEMORY_MB="0"

# [可选] GPU 数量；CPU-only worker 为 0。
RCB_DISTRIBUTED_WORKER_1_GPU_COUNT="0"

# [可选：inline SSH worker，非连续 affinity 时强烈建议设置]
# 可分配 CPU ID，可写范围（如 6-25,32-51）或逗号列表。留空时使用
# 0..LOGICAL_CPUS-1。调度器也接受同前缀的 COMPUTE_CPU_IDS；当两者都设置时
# COMPUTE_CPU_IDS 优先。
RCB_DISTRIBUTED_WORKER_1_CPU_AFFINITY=""
RCB_DISTRIBUTED_WORKER_1_COMPUTE_CPU_IDS=""

# [信息字段] 为主机/系统保留的 CPU 和内存；inline loader 不直接读取，实际可调度
# 数量必须通过 AVAILABLE_CPU_CORES 和 AVAILABLE_MEMORY_MB 表达。
RCB_DISTRIBUTED_WORKER_1_RESERVED_CPU_CORES="0"
RCB_DISTRIBUTED_WORKER_1_RESERVED_MEMORY_MB="0"

# [信息字段] 最近一次探测状态；inline loader 不直接读取，运行时会重新检查连接。
RCB_DISTRIBUTED_WORKER_1_CONNECTIVITY_STATUS="unknown"


###############################################################################
# OpenSandbox distributed
###############################################################################

# [可选：创建/更新 OpenSandbox 池]
# OpenSandbox source YAML，保存 environment 规格、sandbox ID、挂载、端口和生命周期。
# 不是凭证。scripts/create_sandbox_pool.sh 默认写入 .sandboxes.local.yaml。
RCB_DISTRIBUTED_SANDBOX_SOURCE=".sandboxes.local.yaml"

# [条件必填：创建、探测或使用 OpenSandbox]
# PJLab OpenSandbox/Brainbox 项目 API key。该 key 不是公开互联网服务密钥，应从
# https://h.pjlab.org.cn/brainbox 对应项目或项目管理员处获取。它用于创建、停止、
# 删除 sandbox/environment，以及取得 command/RPC proxy access token。
RCB_SANDBOX_API_KEY=""

# RCB_DISTRIBUTED_SANDBOX_INVENTORY 已在公共分布式配置区定义。推荐生成方式：
#   bash scripts/create_sandbox_pool.sh --replace
# 或：
#   .envs/researchchembench/bin/python scripts/update_sandbox_inventory.py \
#     --input .sandboxes.local.yaml \
#     --output .sandbox_inventory.local.json
