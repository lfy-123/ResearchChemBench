# Copy this file to config.local.env and set only values used on the host.
# config.local.env is ignored by Git and must never contain committed secrets.

# Chemistry data services
MP_API_KEY=
CATALYSIS_HUB_API_KEY=

# Evaluated Agent
OPENAI_API_KEY=
OPENCODE_BASE_URL_VALUE=
OPENCODE_MODEL_VALUE=

# Judge
JUDGE_API_KEY=
