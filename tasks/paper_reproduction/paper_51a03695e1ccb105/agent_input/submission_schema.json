    "oneOf": [{"required": ["activation_free_energy_kcal_mol", "reaction_free_energy_kcal_mol"], "properties": {"status": {"const": "validated"}}}, {"required": ["limitation"], "properties": {"status": {"const": "bounded_failure"}}}]
  }
}
