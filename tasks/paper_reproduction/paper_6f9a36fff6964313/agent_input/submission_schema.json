{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": ["status", "method", "systems", "conclusion", "limitations"],
    "oneOf": [
      {"properties": {"status": {"const": "complete"}}, "required": ["comparison", "tfap_carbonyl_charge", "tmtfaba_carbonyl_charge", "ptma_nitrogen_charge", "tmtfaba_nitrogen_charge"]},
      {"properties": {"status": {"const": "bounded_failure"}}, "required": ["failure"]}
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "bounded_failure"
        ]
      },
      "method": {
        "type": "object",
        "required": [
          "software",
          "geometry_protocol",
          "population_protocol",
          "solvent",
          "validation_protocol"
        ],
        "properties": {
          "software": {
            "type": "string"
          },
          "geometry_protocol": {
            "type": "string"
          },
          "population_protocol": {
            "type": "string"
          },
          "solvent": {
            "type": "string"
          },
          "validation_protocol": {
            "type": "string"
          }
        }
      },
      "systems": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "required": [
            "system_id"
          ],
          "oneOf": [
            {"required": ["structure_provenance", "validation", "atom_identity", "charge_provenance", "charges"]},
            {"required": ["failure_evidence"]}
          ],
          "properties": {
            "system_id": {
              "type": "string"
            },
            "structure_provenance": {
              "type": "string"
            },
            "validation": {
              "type": "object",
              "required": [
                "converged",
                "minimum_evidence"
              ],
              "properties": {
                "converged": {
                  "type": "boolean"
                },
                "minimum_evidence": {
                  "type": "string"
                }
              }
            },
            "atom_identity": {"type": "string"},
            "charge_provenance": {"type": "string"},
            "failure_evidence": {"type": "string"},
            "charges": {
              "type": "object",
              "properties": {
                "carbonyl_carbon": {
                  "type": "number"
                },
                "quaternary_nitrogen": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "comparison": {
        "type": "object",
        "required": [
          "carbonyl_difference_tmtfaba_minus_tfap",
          "nitrogen_difference_tmtfaba_minus_ptma"
        ],
        "properties": {
          "carbonyl_difference_tmtfaba_minus_tfap": {
            "type": "number"
          },
          "nitrogen_difference_tmtfaba_minus_ptma": {
            "type": "number"
          }
        }
      },
      "conclusion": {
        "type": "string"
      },
      "limitations": {
        "type": "string"
      },
      "failure": {
        "type": "object",
        "properties": {
          "systems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "string"
          }
        }
      },
      "tfap_carbonyl_charge": {
        "type": "number"
      },
      "tmtfaba_carbonyl_charge": {
        "type": "number"
      },
      "ptma_nitrogen_charge": {
        "type": "number"
      },
      "tmtfaba_nitrogen_charge": {
        "type": "number"
      }
    }
  }
}
