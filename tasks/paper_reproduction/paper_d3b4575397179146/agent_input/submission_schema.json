{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "required_files": ["report/results.json"],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": ["status", "systems", "overall_conclusion", "provenance", "limitations"],
    "properties": {
      "status": {"type": "string", "enum": ["complete", "partial", "bounded_failure"]},
      "systems": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "required": ["system_id", "identity", "system_conclusion"], "properties": {"system_id": {"type": "string", "enum": ["dFHeptZ", "dClHeptZ", "dOMeHeptZ", "dMeHeptZ"]}, "identity": {"type": "object", "required": ["name", "formula", "smiles", "charge", "multiplicity", "evidence"], "properties": {"name": {"type": "string"}, "formula": {"type": "string"}, "smiles": {"type": "string"}, "charge": {"const": 0}, "multiplicity": {"const": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}, "system_conclusion": {"type": "string", "minLength": 1}, "validation": {"type": "object"}, "transitions": {"type": "array", "items": {"type": "object"}}, "orbital_localization": {"type": "object"}, "partial_ground_state": {"type": "object"}, "failure_record": {"type": "object", "required": ["attempted_method", "failure_point", "limitation", "evidence"], "properties": {"attempted_method": {"type": "string", "minLength": 1}, "failure_point": {"type": "string", "minLength": 1}, "limitation": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}}}}, "oneOf": [{"required": ["validation", "transitions", "orbital_localization"]}, {"required": ["failure_record"]}]}},
      "overall_conclusion": {"type": "string", "minLength": 1},
      "provenance": {"type": "object", "required": ["software_or_code", "methods", "solvent", "state_count_or_scope"], "properties": {"software_or_code": {"type": "string"}, "methods": {"type": "string"}, "solvent": {"type": "string"}, "state_count_or_scope": {"type": "string"}}},
      "limitations": {"type": "string", "minLength": 1}
    }
  }
}
