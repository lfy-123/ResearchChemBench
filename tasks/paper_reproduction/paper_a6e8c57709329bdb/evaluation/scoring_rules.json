      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.observables.gap_eV"
        ],
        "comparison": "absolute difference"
      },
      "type": "numeric",
      "reference_id": "pr_r1"
    },
    {
      "rule_id": "pr_s6",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.orbital_localization"
        ],
