{
  "type": "object",
  "required_files": [
    "report/results.json",
    "report/structures",
    "report/figures"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "method",
      "species",
      "conclusion",
      "limitations",
      "contact_summary",
      "charge_summary"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "bounded_failure"
        ]
      },
      "method": {
        "type": "object",
        "required": [
          "software",
          "model",
          "optimization",
          "frequency",
          "charge_analysis",
          "mapping_notes"
        ],
        "properties": {
          "software": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "optimization": {
            "type": "string"
          },
          "frequency": {
            "type": "string"
          },
          "charge_analysis": {
            "type": "string"
          },
          "mapping_notes": {
            "type": "string"
          }
        }
      },
      "species": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "required": [
            "name",
            "status"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "status": {
              "type": "string",
              "enum": [
                "computed",
                "failed"
              ]
            }
          },
          "oneOf": [
            {
              "properties": {
                "structure_file": {
                  "type": "string"
                },
                "imaginary_frequency_count": {
                  "type": "integer",
                  "minimum": 0
                },
                "distances": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "label",
                      "atom_indices",
                      "value_angstrom"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "atom_indices": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "type": "integer",
                          "minimum": 1
                        }
                      },
                      "value_angstrom": {
                        "type": "number"
                      }
                    }
                  }
                },
                "charges": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "atom_index",
                      "role",
                      "value_e"
                    ],
                    "properties": {
                      "atom_index": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "role": {
                        "type": "string"
                      },
                      "value_e": {
                        "type": "number"
                      }
                    }
                  }
                },
                "mep_observation": {
                  "type": "string"
                }
              },
              "required": [
                "structure_file",
                "imaginary_frequency_count",
                "distances",
                "charges",
                "mep_observation"
              ]
            },
            {
              "properties": {
                "failure_reason": {
                  "type": "string",
                  "minLength": 1
                },
                "missing_observables": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "failure_reason"
              ]
            }
          ]
        }
      },
      "conclusion": {
        "type": "object",
        "required": [
          "mechanistic_claim",
          "supporting_observations",
          "alternative_or_scope",
          "confidence"
        ],
        "properties": {
          "mechanistic_claim": {
            "type": "string"
          },
          "supporting_observations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "alternative_or_scope": {
            "type": "string"
          },
          "confidence": {
            "type": "string"
          }
        }
      },
      "limitations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "contact_summary": {
        "type": "object",
        "required": [
          "PO",
          "PA"
        ],
        "properties": {
          "PO": {
            "type": "object",
            "required": [
              "O_P_A",
              "O_alphaH_A",
              "O_betaH_A"
            ],
            "properties": {
              "O_P_A": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "O_alphaH_A": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "O_betaH_A": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "PA": {
            "type": "object",
            "required": [
              "O_P_A",
              "O_alphaH_A",
              "O_betaH_A"
            ],
            "properties": {
              "O_P_A": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "O_alphaH_A": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "O_betaH_A": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      },
      "charge_summary": {
        "type": "object",
        "required": [
          "free",
          "PO",
          "PA"
        ],
        "properties": {
          "free": {
            "type": "object",
            "required": [
              "P_e"
            ],
            "properties": {
              "P_e": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "PO": {
            "type": "object",
            "required": [
              "P_e"
            ],
            "properties": {
              "P_e": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          },
          "PA": {
            "type": "object",
            "required": [
              "P_e"
            ],
            "properties": {
              "P_e": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
