{
  "rules": [
    {
      "rule_id": "r_pr_minima",
      "type": "condition",
      "expected": "Each species has a frequency validation and structure artifact, or an exact bounded-failure record.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.species[*].imaginary_frequency_count",
          "$.species[*].structure_file",
          "$.species[*].status"
        ],
        "comparison": "expert scientific comparison"
      },
      "reference_id": "kp_pr_process_minima"
    },
    {
      "rule_id": "r_pr_mapping",
      "type": "semantic",
      "expected": "Atom-indexed distances use explicit per-species identities and αH/βH definitions.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.species[*].distances[*].atom_indices",
          "$.method.mapping_notes"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "kp_pr_process_mapping"
    },
    {
      "rule_id": "r_pr_mep",
      "type": "semantic",
      "expected": "Signed MEP observations address the positive phosphorus-containing region and negative carboxylate region with explicit artifacts and scope; distinguish electrostatic potential from electron density and note the source's blue-region wording limitation.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.species[*].mep_observation"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "kp_pr_mep"
    },
    {
      "rule_id": "r_pr_final",
      "type": "semantic",
      "expected": "Validated calculations support the qualitative phosphonium interaction hypothesis but are not complete catalytic proof.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion.mechanistic_claim",
          "$.conclusion.supporting_observations"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "con_pr_final"
    },
    {
      "rule_id": "r_pr_limits",
      "type": "semantic",
      "expected": "Limitations restrict inference to isolated ground-state calculations and avoid unsupported full-catalysis claims.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion.alternative_or_scope",
          "$.limitations"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "con_pr_limits"
    },
    {
      "rule_id": "r_pr_po_OP",
      "type": "numeric",
      "reference_id": "kp_pr_distances",
      "target": 1.828,
      "unit": "angstrom",
      "tolerance": 0.25,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.contact_summary.PO.O_P_A"
        ],
        "comparison": "absolute difference; explicitly named species/contact; Figure 6 source target"
      }
    },
    {
      "rule_id": "r_pr_po_OalphaH",
      "type": "numeric",
      "reference_id": "kp_pr_distances",
