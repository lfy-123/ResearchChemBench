    {
      "rule_id": "r_pr_H_charge",
      "type": "semantic",
      "reference_id": "kp_pr_charge",
      "expected": "All N-ethyl alpha/ beta H charges and source-selected contact-H values are atom-mapped; report the redistribution and asymmetry rather than applying one number to all sites.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.species[*].charges",
          "$.charge_summary"
        ],
        "comparison": "expert semantic comparison"
      }
    }
  ],
  "paper_id": "paper_ef26687d63a37e29"
