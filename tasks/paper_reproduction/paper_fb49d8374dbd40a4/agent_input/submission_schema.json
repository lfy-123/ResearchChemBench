{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required_files": ["report/results.json"],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": ["status", "system", "method", "validation", "conclusion"],
    "properties": {
      "status": {"type": "string", "enum": ["success", "bounded_failure"]},
      "system": {
        "type": "object",
        "required": ["database", "record_id", "molecule_identity", "selected_sites"],
        "properties": {
          "database": {"type": "string"}, "record_id": {"type": "string"}, "molecule_identity": {"type": "string"},
          "selected_sites": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["site_id", "element", "oxidation_state", "multiplicity", "coordination_description"], "properties": {"site_id": {"type": "string"}, "element": {"type": "string"}, "oxidation_state": {"type": "string"}, "multiplicity": {"type": "integer"}, "coordination_description": {"type": "string"}}}}
        }
      },
      "method": {"type": "object", "required": ["software", "model_description", "state_treatment", "geometry_handling", "diagnostic_paths"], "properties": {"software": {"type": "string"}, "model_description": {"type": "string"}, "state_treatment": {"type": "string"}, "geometry_handling": {"type": "string"}, "diagnostic_paths": {"type": "array", "items": {"type": "string"}}}},
      "observables": {"type": "object", "required": ["D_cm-1", "E_over_D", "g_principal", "lowest_KD_gap_cm-1"], "properties": {"D_cm-1": {"type": "number"}, "E_over_D": {"type": "number"}, "g_principal": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "lowest_KD_gap_cm-1": {"type": "number"}}},
      "validation": {"type": "object", "required": ["structure_verified", "convergence_or_failure", "state_validation", "tensor_site_binding", "notes"], "properties": {"structure_verified": {"type": "boolean"}, "convergence_or_failure": {"type": "string"}, "state_validation": {"type": "string"}, "tensor_site_binding": {"type": "string"}, "notes": {"type": "array", "items": {"type": "string"}}}},
      "conclusion": {"type": "object", "required": ["claim", "anisotropy_interpretation", "limitations"], "properties": {"claim": {"type": "string"}, "anisotropy_interpretation": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}}}},
      "failure": {"type": "object", "required": ["blocker", "completed_work"], "properties": {"blocker": {"type": "string"}, "completed_work": {"type": "array", "items": {"type": "string"}}}}
    },
    "oneOf": [
      {"required": ["status", "observables"], "properties": {"status": {"type": "string", "pattern": "^success$"}}},
      {"required": ["status", "failure"], "properties": {"status": {"type": "string", "pattern": "^bounded_failure$"}}}
    ]
  }
}
