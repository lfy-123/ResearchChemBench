            "nipt111_h2_adsorption_energy_ev": {"type": "number"},
            "ni111_tilted_minus_parallel_energy_ev": {"type": "number"},
            "nipt111_tilted_minus_parallel_energy_ev": {"type": "number"},
            "ni111_parallel_to_tilted_barrier_ev": {"type": "number"},
            "nipt111_parallel_to_tilted_barrier_ev": {"type": "number"}
