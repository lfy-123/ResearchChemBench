      },
      "type": "ordering",
      "reference_id": "kp_pr_result_comparison"
    },
    {
      "rule_id": "r_pr_final",
      "expected": "validated lower [3,3] barrier and source-consistent barrier magnitudes",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      },
