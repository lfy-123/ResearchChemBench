        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.method.reference_state",
          "$.method.thermochemistry"
        ],
        "comparison": "expert semantic comparison"
      },
      "type": "semantic",
      "reference_id": "kp_pr_process_reference"
    },
    {
      "rule_id": "r_pr_barrier_33",
      "target": 23.5,
      "unit": "kcal/mol",
