{
  "paper_id": "paper_fda8b9b53f8276db",
  "rules": [
    {
      "rule_id": "pr_r1",
      "reference_id": "pr_process_input",
      "type": "semantic",
      "expected": "CCDC 2433822 identity, neutral singlet and explicit atom mapping/provenance are present",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.input_provenance",
          "$.system",
          "$.optimization.atom_mapping_file"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "pr_r2",
      "reference_id": "pr_process_minimum",
      "type": "condition",
      "expected": "frequency or Hessian validation is performed and diagnostics are reported",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.frequency_validation.performed",
          "$.frequency_validation.diagnostics"
        ],
        "comparison": "expert condition check"
      }
    },
    {
      "rule_id": "pr_r3",
      "reference_id": "pr_result_minimum",
      "type": "condition",
      "expected": "imaginary_mode_count is explicitly reported and conclusion addresses local-minimum status",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.frequency_validation.imaginary_mode_count",
          "$.conclusion"
        ],
        "comparison": "expert condition check"
      }
    },
    {
      "rule_id": "pr_r4",
      "reference_id": "pr_result_geometry",
      "type": "numeric",
      "target": 0.004,
      "unit": "Å",
      "tolerance": 0.01,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.bond_comparison.rmse"
        ],
        "comparison": "absolute difference",
        "applicability": "Primary fixed six deposited-label bonds only; experimental CIF precision and SI rounding distinction must be disclosed. Wider comparisons remain separate, not substituted."
      }
    },
    {
      "rule_id": "pr_c1",
      "reference_id": "pr_final",
      "type": "semantic",
      "expected": "final claim integrates validated minimum, mapped geometry metrics and isolated-versus-crystal limitation",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion",
          "$.limitations"
        ],
        "comparison": "expert semantic comparison"
      }
    }
  ]
}
