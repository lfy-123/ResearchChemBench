              "C2": {"properties": {"HS": {"properties": {"outcome": {"const": "selected"}}}, "LS": {"properties": {"outcome": {"const": "selected"}}}}},
              "C3": {"properties": {"HS": {"properties": {"outcome": {"const": "selected"}}}, "LS": {"properties": {"outcome": {"const": "selected"}}}}}
