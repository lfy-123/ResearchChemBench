{
  "required_files": [
    "report/results.json",
    "report"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "method",
      "computational_approach",
      "conclusion"
    ],
    "properties": {
      "status": {
        "type": "string"
      },
      "method": {
        "type": "object"
      },
      "computational_approach": {
        "type": "object",
        "required": [
          "geometry_method",
          "energy_method",
          "path_methods",
          "justification"
        ],
        "properties": {
          "geometry_method": {
            "type": "string"
          },
          "energy_method": {
            "type": "string"
          },
          "path_methods": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "justification": {
            "type": "string"
          }
        }
      },
      "conclusion": {
        "type": "string"
      }
    },
    "oneOf": [
      {
        "required": [
          "states",
          "channels",
          "sensitivity"
        ],
        "properties": {
          "states": {
            "type": "object",
            "required": [
              "neutral_energy",
              "cation_energy",
              "aie"
            ],
            "properties": {
              "neutral_energy": {
                "type": "number"
              },
              "cation_energy": {
                "type": "number"
              },
              "aie": {
                "type": "number"
              }
            }
          },
          "channels": {
            "type": "object",
            "required": [
              "chlorine_loss",
              "fluorine_loss"
            ],
            "properties": {
              "chlorine_loss": {
                "type": "object",
                "required": [
                  "appearance_energy",
                  "dissociation_energy",
                  "endpoint",
                  "path_type",
                  "path_points",
                  "path_artifact_paths",
                  "validation"
                ],
                "properties": {
                  "appearance_energy": {
                    "type": "number"
                  },
                  "dissociation_energy": {
                    "type": "number"
                  },
                  "endpoint": {
                    "type": "string"
                  },
                  "path_type": {
                    "type": "string"
                  },
                  "path_points": {
                    "type": "array",
                    "minItems": 2
                  },
                  "path_artifact_paths": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "validation": {
                    "type": "object",
                    "required": [
                      "charge_spin_valid",
                      "endpoint_separated",
                      "path_continuous"
                    ]
                  }
                }
              },
              "fluorine_loss": {
                "type": "object",
                "required": [
                  "appearance_energy",
                  "dissociation_energy",
                  "endpoint",
                  "path_type",
                  "path_points",
                  "path_artifact_paths",
                  "validation"
                ],
                "properties": {
                  "appearance_energy": {
                    "type": "number"
                  },
                  "dissociation_energy": {
                    "type": "number"
                  },
                  "endpoint": {
                    "type": "string"
                  },
                  "path_type": {
                    "type": "string"
                  },
                  "path_points": {
                    "type": "array",
                    "minItems": 2
                  },
                  "path_artifact_paths": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  },
                  "validation": {
                    "type": "object",
                    "required": [
                      "charge_spin_valid",
                      "endpoint_separated",
                      "path_continuous"
                    ]
                  }
                }
              }
            }
          },
          "sensitivity": {
            "type": "string"
          }
        }
      },
      {
        "required": [
          "failed_channel",
          "attempts",
          "limitation",
          "available_results"
        ],
        "properties": {
          "failed_channel": {
            "type": "string"
          },
          "attempts": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "candidate_id",
                "method",
                "coverage",
                "outcome",
                "evidence_paths"
              ],
              "properties": {
                "candidate_id": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "outcome": {
                  "type": "string"
                },
                "evidence_paths": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                },
                "coverage": {
                  "type": "string"
                }
              }
            }
          },
          "limitation": {
            "type": "string"
          },
          "status": {
            "const": "bounded_failure"
          },
          "available_results": {
            "type": "object",
            "description": "Validated results obtained before stopping; omit unavailable quantities."
          }
        }
      }
    ]
  }
}
