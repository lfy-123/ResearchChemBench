{
  "required_files": ["report/results.json"],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": ["status", "method", "minimum", "conclusion", "limitations", "outcome"],
    "properties": {
      "status": {"type": "string", "enum": ["validated_success", "bounded_failure"]},
      "method": {"type": "object", "required": ["software", "method_description"], "properties": {"software": {"type": "string"}, "method_description": {"type": "string"}}},
      "minimum": {"type": "object", "required": ["energy_hartree", "imaginary_frequency_count", "frequency_evidence"], "properties": {"energy_hartree": {"type": "number"}, "imaginary_frequency_count": {"type": "integer", "minimum": 0}, "frequency_evidence": {"type": "string"}}},
      "conclusion": {"type": "string"},
      "limitations": {"type": "string"},
      "outcome": {
        "oneOf": [
          {"type": "object", "required": ["ts", "barrier"], "properties": {
            "ts": {"type": "object", "required": ["energy_hartree", "imaginary_frequency_count", "imaginary_mode_evidence", "connectivity_evidence"], "properties": {"energy_hartree": {"type": "number"}, "imaginary_frequency_count": {"type": "integer", "minimum": 0}, "imaginary_mode_evidence": {"type": "string"}, "connectivity_evidence": {"type": "string"}}},
            "barrier": {"type": "object", "required": ["value", "unit", "calculation"], "properties": {"value": {"type": "number"}, "unit": {"type": "string"}, "calculation": {"type": "string"}}}
          }},
          {"type": "object", "required": ["attempt_log", "failure_reason"], "properties": {
            "attempt_log": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["candidate_id", "outcome"], "properties": {"candidate_id": {"type": "string"}, "outcome": {"type": "string"}}}},
            "failure_reason": {"type": "string"}
          }}
        ]
      }
    }
  }
}
