{
  "paper_id": "paper_80441aced6051d86",
  "rules": [
    {
      "rule_id": "r_input",
      "reference_id": "kp_input",
      "type": "condition",
      "expected": "Input verification identifies the 64-atom +2 singlet monomer and 128-atom +4 singlet dimer and reports connectivity checks.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.input_verification.monomer",
          "$.input_verification.dimer"
        ],
        "comparison": "expert condition comparison"
      }
    },
    {
      "rule_id": "r_min",
      "reference_id": "kp_min",
      "type": "condition",
      "expected": "Both systems have endpoint_status and imaginary_frequency_count, with no imaginary modes or a justified alternative stability validation.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.systems.monomer.validation",
          "$.systems.dimer.validation"
        ],
        "comparison": "expert condition comparison"
      }
    },
    {
      "rule_id": "r_mono_b",
      "reference_id": "kp_mono",
      "type": "numeric",
      "target": 50.66,
      "unit": "degree; mean of two reported benzyl-pyridinium dihedrals",
      "tolerance": 3.0,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.systems.monomer.benzyl_pyridinium_dihedrals_deg[0]",
          "$.systems.monomer.benzyl_pyridinium_dihedrals_deg[1]"
        ],
        "comparison": "absolute difference of reported pair mean"
      }
    },
    {
      "rule_id": "r_mono_p",
      "reference_id": "kp_mono",
      "type": "numeric",
      "target": 30.275,
      "unit": "degree; mean of two reported pyridinium-naphthalene dihedrals",
      "tolerance": 3.0,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.systems.monomer.pyridinium_naphthalene_dihedrals_deg[0]",
          "$.systems.monomer.pyridinium_naphthalene_dihedrals_deg[1]"
        ],
        "comparison": "absolute difference of reported pair mean"
      }
    },
    {
      "rule_id": "r_dist",
      "reference_id": "kp_dimer",
      "type": "numeric",
      "target": 3.63,
      "unit": "angstrom; interplanar stacking separation, not full centroid-vector length",
      "tolerance": 0.25,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.systems.dimer.naphthalene_interplanar_separation_A"
        ],
        "comparison": "absolute difference"
      }
    },
    {
      "rule_id": "r_slip",
      "reference_id": "kp_dimer",
      "type": "numeric",
      "target": 44.89,
      "unit": "degree",
      "tolerance": 5.0,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.systems.dimer.slip_angle_deg"
        ],
        "comparison": "absolute difference"
      }
    },
    {
      "rule_id": "r_final",
      "reference_id": "c_final",
      "type": "semantic",
      "expected": "The submitted conclusion supports a twisted monomer and offset parallel dimer/J-like packing within the computed structural scope and states limitations.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion",
          "$.limitations"
        ],
        "comparison": "expert semantic comparison"
      }
    }
  ]
}
