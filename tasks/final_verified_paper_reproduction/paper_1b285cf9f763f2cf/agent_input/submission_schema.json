{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "states",
      "coverage",
      "conclusion"
    ],
    "properties": {
      "status": {
        "enum": [
          "complete",
          "bounded_failure"
        ]
      },
      "states": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "required": [
            "state_id",
            "composition",
            "element_counts",
            "atom_count",
            "cell_vectors_A",
            "total_cell_charge",
            "compensation",
            "nominal_ionic_charge_sum",
            "candidates"
          ],
          "properties": {
            "state_id": {
              "enum": [
                "UC-1",
                "UC-2",
                "UC-3"
              ]
            },
            "composition": {
              "type": "string",
              "minLength": 1
            },
            "element_counts": {
              "type": "object"
            },
            "atom_count": {
              "const": 56
            },
            "cell_vectors_A": {
              "type": "array",
              "minItems": 3,
              "items": {
                "type": "array",
                "minItems": 3,
                "items": {
                  "type": "number"
                },
                "maxItems": 3
              },
              "maxItems": 3
            },
            "total_cell_charge": {
              "const": 0
            },
            "compensation": {
              "const": "neutral_electronic"
            },
            "nominal_ionic_charge_sum": {
              "type": "integer"
            },
            "candidates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "candidate_id",
                  "status",
                  "assignment",
                  "method",
                  "validation"
                ],
                "properties": {
                  "candidate_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "validated",
                      "bounded_failure"
                    ]
                  },
                  "assignment": {
                    "type": "string",
                    "minLength": 1
                  },
                  "method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "validation": {
                    "type": "object",
                    "required": [
                      "converged",
                      "electronic_convergence",
                      "force_convergence",
                      "structural_integrity",
                      "evidence",
                      "extraction_definition"
                    ],
                    "properties": {
                      "converged": {
                        "type": "boolean"
                      },
                      "electronic_convergence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "force_convergence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "structural_integrity": {
                        "type": "string",
                        "minLength": 1
                      },
                      "evidence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "extraction_definition": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "geometry_artifact": {
                    "type": "string",
                    "minLength": 1
                  },
                  "atom_mapping": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bond_lengths": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "observable_id",
                        "label",
                        "center_id",
                        "neighbor",
                        "value",
                        "unit"
                      ],
                      "properties": {
                        "observable_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "center_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "neighbor": {
                          "type": "object",
                          "required": [
                            "atom_id",
                            "image"
                          ],
                          "properties": {
                            "atom_id": {
                              "type": "string",
                              "minLength": 1
                            },
                            "image": {
                              "type": "array",
                              "minItems": 3,
                              "items": {
                                "type": "integer"
                              },
                              "maxItems": 3
                            }
                          }
                        },
                        "value": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "unit": {
                          "const": "angstrom"
                        }
                      }
                    }
                  },
                  "bond_angles": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "observable_id",
                        "label",
                        "center_id",
                        "endpoints",
                        "value",
                        "unit"
                      ],
                      "properties": {
                        "observable_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "center_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "endpoints": {
                          "type": "array",
                          "minItems": 2,
                          "items": {
                            "type": "object",
                            "required": [
                              "atom_id",
                              "image"
                            ],
                            "properties": {
                              "atom_id": {
                                "type": "string",
                                "minLength": 1
                              },
                              "image": {
                                "type": "array",
                                "minItems": 3,
                                "items": {
                                  "type": "integer"
                                },
                                "maxItems": 3
                              }
                            }
                          },
                          "maxItems": 2
                        },
                        "value": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 180
                        },
                        "unit": {
                          "const": "degree"
                        }
                      }
                    }
                  },
                  "shell_integrity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "comparisons": {
                    "type": "array",
                    "minItems": 0,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "magnetic_state": {
                    "type": "string",
                    "minLength": 1
                  },
                  "failure_reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "attempted_evidence": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allOf": [
                  {
                    "if": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "validated"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "geometry_artifact",
                        "atom_mapping",
                        "bond_lengths",
                        "bond_angles",
                        "shell_integrity",
                        "comparisons",
                        "magnetic_state"
                      ],
                      "properties": {
                        "validation": {
                          "properties": {
                            "converged": {
                              "const": true
                            }
                          }
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "bounded_failure"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "failure_reason",
                        "attempted_evidence"
                      ],
                      "properties": {
                        "validation": {
                          "properties": {
                            "converged": {
                              "const": false
                            }
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "type": "object",
                "required": [
                  "state_id"
                ],
                "properties": {
                  "state_id": {
                    "const": "UC-1"
                  }
                }
              },
              "then": {
                "properties": {
                  "element_counts": {
                    "const": {
                      "Zn": 8,
                      "Fe": 1,
                      "Al": 15,
                      "O": 32
                    }
                  },
                  "nominal_ionic_charge_sum": {
                    "const": 0
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "state_id"
                ],
                "properties": {
                  "state_id": {
                    "const": "UC-2"
                  }
                }
              },
              "then": {
                "properties": {
                  "element_counts": {
                    "const": {
                      "Zn": 7,
                      "Li": 1,
                      "Fe": 1,
                      "Al": 15,
                      "O": 31,
                      "F": 1
                    }
                  },
                  "nominal_ionic_charge_sum": {
                    "const": 0
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "state_id"
                ],
                "properties": {
                  "state_id": {
                    "const": "UC-3"
                  }
                }
              },
              "then": {
                "properties": {
                  "element_counts": {
                    "const": {
                      "Zn": 6,
                      "Li": 1,
                      "Si": 1,
                      "Fe": 1,
                      "Al": 15,
                      "O": 31,
                      "F": 1
                    }
                  },
                  "nominal_ionic_charge_sum": {
                    "const": 2
                  }
                }
              }
            }
          ]
        },
        "maxItems": 3,
        "allOf": [
          {
            "contains": {
              "type": "object",
              "required": [
                "state_id"
              ],
              "properties": {
                "state_id": {
                  "const": "UC-1"
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          },
          {
            "contains": {
              "type": "object",
              "required": [
                "state_id"
              ],
              "properties": {
                "state_id": {
                  "const": "UC-2"
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          },
          {
            "contains": {
              "type": "object",
              "required": [
                "state_id"
              ],
              "properties": {
                "state_id": {
                  "const": "UC-3"
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          }
        ]
      },
      "coverage": {
        "type": "object",
        "required": [
          "generated",
          "validated"
        ],
        "properties": {
          "generated": {
            "type": "integer",
            "minimum": 0
          },
          "validated": {
            "type": "integer",
            "minimum": 0
          },
          "stopping_rule": {
            "type": "string",
            "description": "Optional commentary; not an independent scoring requirement."
          },
          "limitations": {
            "type": "string",
            "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
          }
        }
      },
      "conclusion": {
        "type": "string",
        "minLength": 1
      },
      "failure_reason": {
        "type": "string",
        "minLength": 1
      }
    },
    "allOf": [
      {
        "if": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "complete"
            }
          }
        },
        "then": {
          "properties": {
            "states": {
              "items": {
                "properties": {
                  "candidates": {
                    "contains": {
                      "type": "object",
                      "required": [
                        "status"
                      ],
                      "properties": {
                        "status": {
                          "const": "validated"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "bounded_failure"
            }
          }
        },
        "then": {
          "required": [
            "failure_reason"
          ]
        }
      }
    ]
  }
}
