{
  "paper_id": "paper_44f9727c4e9a4b6f",
  "rules": [
    {
      "rule_id": "rule_minimum",
      "reference_id": "kp_process_minimum",
      "type": "numeric",
      "target": 0,
      "unit": "imaginary modes",
      "tolerance": 0,
      "applies_when": "status=complete_validated",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation.imaginary_frequency_count"
        ],
        "comparison": "exact equality"
      }
    },
    {
      "rule_id": "rule_minimum_evidence",
      "reference_id": "kp_process_minimum",
      "type": "semantic",
      "expected": "For a complete_validated report, the named optimized structure has attached frequency output or an explicitly justified equivalent, reports convergence, and reports the full relevant frequency evidence and imaginary-mode count. A bounded_failure report must instead document the attempted minimum test and the scientific reason it could not be completed.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.status",
          "$.failure_report",
          "$.artifacts"
        ],
        "comparison": "outcome-branch semantic comparison"
      }
    },
    {
      "rule_id": "rule_distance",
      "reference_id": "kp_result_distance",
      "type": "numeric",
      "target": 3.086,
      "unit": "Å",
      "tolerance": 0.08,
      "applies_when": "status=complete_validated",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation.fe_fe_distance_angstrom"
        ],
        "comparison": "absolute difference"
      }
    },
    {
      "rule_id": "rule_delta_fe1",
      "reference_id": "kp_result_mossbauer",
      "type": "numeric",
      "target": 0.52,
      "unit": "mm s−1",
      "tolerance": 0.07,
      "applies_when": "status=complete_validated",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.mossbauer.Fe1.isomer_shift_mm_per_s"
        ],
        "comparison": "absolute difference"
      }
    },
    {
      "rule_id": "rule_delta_fe2",
      "reference_id": "kp_result_mossbauer",
      "type": "numeric",
      "target": 0.52,
      "unit": "mm s−1",
      "tolerance": 0.07,
      "applies_when": "status=complete_validated",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.mossbauer.Fe2.isomer_shift_mm_per_s"
        ],
        "comparison": "absolute difference"
      }
    },
    {
      "rule_id": "rule_mossbauer_evidence",
      "reference_id": "kp_result_mossbauer",
      "type": "semantic",
      "expected": "For a complete_validated report, both named Fe1 and Fe2 sites have calculated site observables, shifts, and a stated density-to-shift method with attached output or reproducible extraction. A bounded_failure report must identify the unresolved site observables. Check that the contact-density-to-shift calibration is appropriate to the submitted functional, basis and relativistic treatment, and that both Fe sites use that same convention. Matching numbers alone do not establish the calculation.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.status",
          "$.failure_report",
          "$.artifacts"
        ],
        "comparison": "outcome-branch semantic comparison"
      }
    },
    {
      "rule_id": "rule_spin",
      "reference_id": "kp_process_spin",
      "type": "semantic",
      "expected": "For a complete_validated report, the submission documents converged, physically comparable high-spin and antiferromagnetic broken-symmetry calculations on identified structures, reports both energies and sign convention, and concludes that broken symmetry is lower. A bounded_failure report must document the attempted comparison and why it was not physically comparable or converged.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.status",
          "$.failure_report",
          "$.artifacts"
        ],
        "comparison": "outcome-branch semantic comparison"
      }
    },
    {
      "rule_id": "rule_final",
      "reference_id": "conclusion_final_assignment",
      "type": "semantic",
      "expected": "The validated broken-symmetry 1H minimum supports the diferric mu-1,2-peroxo assignment through its short Fe-Fe distance and two site-resolved Mossbauer shifts.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.final_conclusion",
          "$.status",
          "$.failure_report"
        ],
        "comparison": "outcome-branch semantic comparison"
      }
    },
    {
      "rule_id": "rule_final_spin",
      "reference_id": "conclusion_final_spin",
      "type": "semantic",
      "expected": "The comparable broken-symmetry solution is lower in energy than the high-spin solution for the modeled diferric complex.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.final_conclusion",
          "$.status",
          "$.failure_report"
        ],
        "comparison": "outcome-branch semantic comparison"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
