{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "required": [
          "status",
          "route",
          "input_verification",
          "systems",
          "conclusion"
        ],
        "properties": {
          "status": {
            "enum": [
              "complete",
              "bounded_failure"
            ]
          },
          "route": {
            "type": "object",
            "required": [
              "method",
              "solvent",
              "optimization",
              "frequency_or_stability_check",
              "conventions"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "solvent": {
                "type": "string"
              },
              "optimization": {
                "type": "string"
              },
              "frequency_or_stability_check": {
                "type": "string"
              },
              "conventions": {
                "type": "string"
              }
            }
          },
          "input_verification": {
            "type": "object",
            "required": [
              "monomer",
              "dimer"
            ],
            "properties": {
              "monomer": {
                "type": "object",
                "required": [
                  "atom_count",
                  "charge",
                  "multiplicity",
                  "connectivity_check"
                ],
                "properties": {
                  "atom_count": {
                    "type": "integer"
                  },
                  "charge": {
                    "type": "integer"
                  },
                  "multiplicity": {
                    "type": "integer"
                  },
                  "connectivity_check": {
                    "type": "string"
                  }
                }
              },
              "dimer": {
                "type": "object",
                "required": [
                  "atom_count",
                  "charge",
                  "multiplicity",
                  "connectivity_check"
                ],
                "properties": {
                  "atom_count": {
                    "type": "integer"
                  },
                  "charge": {
                    "type": "integer"
                  },
                  "multiplicity": {
                    "type": "integer"
                  },
                  "connectivity_check": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "systems": {
            "type": "object",
            "required": [
              "monomer",
              "dimer"
            ],
            "properties": {
              "monomer": {
                "type": "object",
                "required": [
                  "validation",
                  "evidence"
                ],
                "properties": {
                  "validation": {
                    "type": "object",
                    "required": [
                      "endpoint_status",
                      "imaginary_frequency_count"
                    ],
                    "properties": {
                      "endpoint_status": {
                        "type": "string"
                      },
                      "imaginary_frequency_count": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "Null only if no frequency calculation completed; state the actual validation performed. Never use null as zero."
                      }
                    }
                  },
                  "evidence": {
                    "type": "object",
                    "required": [
                      "atom_selections",
                      "convergence_evidence",
                      "attempts_diagnostics"
                    ],
                    "properties": {
                      "atom_selections": {
                        "type": "string"
                      },
                      "convergence_evidence": {
                        "type": "string"
                      },
                      "attempts_diagnostics": {
                        "type": "string"
                      }
                    }
                  },
                  "attempts": {
                    "type": "array"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "structure_path",
                      "benzyl_pyridinium_dihedrals_deg",
                      "pyridinium_naphthalene_dihedrals_deg"
                    ],
                    "properties": {
                      "structure_path": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Path to an actually submitted optimized coordinate file; inline coordinates alone do not satisfy this field."
                      },
                      "benzyl_pyridinium_dihedrals_deg": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 90
                        },
                        "minItems": 2,
                        "maxItems": 2,
                        "description": "Right/left acute least-squares interplanar angles (degrees, 0 to 90), using the public mapped ring selections; not signed four-atom torsions."
                      },
                      "pyridinium_naphthalene_dihedrals_deg": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": 0,
                          "maximum": 90
                        },
                        "minItems": 2,
                        "maxItems": 2,
                        "description": "Right/left acute least-squares interplanar angles (degrees, 0 to 90), using the public mapped ring selections; not signed four-atom torsions."
                      },
                      "failure_reason": {
                        "type": "string",
                        "description": "If this records an earlier attempt, keep the successful main-result evidence; preferably use attempts."
                      }
                    }
                  },
                  {
                    "required": [
                      "failure_reason"
                    ],
                    "properties": {
                      "failure_reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              },
              "dimer": {
                "type": "object",
                "required": [
                  "validation",
                  "evidence"
                ],
                "properties": {
                  "validation": {
                    "type": "object",
                    "required": [
                      "endpoint_status",
                      "imaginary_frequency_count"
                    ],
                    "properties": {
                      "endpoint_status": {
                        "type": "string"
                      },
                      "imaginary_frequency_count": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "description": "Null only if no frequency calculation completed; state the actual validation performed. Never use null as zero."
                      }
                    }
                  },
                  "evidence": {
                    "type": "object",
                    "required": [
                      "atom_selections",
                      "convergence_evidence",
                      "attempts_diagnostics"
                    ],
                    "properties": {
                      "atom_selections": {
                        "type": "string"
                      },
                      "convergence_evidence": {
                        "type": "string"
                      },
                      "attempts_diagnostics": {
                        "type": "string"
                      }
                    }
                  },
                  "attempts": {
                    "type": "array"
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "structure_path",
                      "naphthalene_centroid_distance_A",
                      "slip_angle_deg",
                      "naphthalene_interplanar_separation_A"
                    ],
                    "properties": {
                      "structure_path": {
                        "type": "string",
                        "minLength": 1,
                        "description": "Path to an actually submitted optimized coordinate file; inline coordinates alone do not satisfy this field."
                      },
                      "naphthalene_centroid_distance_A": {
                        "type": "number"
                      },
                      "slip_angle_deg": {
                        "type": "number"
                      },
                      "naphthalene_interplanar_separation_A": {
                        "type": "number",
                        "description": "Explicitly defined naphthalene interplanar stacking distance, separately from full centroid-vector length."
                      },
                      "failure_reason": {
                        "type": "string",
                        "description": "If this records an earlier attempt, keep the successful main-result evidence; preferably use attempts."
                      }
                    }
                  },
                  {
                    "required": [
                      "failure_reason"
                    ],
                    "properties": {
                      "failure_reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                ]
              }
            }
          },
          "conclusion": {
            "type": "string"
          },
          "limitations": {
            "type": "string",
            "description": "Optional commentary; presence, absence or wording is not scored. Scientific results and specific failure diagnostics are evaluated separately."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "complete"
                }
              }
            },
            "then": {
              "properties": {
                "systems": {
                  "properties": {
                    "monomer": {
                      "required": [
                        "structure_path",
                        "benzyl_pyridinium_dihedrals_deg",
                        "pyridinium_naphthalene_dihedrals_deg"
                      ],
                      "properties": {
                        "structure_path": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Path to an actually submitted optimized coordinate file; inline coordinates alone do not satisfy this field."
                        },
                        "benzyl_pyridinium_dihedrals_deg": {
                          "type": "array",
                          "items": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 90
                          },
                          "minItems": 2,
                          "maxItems": 2,
                          "description": "Right/left acute least-squares interplanar angles (degrees, 0 to 90), using the public mapped ring selections; not signed four-atom torsions."
                        },
                        "pyridinium_naphthalene_dihedrals_deg": {
                          "type": "array",
                          "items": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 90
                          },
                          "minItems": 2,
                          "maxItems": 2,
                          "description": "Right/left acute least-squares interplanar angles (degrees, 0 to 90), using the public mapped ring selections; not signed four-atom torsions."
                        },
                        "failure_reason": {
                          "type": "string",
                          "description": "If this records an earlier attempt, keep the successful main-result evidence; preferably use attempts."
                        }
                      }
                    },
                    "dimer": {
                      "required": [
                        "structure_path",
                        "naphthalene_centroid_distance_A",
                        "slip_angle_deg",
                        "naphthalene_interplanar_separation_A"
                      ],
                      "properties": {
                        "structure_path": {
                          "type": "string",
                          "minLength": 1,
                          "description": "Path to an actually submitted optimized coordinate file; inline coordinates alone do not satisfy this field."
                        },
                        "naphthalene_centroid_distance_A": {
                          "type": "number"
                        },
                        "slip_angle_deg": {
                          "type": "number"
                        },
                        "naphthalene_interplanar_separation_A": {
                          "type": "number",
                          "description": "Explicitly defined naphthalene interplanar stacking distance, separately from full centroid-vector length."
                        },
                        "failure_reason": {
                          "type": "string",
                          "description": "If this records an earlier attempt, keep the successful main-result evidence; preferably use attempts."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "object",
        "required": [
          "status",
          "failure_report"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "failure_report": {
            "type": "object",
            "required": [
              "reason",
              "missing_endpoint",
              "completed_artifacts"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "missing_endpoint": {
                "type": "string",
                "minLength": 1
              },
              "completed_artifacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    ]
  }
}
