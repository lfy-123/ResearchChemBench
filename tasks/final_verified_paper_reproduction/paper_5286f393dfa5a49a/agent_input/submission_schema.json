{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "structures",
      "conclusion",
      "provenance"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "bounded_failure"
        ]
      },
      "structures": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "required": [
            "label",
            "input_file",
            "atom_count",
            "composition",
            "charge",
            "multiplicity",
            "outcome",
            "convergence",
            "stationarity"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "input_file": {
              "type": "string"
            },
            "atom_count": {
              "type": "integer"
            },
            "composition": {
              "type": "object"
            },
            "charge": {
              "type": "integer"
            },
            "multiplicity": {
              "type": "integer"
            },
            "outcome": {
              "type": "string"
            },
            "convergence": {
              "type": "object"
            },
            "stationarity": {
              "type": "object",
              "description": "State whether minimum/frequency character was actually established. Not established is valid for the fixed-geometry primary calculation; do not invent optimization or frequency results."
            },
            "energy_kj_mol": {
              "type": "number"
            },
            "optimized_geometry_file": {
              "type": "string"
            }
          }
        }
      },
      "conclusion": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
      },
      "provenance": {
        "type": "object",
        "required": [
          "method",
          "software",
          "solvent",
          "units"
        ],
        "properties": {
          "method": {
            "type": "string",
            "description": "Primary fixed-input protocol: wB97M-V/def2-TZVP. Report numerical settings; alternative methods belong to separate sensitivity results."
          },
          "software": {
            "type": "string"
          },
          "solvent": {
            "type": "string",
            "description": "Primary comparison uses SMD dichloromethane (DCM)."
          },
          "units": {
            "type": "string"
          }
        }
      },
      "sensitivity": {
        "type": "array",
        "description": "Optional alternative methods or relaxed geometries; never substituted for primary fixed-input energies.",
        "items": {
          "type": "object"
        }
      }
    },
    "oneOf": [
      {
        "required": [
          "relative_energies",
          "rrr_ssss_difference_kj_mol",
          "ordering"
        ],
        "properties": {
          "status": {
            "const": "complete"
          },
          "relative_energies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "label",
                "reference_label",
                "value_kj_mol"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "reference_label": {
                  "type": "string"
                },
                "value_kj_mol": {
                  "type": "number"
                }
              }
            }
          },
          "rrr_ssss_difference_kj_mol": {
            "type": "number"
          },
          "ordering": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      },
      {
        "required": [
          "failure_explanation"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "failure_explanation": {
            "type": "string"
          }
        }
      }
    ]
  }
}
