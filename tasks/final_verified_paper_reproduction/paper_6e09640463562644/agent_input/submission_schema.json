{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "outcome",
      "provenance"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "partial",
          "bounded_failure"
        ]
      },
      "outcome": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "outcome_type",
              "candidates",
              "per_size",
              "conclusion"
            ],
            "properties": {
              "outcome_type": {
                "const": "validated_conclusion"
              },
              "candidates": {
                "type": "array"
              },
              "per_size": {
                "type": "array"
              },
              "conclusion": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "outcome_type",
              "failure_report",
              "coverage_attempted"
            ],
            "properties": {
              "outcome_type": {
                "const": "bounded_failure"
              },
              "failure_report": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "n",
                    "stage",
                    "reason"
                  ]
                }
              },
              "coverage_attempted": {
                "type": "string"
              },
              "conclusion_scope": {
                "type": "string",
                "description": "Optional commentary; not an independent scoring requirement."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "paper_id",
              "route",
              "source_boundary",
              "candidates",
              "trend_by_n",
              "all_n_candidates_available",
              "interpretation"
            ],
            "properties": {
              "paper_id": {
                "type": "string"
              },
              "route": {
                "type": "string"
              },
              "source_boundary": {
                "type": "string"
              },
              "candidates": {
                "type": "array"
              },
              "trend_by_n": {
                "type": "array"
              },
              "all_n_candidates_available": {
                "type": "boolean"
              },
              "_processed_terminal_count": {
                "type": "integer",
                "minimum": 0
              },
              "interpretation": {
                "type": "string"
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
              }
            }
          }
        ]
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
      },
      "provenance": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        }
      },
      "verification_note": {
        "type": "string"
      },
      "legacy_evidence": {
        "type": "object"
      },
      "real_calculation": {
        "type": "object"
      }
    }
  }
}
