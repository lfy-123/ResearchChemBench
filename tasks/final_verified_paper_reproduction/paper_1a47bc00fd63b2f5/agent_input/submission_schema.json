{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "system",
      "candidates",
      "coverage",
      "conclusion"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "bounded_failure"
        ],
        "minLength": 1
      },
      "system": {
        "type": "object",
        "required": [
          "substrate_id",
          "catalyst_id",
          "reference_state",
          "method"
        ],
        "properties": {
          "substrate_id": {
            "type": "string",
            "minLength": 1
          },
          "catalyst_id": {
            "type": "string",
            "minLength": 1
          },
          "reference_state": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "object",
            "description": "Actual primary comparison protocol; identify dispersion, grids, low/high levels and thermal convention. Optional alternative protocols are reported separately, not substituted for the main comparison.",
            "properties": {
              "optimization": {"type": "string", "minLength": 1},
              "single_point": {"type": "string", "minLength": 1},
              "solvent": {"type": "string", "minLength": 1},
              "temperature_K": {"type": "number", "exclusiveMinimum": 0},
              "pressure_atm": {"type": "number", "exclusiveMinimum": 0},
              "energy_convention": {"type": "string", "minLength": 1}
            }
          }
        }
      },
      "candidates": {
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "required": [
            "candidate_id",
            "channel",
            "structure_identity",
            "validation_status"
          ],
          "properties": {
            "candidate_id": {
              "type": "string",
              "minLength": 1
            },
            "channel": {
              "type": "string",
              "enum": [
                "ortho_4_hydroxybenzofuran",
                "para_6_hydroxybenzofuran"
              ],
              "minLength": 1
            },
            "structure_identity": {
              "type": "string",
              "minLength": 1
            },
            "validation_status": {
              "type": "string",
              "minLength": 1
            },
            "validation_evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "frequency_evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "irc_evidence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "gibbs_barrier_kcal_mol": {
              "type": "number"
            },
            "imaginary_frequency_cm-1": {
              "type": "number"
            },
            "irc_endpoint": {
              "type": "string",
              "minLength": 1
            },
            "failure_reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "anyOf": [
            {
              "required": [
                "gibbs_barrier_kcal_mol",
                "imaginary_frequency_cm-1",
                "validation_evidence",
                "frequency_evidence",
                "irc_evidence"
              ]
            },
            {
              "required": [
                "failure_reason"
              ]
            }
          ]
        }
      },
      "coverage": {
        "type": "object",
        "required": [
          "conformer_generation",
          "deduplication"
        ],
        "properties": {
          "conformer_generation": {
            "type": "string",
            "minLength": 1
          },
          "deduplication": {
            "type": "string",
            "minLength": 1
          },
          "stopping_basis": {
            "type": "string"
          },
          "unresolved_alternatives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "barrier_comparison": {
        "type": "object",
        "oneOf": [
          {
            "required": [
              "ortho_barrier_kcal_mol",
              "para_barrier_kcal_mol",
              "signed_delta_delta_g_kcal_mol",
              "sign_convention"
            ],
            "properties": {
              "ortho_barrier_kcal_mol": {
                "type": "number"
              },
              "para_barrier_kcal_mol": {
                "type": "number"
              },
              "signed_delta_delta_g_kcal_mol": {
                "type": "number"
              },
              "sign_convention": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "availability",
              "reason"
            ],
            "properties": {
              "availability": {
                "const": "not_available"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "failure_report": {
        "type": "object",
        "required": [
          "failed_channels",
          "attempted_candidate_ids",
          "reason"
        ],
        "properties": {
          "failed_channels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "ortho_4_hydroxybenzofuran",
                "para_6_hydroxybenzofuran"
              ],
              "minLength": 1
            }
          },
          "attempted_candidate_ids": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "limitation": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "conclusion": {
        "type": "object",
        "required": [
          "claim"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "oneOf": [
      {
        "properties": {
          "status": {
            "const": "completed"
          },
          "system": {
            "properties": {
              "method": {
                "required": [
                  "optimization",
                  "single_point",
                  "solvent",
                  "temperature_K",
                  "pressure_atm",
                  "energy_convention"
                ]
              }
            }
          },
          "barrier_comparison": {
            "required": [
              "ortho_barrier_kcal_mol",
              "para_barrier_kcal_mol",
              "signed_delta_delta_g_kcal_mol",
              "sign_convention"
            ]
          },
          "candidates": {
            "allOf": [
              {
                "contains": {
                  "allOf": [
                    {
                      "properties": {
                        "channel": {
                          "const": "ortho_4_hydroxybenzofuran"
                        },
                        "imaginary_frequency_cm-1": {
                          "type": "number",
                          "exclusiveMaximum": 0
                        }
                      }
                    },
                    {
                      "required": [
                        "gibbs_barrier_kcal_mol",
                        "imaginary_frequency_cm-1",
                        "validation_evidence",
                        "frequency_evidence",
                        "irc_evidence"
                      ]
                    }
                  ]
                }
              },
              {
                "contains": {
                  "allOf": [
                    {
                      "properties": {
                        "channel": {
                          "const": "para_6_hydroxybenzofuran"
                        },
                        "imaginary_frequency_cm-1": {
                          "type": "number",
                          "exclusiveMaximum": 0
                        }
                      }
                    },
                    {
                      "required": [
                        "gibbs_barrier_kcal_mol",
                        "imaginary_frequency_cm-1",
                        "validation_evidence",
                        "frequency_evidence",
                        "irc_evidence"
                      ]
                    }
                  ]
                }
              }
            ]
          }
        },
        "required": [
          "barrier_comparison"
        ]
      },
      {
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "barrier_comparison": {
            "required": [
              "availability",
              "reason"
            ]
          }
        },
        "required": [
          "barrier_comparison",
          "failure_report"
        ]
      }
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  }
}
