{
  "type": "object",
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "method",
      "reference_convention"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "success",
          "bounded_failure"
        ],
        "minLength": 1,
        "pattern": "\\S"
      },
      "method": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "reference_convention": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "states": {
        "type": "object",
        "required": [
          "pt_dry",
          "et_dry",
          "pt_hydrated",
          "et_hydrated"
        ],
        "properties": {
          "pt_dry": {
            "type": "object",
            "required": [
              "delta_g_kcal_mol",
              "validation"
            ],
            "properties": {
              "delta_g_kcal_mol": {
                "type": "number"
              },
              "validation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "et_dry": {
            "type": "object",
            "required": [
              "delta_g_kcal_mol",
              "validation"
            ],
            "properties": {
              "delta_g_kcal_mol": {
                "type": "number"
              },
              "validation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "pt_hydrated": {
            "type": "object",
            "required": [
              "delta_g_kcal_mol",
              "validation"
            ],
            "properties": {
              "delta_g_kcal_mol": {
                "type": "number"
              },
              "validation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          },
          "et_hydrated": {
            "type": "object",
            "required": [
              "delta_g_kcal_mol",
              "validation"
            ],
            "properties": {
              "delta_g_kcal_mol": {
                "type": "number"
              },
              "validation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      },
      "candidates": {
        "type": "array",
        "minItems": 4,
        "items": {
          "type": "object",
          "required": [
            "candidate_id",
            "state_id",
            "charge",
            "multiplicity",
            "validation_evidence"
          ],
          "properties": {
            "candidate_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "state_id": {
              "type": "string",
              "enum": [
                "pt_dry",
                "et_dry",
                "pt_hydrated",
                "et_hydrated"
              ],
              "minLength": 1,
              "pattern": "\\S"
            },
            "charge": {
              "type": "integer"
            },
            "multiplicity": {
              "type": "integer"
            },
            "validation_evidence": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        },
        "allOf": [
          {
            "contains": {
              "properties": {
                "state_id": {
                  "const": "pt_dry"
                }
              },
              "required": [
                "state_id"
              ]
            }
          },
          {
            "contains": {
              "properties": {
                "state_id": {
                  "const": "et_dry"
                }
              },
              "required": [
                "state_id"
              ]
            }
          },
          {
            "contains": {
              "properties": {
                "state_id": {
                  "const": "pt_hydrated"
                }
              },
              "required": [
                "state_id"
              ]
            }
          },
          {
            "contains": {
              "properties": {
                "state_id": {
                  "const": "et_hydrated"
                }
              },
              "required": [
                "state_id"
              ]
            }
          }
        ]
      },
      "coverage": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "water_effect": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "sensitivity": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "conclusion": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "attempted_states": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "failure_diagnostics": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "partial_results": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "state_id",
            "validation"
          ],
          "properties": {
            "state_id": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "delta_g_kcal_mol": {
              "type": "number"
            },
            "validation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      },
      "attempts": {
        "type": "array",
        "items": {
          "type": "object"
        },
        "description": "Optional additional or unsuccessful trials, separate from primary results."
      }
    },
    "oneOf": [
      {
        "properties": {
          "status": {
            "const": "success"
          }
        },
        "required": [
          "states",
          "candidates",
          "coverage",
          "water_effect",
          "sensitivity",
          "conclusion"
        ]
      },
      {
        "properties": {
          "status": {
            "const": "bounded_failure"
          }
        },
        "required": [
          "attempted_states",
          "failure_diagnostics",
          "partial_results",
          "coverage",
          "conclusion"
        ]
      }
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  }
}
