{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "completion_status",
      "system",
      "provenance",
      "validation",
      "contacts",
      "classification",
      "conclusion"
    ],
    "properties": {
      "completion_status": {
        "type": "string",
        "enum": [
          "complete",
          "bounded_failure"
        ],
        "minLength": 1,
        "pattern": "\\S"
      },
      "system": {
        "type": "object",
        "required": [
          "record_id",
          "charge",
          "multiplicity",
          "transformation"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "enum": [
              "2500223",
              "CCDC 2500223"
            ],
            "minLength": 1,
            "pattern": "\\S"
          },
          "charge": {
            "type": "number",
            "const": 4
          },
          "multiplicity": {
            "type": "integer",
            "const": 1
          },
          "transformation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "provenance": {
        "type": "object",
        "required": [
          "software",
          "method"
        ],
        "properties": {
          "software": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "convergence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      },
      "validation": {
        "type": "object",
        "required": [],
        "properties": {
          "geometry": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "bcp_count": {
            "type": "integer"
          },
          "atom_mapping": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "records": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      },
      "contacts": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "items": {
          "type": "object",
          "required": [
            "contact",
            "status",
            "rho",
            "laplacian",
            "elf",
            "H",
            "V",
            "G",
            "V_over_G",
            "DI",
            "notes"
          ],
          "properties": {
            "contact": {
              "type": "string",
              "enum": [
                "Au1-Au2",
                "Au2-Au3",
                "Au3-Au4",
                "Au4-Au1"
              ],
              "minLength": 1,
              "pattern": "\\S"
            },
            "status": {
              "type": "string",
              "enum": [
                "validated",
                "unavailable"
              ],
              "minLength": 1,
              "pattern": "\\S"
            },
            "rho": {
              "type": [
                "number",
                "null"
              ]
            },
            "laplacian": {
              "type": [
                "number",
                "null"
              ]
            },
            "elf": {
              "type": [
                "number",
                "null"
              ]
            },
            "H": {
              "type": [
                "number",
                "null"
              ]
            },
            "V": {
              "type": [
                "number",
                "null"
              ]
            },
            "G": {
              "type": [
                "number",
                "null"
              ]
            },
            "V_over_G": {
              "type": [
                "number",
                "null"
              ]
            },
            "DI": {
              "type": [
                "number",
                "null"
              ]
            },
            "notes": {
              "type": "string"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "validated"
                  }
                },
                "required": [
                  "status"
                ]
              },
              "then": {
                "properties": {
                  "rho": {
                    "type": "number"
                  },
                  "laplacian": {
                    "type": "number"
                  },
                  "elf": {
                    "type": "number"
                  },
                  "H": {
                    "type": "number"
                  },
                  "V": {
                    "type": "number"
                  },
                  "G": {
                    "type": "number"
                  },
                  "V_over_G": {
                    "type": "number"
                  },
                  "DI": {
                    "type": "number"
                  }
                }
              },
              "else": {
                "properties": {
                  "notes": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            }
          ]
        },
        "allOf": [
          {
            "contains": {
              "properties": {
                "contact": {
                  "const": "Au1-Au2"
                }
              },
              "required": [
                "contact"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          },
          {
            "contains": {
              "properties": {
                "contact": {
                  "const": "Au2-Au3"
                }
              },
              "required": [
                "contact"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          },
          {
            "contains": {
              "properties": {
                "contact": {
                  "const": "Au3-Au4"
                }
              },
              "required": [
                "contact"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          },
          {
            "contains": {
              "properties": {
                "contact": {
                  "const": "Au4-Au1"
                }
              },
              "required": [
                "contact"
              ]
            },
            "minContains": 1,
            "maxContains": 1
          }
        ]
      },
      "classification": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "conclusion": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": "Optional contextual note; omission or an empty value carries no scoring penalty."
      },
      "attempts": {
        "type": "array",
        "items": {
          "type": "object"
        },
        "description": "Optional additional or unsuccessful trials, separate from primary results."
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "completion_status": {
              "const": "complete"
            }
          },
          "required": [
            "completion_status"
          ]
        },
        "then": {
          "properties": {
            "contacts": {
              "items": {
                "properties": {
                  "status": {
                    "const": "validated"
                  }
                }
              }
            },
            "validation": {
              "type": "object",
              "required": [
                "geometry",
                "bcp_count",
                "atom_mapping",
                "records"
              ],
              "properties": {
                "geometry": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "bcp_count": {
                  "type": "integer",
                  "const": 4
                },
                "atom_mapping": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "records": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  }
                }
              }
            },
            "provenance": {
              "type": "object",
              "required": [
                "software",
                "method",
                "convergence",
                "files"
              ],
              "properties": {
                "software": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "convergence": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "files": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "minItems": 1
                }
              }
            }
          }
        },
        "else": {
          "properties": {
            "contacts": {
              "contains": {
                "properties": {
                  "status": {
                    "const": "unavailable"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        }
      }
    ],
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  }
}
