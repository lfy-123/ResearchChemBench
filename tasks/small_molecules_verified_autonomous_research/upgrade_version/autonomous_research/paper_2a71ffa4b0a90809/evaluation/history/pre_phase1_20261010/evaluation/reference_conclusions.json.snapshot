{"paper_id":"paper_2a71ffa4b0a90809","items":[{"conclusion_id":"c_final","claim_role":"final","statement":"The investigation supports a scoped rotational-barrier and rigidity conclusion for 1a.","expected":"States extracted barrier, maximum location and whether the evidence supports rigid/atropisomeric behavior within the computational boundary.","supporting_key_point_ids":["kp_profile","kp_barrier","kp_limits"],"evidence_ids":["ev_doc_600c5cbf2e8e_000158_b5a7ca47f7e7"]},{"conclusion_id":"c_limitation","claim_role":"limitation","statement":"The scan has model and profile interpretation limits.","expected":"Addresses model/solvent/temperature, scan resolution or failures, and profile-versus-experimental-kinetics distinction.","supporting_key_point_ids":["kp_input","kp_limits"],"evidence_ids":["ev_doc_85e0255cc1d7_001163_dc9a6a80bc1a"]}]}
