{
  "paper_id": "paper_a3892396b1843698",
  "rules": [
    {
      "rule_id": "r_ar_search",
      "expected": "candidate identities, coverage and deduplication rule are reported",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.search_and_validation"
        ],
        "comparison": "expert semantic comparison"
      },
