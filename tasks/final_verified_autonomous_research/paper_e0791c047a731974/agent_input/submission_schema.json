{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "status",
              "system",
              "method",
              "observables",
              "validation",
              "conclusion"
            ],
            "properties": {
              "status": {
                "const": "complete"
              },
              "system": {
                "type": "object",
                "required": [
                  "input_file",
                  "charge",
                  "starting_multiplicity",
                  "atom_count"
                ],
                "properties": {
                  "input_file": {
                    "type": "string"
                  },
                  "charge": {
                    "type": "integer",
                    "const": 1
                  },
                  "starting_multiplicity": {
                    "type": "integer",
                    "const": 1
                  },
                  "atom_count": {
                    "type": "integer",
                    "const": 62
                  }
                }
              },
              "method": {
                "type": "object",
                "required": [
                  "software",
                  "model",
                  "solvent",
                  "settings"
                ],
                "properties": {
                  "software": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "solvent": {
                    "type": "string"
                  },
                  "settings": {
                    "type": "string"
                  }
                }
              },
              "observables": {
                "type": "object",
                "required": [
                  "vertical",
                  "adiabatic_t1"
                ],
                "properties": {
                  "vertical": {
                    "type": "object",
                    "required": [
                      "s1",
                      "t1",
                      "t2"
                    ],
                    "properties": {
                      "s1": {
                        "type": "object",
                        "required": [
                          "state",
                          "energy_eV",
                          "source"
                        ],
                        "properties": {
                          "state": {
                            "const": "S1"
                          },
                          "energy_eV": {
                            "type": "number"
                          },
                          "source": {
                            "type": "string"
                          }
                        }
                      },
                      "t1": {
                        "type": "object",
                        "required": [
                          "state",
                          "energy_eV",
                          "source"
                        ],
                        "properties": {
                          "state": {
                            "const": "T1"
                          },
                          "energy_eV": {
                            "type": "number"
                          },
                          "source": {
                            "type": "string"
                          }
                        }
                      },
                      "t2": {
                        "type": "object",
                        "required": [
                          "state",
                          "energy_eV",
                          "source"
                        ],
                        "properties": {
                          "state": {
                            "const": "T2"
                          },
                          "energy_eV": {
                            "type": "number"
                          },
                          "source": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  },
                  "adiabatic_t1": {
                    "type": "object",
                    "required": [
                      "state",
                      "energy_eV",
                      "source"
                    ],
                    "properties": {
                      "state": {
                        "const": "T1_adiabatic"
                      },
                      "energy_eV": {
                        "type": "number"
                      },
                      "source": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "validation": {
                "type": "object",
                "required": [
                  "s0_stationary",
                  "frequency_evidence",
                  "state_identity",
                  "t1_relaxation",
                  "checks"
                ],
                "properties": {
                  "s0_stationary": {
                    "type": "boolean"
                  },
                  "frequency_evidence": {
                    "type": "string"
                  },
                  "state_identity": {
                    "type": "string"
                  },
                  "t1_relaxation": {
                    "type": "string"
                  },
                  "checks": {
                    "type": "string",
                    "description": "State ordering and vertical S1−T1 and T2−S1 gaps derived from the reported Cy2 energies. Optional 2×T1−S1 is a Cy2 diagnostic, not a sensitization criterion; no SOC/rate/annihilator result or generic limitation statement is required."
                  }
                }
              },
              "conclusion": {
                "type": "string"
              },
              "limitations": {
                "type": "string",
                "description": "Optional commentary; presence, absence or wording is not scored. Scientific results and specific failure diagnostics are evaluated separately."
              }
            }
          },
          {
            "type": "object",
            "required": [
              "status",
              "system",
              "method",
              "observables",
              "validation",
              "conclusion",
              "failure_details"
            ],
            "properties": {
              "status": {
                "const": "bounded_failure"
              },
              "system": {
                "type": "object",
                "required": [
                  "input_file",
                  "charge",
                  "starting_multiplicity",
                  "atom_count"
                ],
                "properties": {
                  "input_file": {
                    "type": "string"
                  },
                  "charge": {
                    "type": "integer",
                    "const": 1
                  },
                  "starting_multiplicity": {
                    "type": "integer",
                    "const": 1
                  },
                  "atom_count": {
                    "type": "integer",
                    "const": 62
                  }
                }
              },
              "method": {
                "type": "object",
                "required": [
                  "software",
                  "model",
                  "solvent",
                  "settings"
                ],
                "properties": {
                  "software": {
                    "type": "string"
                  },
                  "model": {
                    "type": "string"
                  },
                  "solvent": {
                    "type": "string"
                  },
                  "settings": {
                    "type": "string"
                  }
                }
              },
              "observables": {
                "type": "object",
                "required": [
                  "unresolved"
                ],
                "properties": {
                  "unresolved": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "validation": {
                "type": "object",
                "required": [
                  "s0_stationary",
                  "frequency_evidence",
                  "state_identity",
                  "t1_relaxation",
                  "checks"
                ],
                "properties": {
                  "s0_stationary": {
                    "type": "boolean"
                  },
                  "frequency_evidence": {
                    "type": "string"
                  },
                  "state_identity": {
                    "type": "string"
                  },
                  "t1_relaxation": {
                    "type": "string"
                  },
                  "checks": {
                    "type": "string",
                    "description": "Available state-ordering and energy-gap checks only; do not invent missing energies or additional SOC/rate/annihilator results."
                  }
                }
              },
              "conclusion": {
                "type": "string"
              },
              "limitations": {
                "type": "string",
                "description": "Optional commentary; presence, absence or wording is not scored. Scientific results and specific failure diagnostics are evaluated separately."
              },
              "failure_details": {
                "type": "string"
              }
            }
          }
        ]
      },
      {
        "type": "object",
        "required": [
          "status",
          "failure_report"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "failure_report": {
            "type": "object",
            "required": [
              "reason",
              "missing_endpoint",
              "completed_artifacts"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "missing_endpoint": {
                "type": "string",
                "minLength": 1
              },
              "completed_artifacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    ]
  }
}
