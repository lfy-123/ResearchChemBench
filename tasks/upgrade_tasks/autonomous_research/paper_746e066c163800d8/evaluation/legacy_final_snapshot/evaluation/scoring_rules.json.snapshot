{
  "rules": [
    {
      "rule_id": "ar_r1",
      "type": "condition",
      "expected": "minimum validation is documented and imaginary-mode outcome is reported",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation.minimum_test",
          "$.validation.imaginary_modes"
        ],
        "comparison": "expert condition comparison The primary metric is mean(abs(phi_i)) over the five consecutive quadruples of [1,66,65,64,63,62,61,59], with signed individual values and mapping retained. Unknown frequencies are not zero; completed minima require real frequency or equivalent evidence. The experiment is private: the evaluator compares the submitted mean with 27.0 degrees and the submitted geometric evidence; do not require the Agent to quote or access that withheld number."
      },
      "reference_id": "ar_process_minimum"
    },
    {
      "rule_id": "ar_r2",
      "type": "condition",
      "expected": "five individually indexed torsions and a stated convention are present Recompute the five signed torsions from the retained ordered atom quadruples and verify mean(abs(phi_i)), not abs(mean(phi_i)). Keep the molecular mapping through any renumbering.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.torsions"
        ],
        "comparison": "expert structural audit The primary metric is mean(abs(phi_i)) over the five consecutive quadruples of [1,66,65,64,63,62,61,59], with signed individual values and mapping retained. Unknown frequencies are not zero; completed minima require real frequency or equivalent evidence. The experiment is private: the evaluator compares the submitted mean with 27.0 degrees and the submitted geometric evidence; do not require the Agent to quote or access that withheld number."
      },
      "reference_id": "ar_process_torsion_trace"
    },
    {
      "rule_id": "ar_r3",
      "type": "numeric",
      "target": 27.1,
      "unit": "degree",
      "tolerance": 2,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.mean_torsion_deg"
        ],
        "comparison": "absolute difference The primary metric is mean(abs(phi_i)) over the five consecutive quadruples of [1,66,65,64,63,62,61,59], with signed individual values and mapping retained. Unknown frequencies are not zero; completed minima require real frequency or equivalent evidence. The experiment is private: the evaluator compares the submitted mean with 27.0 degrees and the submitted geometric evidence; do not require the Agent to quote or access that withheld number.",
        "applicability": {
          "field": "$.status",
          "equals": "complete"
        }
      },
      "reference_id": "ar_result_mean"
    },
    {
      "rule_id": "ar_r4",
      "type": "semantic",
      "expected": "The validated compound-5 minimum yields the five mapped signed inner-rim torsions and their mean absolute magnitude, close to the source structural result. The primary metric is mean(abs(phi_i)) over the five consecutive quadruples of [1,66,65,64,63,62,61,59], with signed individual values and mapping retained. Unknown frequencies are not zero; completed minima require real frequency or equivalent evidence. The experiment is private: the evaluator compares the submitted mean with 27.0 degrees and the submitted geometric evidence; do not require the Agent to quote or access that withheld number.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.interpretation"
        ],
        "comparison": "expert semantic comparison The primary metric is mean(abs(phi_i)) over the five consecutive quadruples of [1,66,65,64,63,62,61,59], with signed individual values and mapping retained. Unknown frequencies are not zero; completed minima require real frequency or equivalent evidence. The experiment is private: the evaluator compares the submitted mean with 27.0 degrees and the submitted geometric evidence; do not require the Agent to quote or access that withheld number."
      },
      "reference_id": "ar_final",
      "applicability": {
        "field": "$.status",
        "equals": "complete"
      }
    }
  ],
  "paper_id": "paper_746e066c163800d8",
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
