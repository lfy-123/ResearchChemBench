{
  "paper_id": "paper_72822e4ddb5d9b11",
  "task_type": "autonomous_research",
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "system",
      "states",
      "conclusion"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "completed",
          "bounded_failure"
        ],
        "minLength": 1
      },
      "system": {
        "type": "object",
        "required": [
          "identity",
          "charge",
          "multiplicity_definitions"
        ],
        "properties": {
          "identity": {
            "type": "string",
            "minLength": 1
          },
          "charge": {
            "const": 0
          },
          "multiplicity_definitions": {
            "type": "object",
            "required": [
              "singlet",
              "triplet"
            ],
            "properties": {
              "singlet": {
                "const": 1
              },
              "triplet": {
                "const": 3
              }
            }
          }
        }
      },
      "states": {
        "type": "object",
        "required": [
          "singlet_state",
          "triplet_state"
        ],
        "properties": {
          "singlet_state": {
            "allOf": [
              {
                "$ref": "#/$defs/state"
              },
              {
                "properties": {
                  "multiplicity": {
                    "const": 1
                  }
                }
              }
            ]
          },
          "triplet_state": {
            "allOf": [
              {
                "$ref": "#/$defs/state"
              },
              {
                "properties": {
                  "multiplicity": {
                    "const": 3
                  }
                }
              }
            ]
          }
        }
      },
      "gap_kcal_mol": {
        "type": "number"
      },
      "lower_state": {
        "type": "string",
        "minLength": 1
      },
      "conclusion": {
        "type": "object",
        "required": [
          "claim",
          "validation_summary"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "validation_summary": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string"
          }
        }
      },
      "failure_reason": {
        "type": "string",
        "minLength": 1
      }
    },
    "$defs": {
      "state": {
        "type": "object",
        "required": [
          "multiplicity",
          "method"
        ],
        "properties": {
          "multiplicity": {
            "type": "integer"
          },
          "energy_hartree": {
            "type": "number"
          },
          "optimized": {
            "type": "boolean"
          },
          "convergence": {
            "type": "string",
            "minLength": 1
          },
          "stationarity": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "failure_reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "if": {
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "completed"
            }
          }
        },
        "then": {
          "required": [
            "gap_kcal_mol",
            "lower_state"
          ],
          "properties": {
            "states": {
              "properties": {
                "singlet_state": {
                  "required": [
                    "energy_hartree",
                    "optimized",
                    "convergence",
                    "stationarity"
                  ],
                  "properties": {
                    "optimized": {
                      "const": true
                    }
                  }
                },
                "triplet_state": {
                  "required": [
                    "energy_hartree",
                    "optimized",
                    "convergence",
                    "stationarity"
                  ],
                  "properties": {
                    "optimized": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        },
        "else": {
          "required": [
            "failure_reason"
          ]
        }
      }
    ]
  }
}
