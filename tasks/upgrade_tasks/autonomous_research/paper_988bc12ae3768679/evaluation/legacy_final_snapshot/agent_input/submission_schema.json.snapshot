{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "method",
      "structures",
      "comparison",
      "conclusion"
    ],
    "properties": {
      "method": {
        "type": "object",
        "required": [
          "software",
          "electronic_structure",
          "geometry_treatment",
          "state_coverage"
        ],
        "properties": {
          "software": {
            "type": "string"
          },
          "electronic_structure": {
            "type": "string"
          },
          "geometry_treatment": {
            "type": "string"
          },
          "state_coverage": {
            "type": "string"
          }
        }
      },
      "structures": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": {
          "type": "object",
          "required": [
            "name",
            "charge",
            "multiplicity",
            "input_validation",
            "states",
            "brightest_state"
          ],
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "2a-acid",
                "2a-base"
              ]
            },
            "charge": {
              "type": "integer"
            },
            "multiplicity": {
              "type": "integer"
            },
            "input_validation": {
              "type": "object",
              "required": [
                "atom_count",
                "geometry_provenance",
                "converged"
              ],
              "properties": {
                "atom_count": {
                  "type": "integer"
                },
                "geometry_provenance": {
                  "type": "string"
                },
                "converged": {
                  "type": "boolean"
                }
              }
            },
            "states": {
              "type": "array",
              "oneOf": [
                {
                  "minItems": 4,
                  "items": {
                    "type": "object",
                    "required": [
                      "label",
                      "energy_eV",
                      "oscillator_strength"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "energy_eV": {
                        "type": "number"
                      },
                      "oscillator_strength": {
                        "type": "number"
                      }
                    }
                  }
                },
                {
                  "maxItems": 0
                }
              ]
            },
            "brightest_state": {
              "type": [
                "string",
                "null"
              ]
            },
            "failure": {
              "type": "object",
              "required": [
                "diagnostic",
                "attempted_coverage"
              ],
              "properties": {
                "diagnostic": {
                  "type": "string"
                },
                "attempted_coverage": {
                  "type": "string"
                },
                "limitation": {
                  "type": "string",
                  "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
                }
              }
            }
          }
        },
        "description": "Exactly one 2a-acid and one 2a-base record; order is arbitrary and names identify objects.",
        "allOf": [
          {
            "contains": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "const": "2a-acid"
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          },
          {
            "contains": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "const": "2a-base"
                }
              }
            },
            "minContains": 1,
            "maxContains": 1
          }
        ]
      },
      "comparison": {
        "type": "string"
      },
      "conclusion": {
        "type": "string"
      },
      "limitations": {
        "type": "string",
        "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
      }
    }
  }
}
