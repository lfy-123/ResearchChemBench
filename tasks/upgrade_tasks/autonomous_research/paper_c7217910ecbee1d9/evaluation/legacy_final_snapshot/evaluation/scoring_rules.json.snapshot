{
  "paper_id": "paper_c7217910ecbee1d9",
  "rules": [
    {
      "rule_id": "ar_r1",
      "type": "semantic",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.endpoints",
          "$.candidates",
          "$.coverage"
        ],
        "comparison": "expert semantic comparison"
      },
      "expected": "validated endpoint candidates with convergence, stationary-point evidence, and explicit calculation coverage",
      "reference_id": "ar_process_minimum"
    },
    {
      "rule_id": "ar_r2",
      "type": "semantic",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.aea",
          "$.endpoints"
        ],
        "comparison": "expert semantic comparison"
      },
      "expected": "explicit AEA formula, endpoint energies, units and ZPE convention",
      "reference_id": "ar_process_aea_definition"
    },
    {
      "rule_id": "ar_r3",
      "type": "numeric",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.aea.value"
        ],
        "comparison": "absolute difference"
      },
      "target": 3.93,
      "unit": "eV",
      "tolerance": 0.3,
      "reference_id": "ar_result_aea"
    },
    {
      "rule_id": "ar_r4",
      "type": "semantic",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.framework_assessment"
        ],
        "comparison": "expert semantic comparison"
      },
      "expected": "explicit structure-based assessment of retention of the specified PAl12 framework",
      "reference_id": "ar_result_framework"
    },
    {
      "rule_id": "ar_c1",
      "type": "semantic",
      "expected": "final AEA and framework conclusion is supported by validated calculations and bounded coverage",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion",
          "$.coverage"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "ar_final_claim"
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1",
  "evaluation_instructions": "Score real computational evidence and correctly identified scientific results. Ordinary limitations/stopping prose is optional and unscored. Partial or failed calculations receive only credit supported by completed work; a valid failure submission is not a completed scientific result. Additional attempts do not invalidate a successful main result. Apply all retained identity/state/condition rules and assess distinct completed observables within each conclusion without inventing additional targets or changing authored tolerances."
}
