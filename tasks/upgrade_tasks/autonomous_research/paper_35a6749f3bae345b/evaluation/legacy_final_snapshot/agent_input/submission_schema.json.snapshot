{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "required": [
          "status",
          "provenance",
          "molecules",
          "comparison",
          "explanation",
          "conclusion"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "validated",
              "bounded_failure"
            ]
          },
          "provenance": {
            "type": "object",
            "required": [
              "method",
              "basis",
              "solvent",
              "software",
              "settings"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "basis": {
                "type": "string"
              },
              "solvent": {
                "type": "string"
              },
              "software": {
                "type": "string"
              },
              "settings": {
                "type": "string"
              }
            }
          },
          "molecules": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "id",
                "outcome",
                "state_checks",
                "dihedrals",
                "transitions",
                "orbital_evidence"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "DBC-Ph",
                    "DBC-Nap"
                  ]
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "validated",
                    "bounded_failure"
                  ]
                },
                "state_checks": {
                  "type": "object",
                  "required": [
                    "S0",
                    "S1"
                  ],
                  "properties": {
                    "S0": {
                      "oneOf": [
                        {
                          "type": "object",
                          "required": [
                            "converged",
                            "singlet",
                            "evidence"
                          ],
                          "properties": {
                            "converged": {
                              "type": "boolean",
                              "const": true
                            },
                            "singlet": {
                              "type": "boolean",
                              "const": true
                            },
                            "evidence": {
                              "type": "string"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "converged",
                            "singlet",
                            "failure_report"
                          ],
                          "properties": {
                            "converged": {
                              "type": "boolean",
                              "const": false
                            },
                            "singlet": {
                              "type": "boolean"
                            },
                            "failure_report": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    },
                    "S1": {
                      "oneOf": [
                        {
                          "type": "object",
                          "required": [
                            "converged",
                            "singlet",
                            "evidence"
                          ],
                          "properties": {
                            "converged": {
                              "type": "boolean",
                              "const": true
                            },
                            "singlet": {
                              "type": "boolean",
                              "const": true
                            },
                            "evidence": {
                              "type": "string"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "converged",
                            "singlet",
                            "failure_report"
                          ],
                          "properties": {
                            "converged": {
                              "type": "boolean",
                              "const": false
                            },
                            "singlet": {
                              "type": "boolean"
                            },
                            "failure_report": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "dihedrals": {
                  "type": "object",
                  "required": [
                    "dbc_nphenyl",
                    "nphenyl_paraaryl"
                  ],
                  "properties": {
                    "dbc_nphenyl": {
                      "oneOf": [
                        {
                          "type": "object",
                          "required": [
                            "atom_indices",
                            "convention",
                            "S0_deg",
                            "S1_deg"
                          ],
                          "properties": {
                            "atom_indices": {
                              "type": "array",
                              "minItems": 4,
                              "maxItems": 4,
                              "items": {
                                "type": "integer"
                              }
                            },
                            "convention": {
                              "type": "string"
                            },
                            "S0_deg": {
                              "type": "number"
                            },
                            "S1_deg": {
                              "type": "number"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "failure_report"
                          ],
                          "properties": {
                            "failure_report": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    },
                    "nphenyl_paraaryl": {
                      "oneOf": [
                        {
                          "type": "object",
                          "required": [
                            "atom_indices",
                            "convention",
                            "S0_deg",
                            "S1_deg"
                          ],
                          "properties": {
                            "atom_indices": {
                              "type": "array",
                              "minItems": 4,
                              "maxItems": 4,
                              "items": {
                                "type": "integer"
                              }
                            },
                            "convention": {
                              "type": "string"
                            },
                            "S0_deg": {
                              "type": "number"
                            },
                            "S1_deg": {
                              "type": "number"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "failure_report"
                          ],
                          "properties": {
                            "failure_report": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "transitions": {
                  "oneOf": [
                    {
                      "type": "array",
                      "minItems": 5,
                      "items": {
                        "type": "object",
                        "required": [
                          "state",
                          "wavelength_nm",
                          "oscillator_strength",
                          "dominant_configuration"
                        ],
                        "properties": {
                          "state": {
                            "type": "string",
                            "enum": [
                              "S0",
                              "S1"
                            ],
                            "description": "Optimized geometry label; not the initial excited electronic state. Vertical singlet roots are computed at this geometry."
                          },
                          "wavelength_nm": {
                            "type": "number"
                          },
                          "oscillator_strength": {
                            "type": "number"
                          },
                          "dominant_configuration": {
                            "type": "string"
                          },
                          "root": {
                            "type": "integer",
                            "minimum": 1,
                            "description": "1-based singlet root ordered by increasing excitation energy at this geometry."
                          }
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "failure_report"
                      ],
                      "properties": {
                        "failure_report": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                },
                "orbital_evidence": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": [
                        "criterion",
                        "HOMO",
                        "LUMO"
                      ],
                      "properties": {
                        "criterion": {
                          "type": "string"
                        },
                        "HOMO": {
                          "type": "string"
                        },
                        "LUMO": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "required": [
                        "failure_report"
                      ],
                      "properties": {
                        "failure_report": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            },
            "maxItems": 2,
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "DBC-Ph"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "id": {
                      "const": "DBC-Nap"
                    }
                  },
                  "required": [
                    "id"
                  ]
                },
                "minContains": 1,
                "maxContains": 1
              }
            ]
          },
          "comparison": {
            "type": "string"
          },
          "explanation": {
            "type": "string"
          },
          "conclusion": {
            "type": "string"
          },
          "limitations": {
            "type": "string",
            "description": "Optional commentary; presence, absence or wording is not scored. Scientific results and specific failure diagnostics are evaluated separately."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "validated"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "molecules": {
                  "items": {
                    "properties": {
                      "outcome": {
                        "const": "validated"
                      },
                      "state_checks": {
                        "properties": {
                          "S0": {
                            "properties": {
                              "converged": {
                                "const": true
                              },
                              "singlet": {
                                "const": true
                              },
                              "evidence": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              }
                            }
                          },
                          "S1": {
                            "properties": {
                              "converged": {
                                "const": true
                              },
                              "singlet": {
                                "const": true
                              },
                              "evidence": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "\\S"
                              }
                            }
                          }
                        }
                      },
                      "orbital_evidence": {
                        "type": "object",
                        "description": "A validated result requires the orbital-analysis criterion and both HOMO and LUMO findings. Unavailable analysis belongs in the bounded_failure/partial-results pathway, not a validated result.",
                        "required": [
                          "criterion",
                          "HOMO",
                          "LUMO"
                        ],
                        "properties": {
                          "criterion": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "HOMO": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "LUMO": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          }
                        }
                      },
                      "dihedrals": {
                        "properties": {
                          "dbc_nphenyl": {
                            "required": [
                              "atom_indices",
                              "convention",
                              "S0_deg",
                              "S1_deg"
                            ]
                          },
                          "nphenyl_paraaryl": {
                            "required": [
                              "atom_indices",
                              "convention",
                              "S0_deg",
                              "S1_deg"
                            ]
                          }
                        }
                      },
                      "transitions": {
                        "type": "array",
                        "minItems": 10,
                        "items": {
                          "required": [
                            "root"
                          ]
                        },
                        "allOf": [
                          {
                            "contains": {
                              "type": "object",
                              "required": [
                                "state",
                                "root"
                              ],
                              "properties": {
                                "state": {
                                  "const": "S0"
                                },
                                "root": {
                                  "const": 1
                                }
                              }
                            },
                            "minContains": 1,
                            "maxContains": 1
                          },
                          {
                            "contains": {
                              "type": "object",
                              "required": [
                                "state",
                                "root"
                              ],
                              "properties": {
                                "state": {
                                  "const": "S0"
                                },
                                "root": {
                                  "const": 2
                                }
                              }
                            },
                            "minContains": 1,
                            "maxContains": 1
                          },
                          {
                            "contains": {
                              "type": "object",
                              "required": [
                                "state",
                                "root"
                              ],
                              "properties": {
                                "state": {
                                  "const": "S0"
                                },
                                "root": {
                                  "const": 3
                                }
                              }
                            },
                            "minContains": 1,
                            "maxContains": 1
                          },
                          {
                            "contains": {
                              "type": "object",
                              "required": [
                                "state",
                                "root"
                              ],
                              "properties": {
                                "state": {
                                  "const": "S0"
                                },
                                "root": {
                                  "const": 4
                                }
                              }
                            },
                            "minContains": 1,
                            "maxContains": 1
                          },
                          {
                            "contains": {
                              "type": "object",
                              "required": [
                                "state",
                                "root"
                              ],
                              "properties": {
                                "state": {
                                  "const": "S0"
                                },
                                "root": {
                                  "const": 5
                                }
                              }
                            },
                            "minContains": 1,
                            "maxContains": 1
                          },
                          {
                            "contains": {
                              "type": "object",
                              "required": [
                                "state",
                                "root"
                              ],
                              "properties": {
                                "state": {
                                  "const": "S1"
                                },
                                "root": {
                                  "const": 1
                                }
                              }
                            },
                            "minContains": 1,
                            "maxContains": 1
                          },
                          {
                            "contains": {
                              "type": "object",
                              "required": [
                                "state",
                                "root"
                              ],
                              "properties": {
                                "state": {
                                  "const": "S1"
                                },
                                "root": {
                                  "const": 2
                                }
                              }
                            },
                            "minContains": 1,
                            "maxContains": 1
                          },
                          {
                            "contains": {
                              "type": "object",
                              "required": [
                                "state",
                                "root"
                              ],
                              "properties": {
                                "state": {
                                  "const": "S1"
                                },
                                "root": {
                                  "const": 3
                                }
                              }
                            },
                            "minContains": 1,
                            "maxContains": 1
                          },
                          {
                            "contains": {
                              "type": "object",
                              "required": [
                                "state",
                                "root"
                              ],
                              "properties": {
                                "state": {
                                  "const": "S1"
                                },
                                "root": {
                                  "const": 4
                                }
                              }
                            },
                            "minContains": 1,
                            "maxContains": 1
                          },
                          {
                            "contains": {
                              "type": "object",
                              "required": [
                                "state",
                                "root"
                              ],
                              "properties": {
                                "state": {
                                  "const": "S1"
                                },
                                "root": {
                                  "const": 5
                                }
                              }
                            },
                            "minContains": 1,
                            "maxContains": 1
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "object",
        "required": [
          "status",
          "failure_report"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "failure_report": {
            "type": "object",
            "required": [
              "reason",
              "missing_endpoint",
              "completed_artifacts"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "missing_endpoint": {
                "type": "string",
                "minLength": 1
              },
              "completed_artifacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    ]
  }
}
