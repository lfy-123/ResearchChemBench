    },
    {
      "rule_id": "ar2",
      "reference_id": "ak2",
      "type": "semantic",
      "expected": "For each named molecule, molecule-specific indexed dihedrals, transitions and orbital-localization evidence quantify twisting and support a cautious substituent comparison; any failed observable is identified. Private evaluation/author_results coordinates are source geometric references, not permitted agent inputs. Compare mapped torsions/plane definitions and state identities; no new coordinate-frame/RMSD threshold. Do not select a state by proximity to the reference. For each molecule compare singlet roots 1–5 at both optimized geometries: state=S0/S1 denotes geometry, not S1-to-Sn absorption. Check unique (state, root) identities and calculation evidence; higher computed roots do not replace missing lower roots. Evaluate state-dependent twist/orbital exceptions on their evidence rather than forcing both geometries into one category.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.molecules[*].dihedrals",
          "$.molecules[*].transitions",
          "$.molecules[*].orbital_evidence"
        ],
        "comparison": "expert comparison by molecule identity"
      }
    },
    {
      "rule_id": "ar3",
      "reference_id": "ac1",
      "type": "semantic",
      "expected": "The final conclusion independently compares Ph and Nap, discriminates at least one explanation when differences exist, and explains the calculated comparison.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparison",
          "$.explanation",
          "$.conclusion"
        ],
        "comparison": "expert comparison"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1",
  "evaluation_instructions": "Score real computational evidence and correctly identified scientific results. Ordinary limitations/stopping prose is optional and unscored. Partial or failed calculations receive only credit supported by completed work; a valid failure submission is not a completed scientific result. Additional attempts do not invalidate a successful main result. Apply all retained identity/state/condition rules and assess distinct completed observables within each conclusion without inventing additional targets or changing authored tolerances."
