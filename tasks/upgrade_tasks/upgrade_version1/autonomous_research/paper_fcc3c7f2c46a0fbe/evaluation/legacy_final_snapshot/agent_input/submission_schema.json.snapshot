{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "conclusion"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "bounded_failure"
        ]
      },
      "method": {
        "type": "object",
        "required": [
          "software",
          "model",
          "charge",
          "multiplicity"
        ],
        "properties": {
          "software": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "charge": {
            "type": "integer"
          },
          "multiplicity": {
            "type": "integer"
          }
        }
      },
      "optimization": {
        "type": "object",
        "required": [
          "converged",
          "coordinates_xyz"
        ],
        "properties": {
          "converged": {
            "type": "boolean"
          },
          "coordinates_xyz": {
            "type": "string"
          }
        }
      },
      "frequency_validation": {
        "type": "object",
        "required": [
          "performed",
          "minimum_status",
          "frequencies_cm-1"
        ],
        "properties": {
          "performed": {
            "type": "boolean"
          },
          "minimum_status": {
            "type": "string"
          },
          "frequencies_cm-1": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        }
      },
      "comparisons": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "observable",
            "atoms",
            "xrd",
            "calculated",
            "deviation"
          ],
          "properties": {
            "observable": {
              "type": "string"
            },
            "atoms": {
              "type": "string"
            },
            "xrd": {
              "type": "number"
            },
            "calculated": {
              "type": "number"
            },
            "deviation": {
              "type": "number"
            }
          }
        }
      },
      "metrics": {
        "type": "object",
        "required": [
          "bond_length_mae",
          "angle_mae",
          "torsion_mae"
        ],
        "properties": {
          "bond_length_mae": {
            "type": "number"
          },
          "angle_mae": {
            "type": "number"
          },
          "torsion_mae": {
            "type": "number"
          },
          "bond_length_r2": {
            "type": "number"
          },
          "angle_r2": {
            "type": "number"
          }
        }
      },
      "conclusion": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
      },
      "failure": {
        "type": "object",
        "required": [
          "diagnostics",
          "attempted_steps"
        ],
        "properties": {
          "diagnostics": {
            "type": "string"
          },
          "attempted_steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "additionalProperties": true,
    "oneOf": [
      {
        "required": [
          "method",
          "optimization",
          "frequency_validation",
          "comparisons",
          "metrics"
        ],
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      {
        "required": [
          "failure"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          }
        }
      }
    ]
  }
}
