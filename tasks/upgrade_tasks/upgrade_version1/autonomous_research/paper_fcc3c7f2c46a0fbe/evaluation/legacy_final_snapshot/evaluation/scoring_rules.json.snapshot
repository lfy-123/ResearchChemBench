{
  "paper_id": "paper_fcc3c7f2c46a0fbe",
  "rules": [
    {
      "rule_id": "r1",
      "type": "condition",
      "condition": "The report selects the complete branch with a converged optimization and independently selected method/coordinates, or selects bounded_failure and supplies the required failure diagnostics.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.status",
          "$.method",
          "$.optimization"
        ],
        "comparison": "presence and expert semantic comparison"
      },
      "reference_id": "p1",
      "expected": "optimization.converged is true and independently selected method/coordinates are present Inspect the actual method, converged optimization and coordinates, not only a status string."
    },
    {
      "rule_id": "r2",
      "type": "condition",
      "condition": "The complete branch reports frequency validation and minimum classification, or the bounded_failure branch honestly documents the failed validation.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.status",
          "$.frequency_validation"
        ],
        "comparison": "presence and expert semantic comparison"
      },
      "reference_id": "p2",
      "expected": "frequency validation and minimum classification are reported Inspect reported frequency evidence and minimum classification, not only a status string."
    },
    {
      "rule_id": "r3",
      "type": "semantic",
      "expected": "Compare every named bond, angle and signed periodic torsion with XRD. The isolated-molecule minimum should reproduce the published DFT geometry, including the main section 3.2 exception that the ethyl group points in the opposite direction. Do not require all signed XRD torsions to be close or minimize their signs independently.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparisons",
          "$.metrics",
          "$.optimization"
        ],
        "comparison": "presence and expert semantic comparison"
      },
      "reference_id": "p3"
    },
    {
      "rule_id": "r4",
      "type": "semantic",
      "expected": "The validated 4b minimum reproduces the published isolated-molecule geometry: bonds and angles agree closely with XRD, while the ethyl-orientation exception and every signed periodic torsion residual are explicitly retained. Matching coverage and small numerical residuals are separate checks; high R-squared alone is insufficient.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparisons",
          "$.metrics",
          "$.conclusion"
        ],
        "comparison": "presence and expert semantic comparison"
      },
      "reference_id": "c1"
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
