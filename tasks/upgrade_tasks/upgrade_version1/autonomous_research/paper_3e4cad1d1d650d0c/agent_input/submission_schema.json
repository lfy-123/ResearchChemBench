        "additionalProperties": false,
        "required": [
          "attempted_scope",
          "observed_failure",
          "missing_endpoints",
          "recovery_condition",
          "evidence_files"
        ],
        "properties": {
          "attempted_scope": {
            "type": "string",
            "minLength": 1,
            "description": "Nonempty scientific explanation"
          },
          "observed_failure": {
            "type": "string",
            "minLength": 1,
            "description": "Nonempty scientific explanation"
          },
          "missing_endpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty scientific explanation"
            }
          },
          "recovery_condition": {
            "type": "string",
            "minLength": 1,
            "description": "Nonempty scientific explanation"
          },
          "evidence_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
            }
          }
        }
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "complete"
            }
          }
        },
        "then": {
          "required": [
            "results",
            "hypotheses",
            "sensitivity"
          ],
          "properties": {
            "conclusion": {
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "refuted",
                    "indistinguishable"
                  ]
                }
              }
            },
            "calculation_records": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "completed"
                  },
                  "record_type": {
                    "const": "electronic_structure"
                  }
                },
                "required": [
                  "kind",
                  "record_type"
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "bounded_failure",
                "blocked"
              ]
            }
          }
        },
        "then": {
          "required": [
            "failure_report"
          ],
          "properties": {
            "conclusion": {
              "properties": {
                "verdict": {
                  "const": "not_established"
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "calculation_records": {
              "maxItems": 0
            }
          }
        },
        "then": {
          "properties": {
            "resources": {
              "properties": {
                "engine_calls": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    ]
  }
}
