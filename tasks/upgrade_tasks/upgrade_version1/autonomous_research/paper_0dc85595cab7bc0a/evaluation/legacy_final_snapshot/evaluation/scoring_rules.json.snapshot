{
  "paper_id": "paper_0dc85595cab7bc0a",
  "rules": [
    {
      "rule_id": "ar_r_process",
      "reference_id": "ar_kp_process",
      "type": "semantic",
      "expected": "The report contains candidate-specific generation, deduplication, validation and actual candidate coverage.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation.process_evidence",
          "$.coverage.generation_rule",
          "$.coverage.searched_scope",
          "$.candidates"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "ar_r_thermo",
      "reference_id": "ar_kp_thermo",
      "type": "semantic",
      "expected": "A consistent quantitative thermochemical comparison with ordering, units and uncertainty discriminates candidates. Compare equal-composition candidates within each declared reaction stage with a common energy convention. Preserve atom mapping and stage identity; never compare unrelated absolute energies across stages.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparison.quantity",
          "$.comparison.ordering_or_result",
          "$.candidates"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "ar_r_selectivity",
      "reference_id": "ar_kp_selectivity",
      "type": "semantic",
      "expected": "The final conclusion connects independently computed pathway evidence to the exclusive product boundary or transparently reports bounded uncertainty. Endpoint thermodynamic and site-electronic evidence supports a bounded selectivity interpretation, not a proven activation pathway or product rate. No new TS/IRC requirement is introduced.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion",
          "$.comparison.electronic_evidence"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "ar_r_final",
      "reference_id": "ar_c_final",
      "type": "semantic",
      "expected": "The computed and validated first-stage and sequential second-stage candidates, comparable free energies and electronic or structural evidence support the product-selectivity conclusion. Endpoint thermodynamic and site-electronic evidence supports a bounded selectivity interpretation, not a proven activation pathway or product rate. No new TS/IRC requirement is introduced.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion",
          "$.coverage"
        ],
        "comparison": "expert semantic comparison"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
