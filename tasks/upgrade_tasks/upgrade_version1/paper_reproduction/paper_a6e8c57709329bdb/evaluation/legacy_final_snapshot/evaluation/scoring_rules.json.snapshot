{
  "paper_id": "paper_a6e8c57709329bdb",
  "rules": [
    {
      "rule_id": "pr_s1",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.system",
          "$.validation"
        ],
        "comparison": "expert validation of identity and convergence"
      },
      "expected": "Identity and convergence/force validation are explicit.",
      "type": "condition",
      "reference_id": "pr_p1"
    },
    {
      "rule_id": "pr_s2",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.observables.gap_eV",
          "$.validation.gap_recomputed",
          "$.orbital_localization.evidence"
        ],
        "comparison": "arithmetic and evidence check"
      },
      "expected": "Gap equals LUMO minus HOMO and localization is evidenced. Report frontier residuals and recompute LUMO-HOMO on the same geometry and model. A tolerance pass establishes only its stated precision and does not equate the KS gap to an optical gap.",
      "type": "condition",
      "reference_id": "pr_p2"
    },
    {
      "rule_id": "pr_s3",
      "target": -5.44,
      "unit": "eV (HOMO)",
      "tolerance": 0.75,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.observables.homo_eV"
        ],
        "comparison": "absolute difference"
      },
      "type": "numeric",
      "reference_id": "pr_r1"
    },
    {
      "rule_id": "pr_s4",
      "target": -1.12,
      "unit": "eV (LUMO)",
      "tolerance": 0.75,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.observables.lumo_eV"
        ],
        "comparison": "absolute difference"
      },
      "type": "numeric",
      "reference_id": "pr_r1"
    },
    {
      "rule_id": "pr_s5",
      "target": 4.32,
      "unit": "eV (gap)",
      "tolerance": 0.75,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.observables.gap_eV"
        ],
        "comparison": "absolute difference"
      },
      "type": "numeric",
      "reference_id": "pr_r1"
    },
    {
      "rule_id": "pr_s6",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.orbital_localization"
        ],
        "comparison": "expert semantic comparison"
      },
      "expected": "HOMO aromatic/azomethine and LUMO aromatic/imine plus methylene localization are supported.",
      "type": "semantic",
      "reference_id": "pr_r2"
    },
    {
      "rule_id": "pr_s7",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      },
      "expected": "The correct 2-OH/4-OMe HL molecule has a validated geometry and source-comparable frontier gap. Orbital spatial or proper population evidence characterizes conjugated/aromatic contributions and any methylene participation without requiring that the latter dominate.",
      "type": "semantic",
      "reference_id": "pr_c1"
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
