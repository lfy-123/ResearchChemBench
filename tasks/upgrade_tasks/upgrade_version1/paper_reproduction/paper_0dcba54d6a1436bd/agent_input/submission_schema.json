    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "artifact": {
        "type": "string",
        "pattern": "^(?:\\./)?(outputs|code|data)/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!/)[^\\r\\n\\\\]+$",
        "description": "Workspace-relative path to a real artifact; no absolute, parent-traversal or external private paths."
      },
      "evidence_files": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(?:\\./)?(outputs|code|data)/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!/)[^\\r\\n\\\\]+$",
          "description": "Workspace-relative path to a real artifact; no absolute, parent-traversal or external private paths."
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "transition_set": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1
          },
          "geometry_record_id": {
            "type": "string",
            "minLength": 1
          },
          "TD_record_id": {
            "type": "string",
            "minLength": 1
          },
          "method_key": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "states": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "root": {
                  "type": "integer",
                  "minimum": 1
                },
                "energy_eV": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "wavelength_nm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "oscillator_strength": {
                  "type": "number",
                  "minimum": 0
                },
                "physical_state_label": {
                  "type": "string",
                  "minLength": 1
                },
                "character": {
                  "type": "object",
                  "properties": {
                    "method_and_fragments": {
                      "type": "string",
                      "minLength": 1
                    },
                    "metrics": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "number"
                          },
                          "unit": {
                            "type": "string",
                            "minLength": 1
                          },
                          "definition": {
                            "type": "string",
                            "minLength": 1
                          },
                          "evidence_files": {
                            "$ref": "#/$defs/evidence_files"
                          }
                        },
                        "required": [
                          "name",
                          "value",
                          "unit",
                          "definition",
                          "evidence_files"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    },
                    "assignment": {
                      "type": "string",
                      "minLength": 1
                    },
                    "NTO_or_transition_density_file": {
                      "$ref": "#/$defs/artifact"
                    },
                    "evidence_files": {
                      "$ref": "#/$defs/evidence_files"
                    }
                  },
                  "required": [
                    "method_and_fragments",
                    "metrics",
                    "assignment",
                    "NTO_or_transition_density_file",
                    "evidence_files"
                  ],
                  "additionalProperties": false
                },
                "evidence_files": {
                  "$ref": "#/$defs/evidence_files"
                }
              },
              "required": [
                "root",
                "energy_eV",
                "wavelength_nm",
                "oscillator_strength",
                "physical_state_label",
                "evidence_files"
              ],
              "additionalProperties": false
            },
            "minItems": 5,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "root"
                  ],
                  "properties": {
                    "root": {
                      "const": 1
                    }
                  }
                },
                "minContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "root"
                  ],
                  "properties": {
                    "root": {
                      "const": 2
                    }
                  }
                },
                "minContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "root"
                  ],
                  "properties": {
                    "root": {
                      "const": 3
                    }
                  }
                },
                "minContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "root"
                  ],
                  "properties": {
                    "root": {
                      "const": 4
                    }
                  }
                },
                "minContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "root"
                  ],
                  "properties": {
                    "root": {
                      "const": 5
                    }
                  }
                },
                "minContains": 1
              }
            ]
          },
          "evidence_files": {
            "$ref": "#/$defs/evidence_files"
          }
        },
        "required": [
          "system",
          "geometry_record_id",
          "TD_record_id",
          "method_key",
          "environment",
          "states",
          "evidence_files"
        ],
        "additionalProperties": false
      },
      "state_comparison": {
        "type": "object",
        "properties": {
          "comparison_id": {
            "type": "string",
            "minLength": 1
          },
          "left_geometry_record_id": {
            "type": "string",
            "minLength": 1
          },
          "right_geometry_record_id": {
            "type": "string",
            "minLength": 1
          },
          "left_TD_record_id": {
            "type": "string",
            "minLength": 1
          },
          "right_TD_record_id": {
            "type": "string",
            "minLength": 1
          },
          "left_root": {
            "type": "integer",
            "minimum": 1
          },
          "right_root": {
            "type": "integer",
            "minimum": 1
          },
          "state_matching_criterion": {
            "type": "string",
            "minLength": 1
          },
          "state_correspondence_metric": {
            "type": "number"
          },
          "metric_definition": {
            "type": "string",
            "minLength": 1
          },
          "delta_energy_eV": {
            "type": "number"
          },
          "delta_oscillator_strength": {
            "type": "number"
          },
          "character_change": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "evidence_files": {
            "$ref": "#/$defs/evidence_files"
          }
        },
        "required": [
          "comparison_id",
          "left_geometry_record_id",
          "right_geometry_record_id",
          "left_TD_record_id",
          "right_TD_record_id",
          "left_root",
          "right_root",
          "state_matching_criterion",
          "state_correspondence_metric",
          "metric_definition",
          "delta_energy_eV",
          "delta_oscillator_strength",
          "character_change",
          "interpretation",
          "evidence_files"
        ],
        "additionalProperties": false
      }
    },
    "description": "Complete means the expanded investigation is submitted, not that JSON validity establishes scientific correctness. Honest bounded failures must not invent uncomputed values. Every referenced record and evidence file must exist; the evaluator verifies arithmetic, identity and coverage."
  }
}
