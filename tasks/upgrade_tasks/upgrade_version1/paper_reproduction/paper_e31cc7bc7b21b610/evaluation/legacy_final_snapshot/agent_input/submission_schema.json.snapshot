{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "method",
      "isomers",
      "relative_energy",
      "lower_energy_identity",
      "conclusion"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "partial",
          "bounded_failure"
        ]
      },
      "method": {
        "type": "object",
        "required": [
          "software",
          "electronic_structure",
          "charge",
          "multiplicity",
          "convergence_settings"
        ],
        "properties": {
          "software": {
            "type": "string"
          },
          "electronic_structure": {
            "type": "string"
          },
          "charge": {
            "type": "integer"
          },
          "multiplicity": {
            "type": "integer"
          },
          "convergence_settings": {
            "type": "string"
          }
        }
      },
      "isomers": {
        "type": "object",
        "required": [
          "cis_alpha",
          "cis_beta"
        ],
        "properties": {
          "cis_alpha": {
            "$ref": "#/$defs/isomer"
          },
          "cis_beta": {
            "$ref": "#/$defs/isomer"
          }
        }
      },
      "relative_energy": {
        "type": "object",
        "required": [
          "definition",
          "value",
          "unit"
        ],
        "properties": {
          "definition": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "lower_energy_identity": {
        "type": "string"
      },
      "conclusion": {
        "type": "string"
      },
      "limitations": {
        "type": [
          "string",
          "array"
        ],
        "items": {
          "type": "string"
        },
        "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
      },
      "provenance": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "failure": {
        "type": "object",
        "required": [
          "reason",
          "missing_observables",
          "evidence"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "missing_observables": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "description": "Required for partial/bounded_failure; list unavailable observables and actual diagnostic paths, never fabricated values."
      }
    },
    "$defs": {
      "isomer": {
        "type": "object",
        "required": [
          "name",
          "input_file",
          "status",
          "normal_termination",
          "optimization_completed",
          "imaginary_frequency_count",
          "energy_hartree",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "input_file": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "normal_termination": {
            "type": "boolean"
          },
          "optimization_completed": {
            "type": "boolean"
          },
          "imaginary_frequency_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "frequency_count": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "energy_hartree": {
            "type": [
              "number",
              "null"
            ]
          },
          "imaginary_frequencies": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "number"
            }
          },
          "validation_status": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "if": {
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "partial",
            "bounded_failure"
          ]
        }
      }
    },
    "then": {
      "required": [
        "failure"
      ]
    },
    "else": {
      "properties": {
        "isomers": {
          "properties": {
            "cis_alpha": {
              "properties": {
                "energy_hartree": {
                  "type": "number"
                },
                "imaginary_frequencies": {
                  "type": "array"
                },
                "imaginary_frequency_count": {
                  "type": "integer"
                },
                "frequency_count": {
                  "type": "integer"
                },
                "evidence": {
                  "minItems": 1
                }
              }
            },
            "cis_beta": {
              "properties": {
                "energy_hartree": {
                  "type": "number"
                },
                "imaginary_frequencies": {
                  "type": "array"
                },
                "imaginary_frequency_count": {
                  "type": "integer"
                },
                "frequency_count": {
                  "type": "integer"
                },
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        },
        "relative_energy": {
          "properties": {
            "value": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
