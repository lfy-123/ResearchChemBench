{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "anyOf": [
      {
        "type": "object",
        "oneOf": [
          {
            "required": [
              "status",
              "system",
              "calculation",
              "minimum_validation",
              "transition",
              "conclusion"
            ],
            "properties": {
              "status": {
                "const": "complete"
              },
              "system": {
                "type": "object",
                "required": [
                  "smiles",
                  "charge",
                  "multiplicity",
                  "solvent"
                ],
                "properties": {
                  "smiles": {
                    "type": "string"
                  },
                  "charge": {
                    "type": "integer"
                  },
                  "multiplicity": {
                    "type": "integer"
                  },
                  "solvent": {
                    "type": "string"
                  }
                }
              },
              "calculation": {
                "type": "object",
                "required": [
                  "method",
                  "software",
                  "geometry_provenance"
                ],
                "properties": {
                  "method": {
                    "type": "string"
                  },
                  "software": {
                    "type": "string"
                  },
                  "geometry_provenance": {
                    "type": "string"
                  },
                  "convergence": {
                    "type": "string"
                  }
                }
              },
              "minimum_validation": {
                "type": "object",
                "required": [
                  "validated",
                  "evidence"
                ],
                "properties": {
                  "validated": {
                    "type": "boolean"
                  },
                  "evidence": {
                    "type": "string"
                  },
                  "imaginary_frequency_count": {
                    "type": "number"
                  }
                }
              },
              "transition": {
                "type": "object",
                "required": [
                  "state_label",
                  "energy_kcal_mol",
                  "oscillator_strength",
                  "character",
                  "evidence"
                ],
                "properties": {
                  "state_label": {
                    "type": "string"
                  },
                  "energy_kcal_mol": {
                    "type": "number"
                  },
                  "oscillator_strength": {
                    "type": "number"
                  },
                  "character": {
                    "type": "string"
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              },
              "conclusion": {
                "type": "string"
              }
            }
          },
          {
            "required": [
              "status",
              "failure"
            ],
            "properties": {
              "status": {
                "const": "bounded_failure"
              },
              "failure": {
                "type": "object",
                "required": [
                  "attempts"
                ],
                "properties": {
                  "attempts": {
                    "type": "string"
                  },
                  "limitation": {
                    "type": "string",
                    "description": "Optional commentary; presence, absence or wording is not scored. Scientific results and specific failure diagnostics are evaluated separately."
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "object",
        "required": [
          "status",
          "failure_report"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "failure_report": {
            "type": "object",
            "required": [
              "reason",
              "missing_endpoint",
              "completed_artifacts"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "missing_endpoint": {
                "type": "string",
                "minLength": 1
              },
              "completed_artifacts": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    ]
  }
}
