                            "minLength": 1
                          },
                          "evidence_files": {
                            "$ref": "#/$defs/evidence_files"
                          }
                        },
                        "required": [
                          "name",
                          "value",
                          "unit",
                          "definition",
                          "evidence_files"
                        ],
                        "additionalProperties": false
                      },
                      "minItems": 1
                    },
                    "assignment": {
                      "type": "string",
                      "minLength": 1
                    },
                    "NTO_or_transition_density_file": {
                      "$ref": "#/$defs/artifact"
                    },
                    "evidence_files": {
                      "$ref": "#/$defs/evidence_files"
                    }
                  },
                  "required": [
                    "method_and_fragments",
                    "metrics",
                    "assignment",
                    "NTO_or_transition_density_file",
                    "evidence_files"
                  ],
                  "additionalProperties": false
                },
                "evidence_files": {
                  "$ref": "#/$defs/evidence_files"
                }
              },
              "required": [
                "root",
                "energy_eV",
                "wavelength_nm",
                "oscillator_strength",
                "physical_state_label",
                "evidence_files"
              ],
              "additionalProperties": false
            },
            "minItems": 5,
            "allOf": [
              {
