    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
      "artifact": {
        "type": "string",
        "pattern": "^(?:\\./)?(outputs|code|data)/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!/)[^\\r\\n\\\\]+$",
        "description": "Workspace-relative path to a real artifact; no absolute, parent-traversal or external private paths."
      },
      "evidence_files": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(?:\\./)?(outputs|code|data)/(?!\\.\\.(?:/|$))(?!.*\\/\\.\\.(?:/|$))(?!/)[^\\r\\n\\\\]+$",
          "description": "Workspace-relative path to a real artifact; no absolute, parent-traversal or external private paths."
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "transition_set": {
        "type": "object",
        "properties": {
          "system": {
            "type": "string",
            "minLength": 1
          },
          "geometry_record_id": {
