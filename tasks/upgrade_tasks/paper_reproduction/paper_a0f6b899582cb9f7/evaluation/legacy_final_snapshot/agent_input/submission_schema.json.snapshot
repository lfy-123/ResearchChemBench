{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "oneOf": [
      {
        "required": [
          "status",
          "method",
          "validation",
          "optimized_geometry",
          "observables",
          "conclusion"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "complete"
            ]
          },
          "method": {
            "type": "object",
            "required": [
              "software",
              "level",
              "charge",
              "multiplicity",
              "origin_convention",
              "axis_convention"
            ],
            "properties": {
              "software": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "charge": {
                "type": "integer"
              },
              "multiplicity": {
                "type": "integer"
              },
              "origin_convention": {
                "type": "string"
              },
              "axis_convention": {
                "type": "string"
              }
            }
          },
          "validation": {
            "type": "object",
            "required": [
              "optimization_converged",
              "minimum_validated",
              "evidence"
            ],
            "properties": {
              "optimization_converged": {
                "type": "boolean"
              },
              "minimum_validated": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string"
              }
            }
          },
          "optimized_geometry": {
            "type": "array",
            "minItems": 24,
            "items": {
              "type": "object",
              "required": [
                "element",
                "x_angstrom",
                "y_angstrom",
                "z_angstrom"
              ],
              "properties": {
                "element": {
                  "type": "string"
                },
                "x_angstrom": {
                  "type": "number"
                },
                "y_angstrom": {
                  "type": "number"
                },
                "z_angstrom": {
                  "type": "number"
                }
              }
            }
          },
          "observables": {
            "type": "object",
            "required": [
              "dipole_debye",
              "qxx_debye_angstrom",
              "qxy_debye_angstrom",
              "qxz_debye_angstrom",
              "qyy_debye_angstrom",
              "qyz_debye_angstrom",
              "qzz_stacking_debye_angstrom",
              "planarity_rms_angstrom",
              "ns_distance_angstrom"
            ],
            "properties": {
              "dipole_debye": {
                "type": "number"
              },
              "qxx_debye_angstrom": {
                "type": "number",
                "description": "Raw Cartesian charge second-moment component in Debye angstrom in the declared molecular frame; not a traceless quadrupole."
              },
              "qxy_debye_angstrom": {
                "type": "number",
                "description": "Raw Cartesian charge second-moment component in Debye angstrom in the declared molecular frame; not a traceless quadrupole."
              },
              "qxz_debye_angstrom": {
                "type": "number",
                "description": "Raw Cartesian charge second-moment component in Debye angstrom in the declared molecular frame; not a traceless quadrupole."
              },
              "qyy_debye_angstrom": {
                "type": "number",
                "description": "Raw Cartesian charge second-moment component in Debye angstrom in the declared molecular frame; not a traceless quadrupole."
              },
              "qyz_debye_angstrom": {
                "type": "number",
                "description": "Raw Cartesian charge second-moment component in Debye angstrom in the declared molecular frame; not a traceless quadrupole."
              },
              "qzz_stacking_debye_angstrom": {
                "type": "number",
                "description": "Raw Cartesian charge second-moment component in Debye angstrom in the declared molecular frame; not a traceless quadrupole."
              },
              "planarity_rms_angstrom": {
                "type": "number"
              },
              "ns_distance_angstrom": {
                "type": "number"
              }
            }
          },
          "conclusion": {
            "type": "string"
          }
        }
      },
      {
        "required": [
          "status",
          "method",
          "validation"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "bounded_failure"
            ]
          },
          "method": {
            "type": "object",
            "required": [
              "software",
              "level",
              "charge",
              "multiplicity",
              "origin_convention",
              "axis_convention"
            ],
            "properties": {
              "software": {
                "type": "string"
              },
              "level": {
                "type": "string"
              },
              "charge": {
                "type": "integer"
              },
              "multiplicity": {
                "type": "integer"
              },
