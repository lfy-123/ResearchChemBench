{
  "paper_id": "paper_4e9774f4128551d3",
  "rules": [
    {
      "rule_id": "r_identity",
      "reference_id": "kp_identity",
      "type": "semantic",
      "expected": "Both supplied named structures are individually represented, each with 53 atoms.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.structures"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "r_validation",
      "reference_id": "kp_stationary",
      "type": "semantic",
      "expected": "Per-structure frequency/stationary-point validation is reported, including imaginary-mode information. Verify the gas-phase thermal correction and solution single-point components refer to the same identified endpoint and the declared primary protocol.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.structures"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "r_delta",
      "reference_id": "kp_delta",
      "type": "numeric",
      "applies_when": {
        "$.status": "completed"
      },
      "target": 2.3171919,
      "unit": "kcal/mol",
      "tolerance": 1,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.delta_g_sol"
        ],
        "comparison": "absolute difference"
      }
    },
    {
      "rule_id": "r_conclusion",
      "reference_id": "c_final",
      "type": "semantic",
      "applies_when": {
        "$.status": [
          "completed",
          "bounded_failure"
        ]
      },
      "expected": "The validated structure-50 and structure-S20 calculations give a signed G(S20)-G(50) and identify the lower-free-energy structure under the primary methanol thermochemical protocol. Reconstruct each G_sol as E_SP,sol + (G_low,gas - E_low,gas), then form G(S20)-G(50) with consistent units and standard state. Numerical and endpoint-validation evidence must both be present.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.structures",
          "$.conditions",
          "$.delta_g_sol",
          "$.sign_convention",
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
