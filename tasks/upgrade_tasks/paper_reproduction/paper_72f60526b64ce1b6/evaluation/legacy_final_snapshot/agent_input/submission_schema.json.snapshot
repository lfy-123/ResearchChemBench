{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "oneOf": [
      {
        "required": [
          "status",
          "system",
          "calculation",
          "validation",
          "conclusion"
        ],
        "properties": {
          "status": {
            "const": "success"
          },
          "system": {
            "type": "object",
            "required": [
              "charge",
              "multiplicity",
              "atom_count",
              "structure_file"
            ],
            "properties": {
              "charge": {
                "type": "integer"
              },
              "multiplicity": {
                "type": "integer"
              },
              "atom_count": {
                "type": "integer"
              },
              "structure_file": {
                "type": "string"
              }
            }
          },
          "calculation": {
            "type": "object",
            "required": [
              "method",
              "software",
              "field_v",
              "dipole_magnitude_debye",
              "axis_convention",
              "convergence_evidence"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "software": {
                "type": "string"
              },
              "field_v": {
                "type": "number"
              },
              "dipole_magnitude_debye": {
                "type": "number"
              },
              "axis_convention": {
                "type": "string"
              },
              "convergence_evidence": {
                "type": "string"
              }
            }
          },
          "validation": {
            "type": "object",
            "required": [
              "geometry_or_stationarity",
              "independent_check",
              "details"
            ],
            "properties": {
              "geometry_or_stationarity": {
                "type": "string"
              },
              "independent_check": {
                "type": "string"
              },
              "details": {
                "type": "string"
              }
            }
          },
          "conclusion": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "limitations": {
                "type": "string",
                "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
              }
            }
          }
        }
      },
      {
        "required": [
          "status",
          "system",
          "calculation",
          "validation",
          "conclusion"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "system": {
            "type": "object",
            "required": [
              "charge",
              "multiplicity",
              "atom_count",
              "structure_file"
            ],
            "properties": {
              "charge": {
                "type": "integer"
              },
              "multiplicity": {
                "type": "integer"
              },
              "atom_count": {
                "type": "integer"
              },
              "structure_file": {
                "type": "string"
              }
            }
          },
          "calculation": {
            "type": "object",
            "required": [
              "method",
              "software",
              "field_v",
              "dipole_magnitude_debye",
              "convergence_evidence"
            ],
            "properties": {
              "method": {
                "type": "string"
              },
              "software": {
                "type": "string"
              },
              "field_v": {
                "type": "number"
              },
              "dipole_magnitude_debye": {
                "type": "null"
              },
              "axis_convention": {
                "type": "string"
              },
              "convergence_evidence": {
                "type": "string"
              }
            }
          },
          "validation": {
            "type": "object",
            "required": [
              "geometry_or_stationarity",
              "independent_check",
              "details"
            ],
            "properties": {
              "geometry_or_stationarity": {
                "type": "string"
              },
              "independent_check": {
                "type": "string"
              },
              "details": {
                "type": "string"
              }
            }
          },
          "conclusion": {
            "type": "object",
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "limitations": {
                "type": "string",
                "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
              }
            }
          }
        }
      }
    ]
  }
}
