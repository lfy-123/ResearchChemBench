              "items": {
                "type": "string",
                "minLength": 1,
                "description": "Actual calculation record ID; IDs must resolve to successful jobs when supporting numerical results."
              }
            },
            "alternative_record_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "Actual calculation record ID; IDs must resolve to successful jobs when supporting numerical results."
              }
            },
            "uncertainty_interpretation": {
              "type": "string",
              "minLength": 1,
              "description": "Bound from actual comparisons; not missing jobs"
            },
            "evidence_files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!.*[\\r\\n])(?:\\./)?(outputs|data|code)/(?!/)(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9_./+\\-]+$"
              }
            }
          },
          "required": [
            "factor",
            "baseline_value",
            "alternative_value",
            "difference",
            "unit",
            "baseline_record_ids",
            "alternative_record_ids",
            "uncertainty_interpretation",
            "evidence_files"
          ],
          "additionalProperties": false
        }
      },
      "conclusion": {
        "type": "object",
        "properties": {
          "assessment": {
            "enum": [
              "supported",
              "refuted",
              "not_distinguishable",
              "incomplete"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "description": "Evidence-bound scientific conclusion"
          },
          "supported_scope": {
            "type": "string",
            "minLength": 1,
            "description": "Local model only"
          },
          "limits": {
            "type": "string",
            "minLength": 1,
            "description": "Unresolved mechanisms/uncertainty"
          },
          "evidence_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?!.*[\\r\\n])(?:\\./)?(outputs|data|code)/(?!/)(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9_./+\\-]+$"
            }
          }
        },
        "required": [
          "assessment",
          "statement",
          "supported_scope",
          "limits",
          "evidence_files"
        ],
        "additionalProperties": false
      },
      "evidence_files": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^(?!.*[\\r\\n])(?:\\./)?(outputs|data|code)/(?!/)(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9_./+\\-]+$"
        }
      },
      "resource_usage": {
        "type": "object",
        "properties": {
          "scientific_engine_starts": {
            "type": "integer",
            "minimum": 0
          },
          "successful_jobs": {
            "type": "integer",
            "minimum": 0
          },
          "failed_jobs": {
            "type": "integer",
            "minimum": 0
          },
          "restart_count": {
            "type": "integer",
            "minimum": 0
          },
          "allocated_cores": {
            "type": "integer",
            "minimum": 0
          },
          "summed_job_wall_hours": {
            "type": "number",
            "minimum": 0
          },
          "cpu_core_hours": {
            "type": "number",
            "minimum": 0
          },
          "elapsed_calendar_hours": {
            "type": "number",
            "minimum": 0
          },
          "accounting_file": {
            "type": "string",
            "pattern": "^(?!.*[\\r\\n])(?:\\./)?(outputs|data|code)/(?!/)(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9_./+\\-]+$"
          }
        },
        "required": [
          "scientific_engine_starts",
          "successful_jobs",
          "failed_jobs",
          "restart_count",
          "allocated_cores",
          "summed_job_wall_hours",
          "cpu_core_hours",
          "elapsed_calendar_hours",
          "accounting_file"
        ],
        "additionalProperties": false
      },
      "failure_report": {
        "type": "object",
        "properties": {
          "attempted_scope": {
            "type": "string",
            "minLength": 1,
            "description": "Scope actually attempted"
          },
          "cause": {
            "type": "string",
            "minLength": 1,
            "description": "Observed issue"
          },
          "missing_endpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Required missing endpoint"
            }
          },
          "diagnostic_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?!.*[\\r\\n])(?:\\./)?(outputs|data|code)/(?!/)(?!\\.\\.(?:/|$))(?!.*?/\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9_./+\\-]+$"
            }
          },
          "stage": {
            "enum": [
              "pre_engine",
              "engine_or_analysis"
            ]
          }
        },
        "required": [
          "attempted_scope",
          "cause",
          "missing_endpoints",
          "diagnostic_files"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "paper_id",
      "schema_version",
      "status",
      "methods",
      "calculation_records",
      "conclusion",
      "evidence_files",
      "resource_usage"
    ],
    "additionalProperties": false,
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "complete"
            }
          }
        },
        "then": {
          "required": [
            "results",
            "hypotheses",
            "sensitivity"
          ],
          "properties": {
            "methods": {
              "required": [
                "primary",
                "sensitivity"
              ]
            },
            "calculation_records": {
              "contains": {
                "properties": {
                  "kind": {
                    "enum": [
                      "minimum",
                      "transition_state",
                      "single_point",
                      "constrained_diagnostic",
                      "excited_state",
                      "kinetic_analysis"
                    ]
                  }
                }
              },
              "minItems": 1
            },
            "conclusion": {
              "properties": {
                "assessment": {
                  "enum": [
                    "supported",
                    "refuted",
                    "not_distinguishable"
                  ]
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "bounded_failure"
            }
          }
        },
        "then": {
          "required": [
            "failure_report"
          ],
          "properties": {
            "conclusion": {
              "properties": {
                "assessment": {
                  "const": "incomplete"
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "const": "bounded_failure"
            },
            "calculation_records": {
              "maxItems": 0
            }
          }
        },
        "then": {
          "properties": {
            "status": {
              "const": "bounded_failure"
            },
            "methods": {
              "maxProperties": 0
            },
            "calculation_records": {
              "maxItems": 0
            },
            "failure_report": {
              "required": [
                "stage"
              ],
              "properties": {
                "stage": {
                  "const": "pre_engine"
                }
              }
            },
            "resource_usage": {
              "properties": {
                "scientific_engine_starts": {
                  "const": 0
                },
                "successful_jobs": {
                  "const": 0
                },
                "failed_jobs": {
                  "const": 0
                },
                "restart_count": {
                  "const": 0
                },
                "allocated_cores": {
                  "const": 0
                },
                "summed_job_wall_hours": {
                  "const": 0
                },
                "cpu_core_hours": {
                  "const": 0
                }
              }
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "results"
                ]
              },
              {
                "required": [
                  "hypotheses"
                ]
              },
              {
                "required": [
                  "sensitivity"
                ]
              }
            ]
          }
        }
      },
      {
        "if": {
          "properties": {
            "calculation_records": {
              "minItems": 1
            }
          }
        },
        "then": {
          "properties": {
            "methods": {
              "required": [
                "primary"
              ]
            }
          }
        }
      },
      {
        "if": {
          "required": [
            "failure_report"
          ],
          "properties": {
            "failure_report": {
              "required": [
                "stage"
              ],
              "properties": {
                "stage": {
                  "const": "pre_engine"
                }
              }
            }
          }
        },
        "then": {
          "properties": {
            "status": {
              "const": "bounded_failure"
            },
            "methods": {
              "maxProperties": 0
            },
            "calculation_records": {
              "maxItems": 0
            },
            "failure_report": {
              "required": [
                "stage"
              ],
              "properties": {
                "stage": {
                  "const": "pre_engine"
                }
              }
            },
            "resource_usage": {
              "properties": {
                "scientific_engine_starts": {
                  "const": 0
                },
                "successful_jobs": {
                  "const": 0
                },
                "failed_jobs": {
                  "const": 0
                },
                "restart_count": {
                  "const": 0
                },
                "allocated_cores": {
                  "const": 0
                },
                "summed_job_wall_hours": {
                  "const": 0
                },
                "cpu_core_hours": {
                  "const": 0
                }
              }
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "results"
                ]
              },
              {
                "required": [
                  "hypotheses"
                ]
              },
              {
                "required": [
                  "sensitivity"
                ]
              }
            ]
          }
        }
      }
    ]
  },
  "validation_boundary": "Format only. Real evidence and scientific adjudication are separate. Bounded failure, including a documented zero-launch pre-engine gate, is not scientific completion."
}
