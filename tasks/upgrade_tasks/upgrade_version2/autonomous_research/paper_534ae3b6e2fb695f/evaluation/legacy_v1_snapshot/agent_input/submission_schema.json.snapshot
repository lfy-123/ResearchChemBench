              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "enum": [
                      "minimum",
                      "transition_state",
                      "single_point",
                      "constrained_diagnostic",
                      "excited_state"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "geometry_file",
                  "atom_mapping_file",
                  "energies",
                  "validation"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "failed"
                  }
                }
              },
              "then": {
                "required": [
                  "failure_reason"
                ]
              }
