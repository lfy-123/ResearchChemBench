{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "methods",
      "molecules",
      "ordering",
      "validation",
      "conclusion"
    ],
    "properties": {
      "status": {
        "enum": [
          "complete",
          "bounded_failure"
