{
  "paper_id": "paper_5d94285cfbd51973",
  "items": [
    {
      "key_point_id": "ar_process",
      "key_point_type": "process",
      "statement": "The investigation independently records distinct AZ9 conformers, advances candidates with candidate-specific evidence, and verifies the selected structure as a minimum.",
      "expected": "A finite deduplicated candidate record, explicit advancement/selection basis, and zero-imaginary-frequency evidence are supplied.",
      "evidence_ids": [
        "e_ar_method",
        "e_ar_geometry"
      ]
    },
    {
      "key_point_id": "ar_method",
      "key_point_type": "process",
      "statement": "The source study treats AZ9 as an isolated gas-phase molecule and computes molecular electronic properties with DFT.",
      "expected": "The submission independently identifies software, electronic-structure method, representation, phase, and scientific justification.",
      "evidence_ids": [
        "e_ar_method"
      ]
    },
    {
      "key_point_id": "ar_search",
      "key_point_type": "process",
      "statement": "Record the actual AZ9 candidate generation, computed energy comparison and validation used to select the reported structure.",
      "expected": "Generation, deduplication, advancement, computed energy span and actual candidate coverage are reported.",
      "evidence_ids": [
        "e_ar_geometry"
      ]
    },
    {
      "key_point_id": "ar_structure",
      "key_point_type": "process",
      "statement": "The selected result is a molecular structure associated with the reported electronic properties.",
      "expected": "An XYZ structure and explicit selection basis are supplied, together with stationarity evidence.",
      "evidence_ids": [
        "e_ar_geometry"
      ]
    },
    {
      "key_point_id": "ar_sensitivity",
      "key_point_type": "process",
      "statement": "The source values are method-dependent DFT descriptors, so robustness must be assessed rather than treated as experimental constants.",
      "expected": "A scientifically motivated sensitivity test reports changes in HOMO, LUMO, gap, and dipole and interprets them.",
      "evidence_ids": [
        "e_ar_method",
        "e_ar_values"
      ]
    },
    {
      "key_point_id": "ar_homo",
      "key_point_type": "result",
      "statement": "AZ9 has a reported HOMO energy near -5.5758 eV.",
      "expected": -5.5758,
      "evidence_ids": [
        "e_ar_values"
      ]
    },
    {
      "key_point_id": "ar_lumo",
      "key_point_type": "result",
      "statement": "AZ9 has a reported LUMO energy near -1.1556 eV.",
      "expected": -1.1556,
      "evidence_ids": [
        "e_ar_values"
      ]
    },
    {
      "key_point_id": "ar_gap",
      "key_point_type": "result",
      "statement": "The AZ9 HOMO-LUMO gap is near 4.4202 eV.",
      "expected": 4.4202,
      "evidence_ids": [
        "e_ar_values"
      ]
    },
    {
      "key_point_id": "ar_dipole",
      "key_point_type": "result",
      "statement": "The reported AZ9 dipole moment is near 5.8470 D.",
      "expected": 5.847,
      "evidence_ids": [
        "e_ar_values"
      ]
    },
    {
      "key_point_id": "ar_derived",
      "key_point_type": "result",
      "statement": "The source row gives IP 5.5758 eV, EA 1.1556 eV, hardness 2.2101 eV, softness 0.2262 eV^-1, and electronegativity 3.3657 eV.",
      "expected": "These values or internally consistent independently derived values are reported with units and signs; conventional chemical potential and electrophilicity must follow the public formulas.",
      "evidence_ids": [
        "e_ar_values"
      ]
    }
  ]
}
