{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "oneOf": [
      {
        "properties": {
          "status": {
            "const": "completed"
          },
          "identity": {
            "type": "object",
            "required": [
              "formula",
              "charge",
              "multiplicity",
              "core_verified",
              "atom_count",
              "preprocessing_summary",
              "provenance"
            ],
            "properties": {
              "formula": {
                "type": "string"
              },
              "charge": {
                "type": "integer"
              },
              "multiplicity": {
                "type": "integer"
              },
              "core_verified": {
                "type": "boolean"
              },
              "atom_count": {
                "type": "integer",
                "minimum": 1
              },
              "preprocessing_summary": {
                "type": "string"
              },
              "provenance": {
                "type": "string"
              }
            }
          },
          "route": {
            "type": "object",
            "required": [
              "software",
              "ground_state_method",
              "excited_state_method",
              "solvent_model"
            ],
            "properties": {
              "software": {
                "type": "string"
              },
              "ground_state_method": {
                "type": "string"
              },
              "excited_state_method": {
                "type": "string"
              },
              "solvent_model": {
                "type": "string"
              }
            }
          },
          "validation": {
            "type": "object",
            "required": [
              "optimization_converged",
              "frequency_hessian_check_performed",
              "state_selection_basis",
              "state_evidence",
              "starting_structure_coverage"
            ],
            "properties": {
              "optimization_converged": {
                "type": "boolean"
              },
              "frequency_hessian_check_performed": {
                "type": "boolean"
              },
              "state_selection_basis": {
                "type": "string"
              },
              "state_evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "state_label",
                    "energy_eV",
                    "oscillator_strength",
                    "transition_character"
                  ],
                  "properties": {
                    "state_label": {
                      "type": "string"
                    },
                    "energy_eV": {
                      "type": "number"
                    },
                    "oscillator_strength": {
                      "type": "number"
                    },
                    "transition_character": {
                      "type": "string"
                    }
                  }
                }
              },
              "starting_structure_coverage": {
                "type": "string"
              },
              "coverage_and_limitations": {
                "type": "string",
                "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
              }
            }
          },
          "result": {
            "type": "object",
            "required": [
              "dominant_state",
              "excitation_energy_eV",
              "oscillator_strength",
              "conclusion"
            ],
            "properties": {
              "dominant_state": {
                "type": "string"
              },
              "excitation_energy_eV": {
                "type": "number"
              },
              "oscillator_strength": {
                "type": "number"
              },
              "conclusion": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "status",
          "identity",
          "route",
          "validation",
          "result"
        ]
      },
      {
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "failure": {
            "type": "object",
            "required": [
              "failed_stage",
              "diagnostics",
              "attempted_remedies",
              "remaining_unknowns"
            ],
            "properties": {
              "failed_stage": {
                "type": "string"
              },
              "diagnostics": {
                "type": "string"
              },
              "attempted_remedies": {
                "type": "string"
              },
              "remaining_unknowns": {
                "type": "string"
              }
            }
          },
          "identity": {
            "type": "object",
            "required": [
              "provenance"
            ],
            "properties": {
              "provenance": {
                "type": "string"
              }
            }
          }
        },
        "required": [
          "status",
          "failure",
          "identity"
        ]
      }
    ]
  }
}
