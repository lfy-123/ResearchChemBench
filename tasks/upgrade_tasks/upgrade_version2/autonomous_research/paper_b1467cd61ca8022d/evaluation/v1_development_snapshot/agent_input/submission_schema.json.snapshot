          },
          "required": [
            "id",
            "object_id",
            "kind",
            "role",
            "input_file",
            "output_file",
            "state_label"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "successful"
                  }
                }
              },
              "then": {
                "required": [
                  "convergence_file"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "successful"
                  },
                  "role": {
                    "not": {
                      "const": "density_analysis"
                    }
                  }
                }
              },
              "then": {
                "required": [
                  "geometry_file",
                  "electronic_Eh"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "failed"
                  }
                }
              },
              "then": {
                "required": [
                  "failure_diagnostics"
                ]
              }
            }
          ]
        },
