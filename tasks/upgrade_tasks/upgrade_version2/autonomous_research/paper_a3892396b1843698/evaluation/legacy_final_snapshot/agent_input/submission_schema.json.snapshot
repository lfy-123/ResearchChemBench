{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "system",
      "method",
      "channels",
      "search_and_validation",
      "conclusion"
    ],
    "properties": {
      "status": {
        "type": "string"
      },
      "system": {
        "type": "object",
        "required": [
          "input_path",
          "charge",
          "multiplicity"
        ],
        "properties": {
          "input_path": {
            "type": "string"
          },
          "charge": {
            "type": "integer"
          },
          "multiplicity": {
            "type": "integer"
          }
        }
      },
      "method": {
        "type": "object",
        "required": [
          "software",
          "model",
          "thermochemistry",
          "reference_state"
        ],
        "properties": {
          "software": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "thermochemistry": {
            "type": "string"
          },
          "reference_state": {
            "type": "string"
          }
        }
      },
      "channels": {
        "type": "object",
        "required": [
          "shift_33",
          "shift_55"
        ],
        "properties": {
          "shift_33": {
            "type": "object",
            "required": [
              "channel",
              "outcome",
              "candidate_id",
              "barrier_kcal_mol",
              "imaginary_frequency_cm-1",
              "validation"
            ],
            "properties": {
              "channel": {
                "type": "string",
                "const": "[3,3]"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "validated_success",
                  "bounded_failure"
                ]
              },
              "candidate_id": {
                "type": "string"
              },
              "barrier_kcal_mol": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "imaginary_frequency_cm-1": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "validation": {
                "type": "object",
                "required": [
                  "converged",
                  "one_imaginary_frequency",
                  "displacement_supports_channel",
                  "evidence"
                ],
                "properties": {
                  "converged": {
                    "type": "boolean"
                  },
                  "one_imaginary_frequency": {
                    "type": "boolean"
                  },
                  "displacement_supports_channel": {
                    "type": "boolean"
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              },
              "attempts": {
                "type": "string"
              },
              "limitation": {
                "type": "string",
                "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
              }
            },
            "oneOf": [
              {
                "required": [
                  "attempts"
                ],
                "properties": {
                  "outcome": {
                    "const": "bounded_failure"
                  }
                }
              },
              {
                "properties": {
                  "outcome": {
                    "const": "validated_success"
                  }
                }
              }
            ]
          },
          "shift_55": {
            "type": "object",
            "required": [
              "channel",
              "outcome",
              "candidate_id",
              "barrier_kcal_mol",
              "imaginary_frequency_cm-1",
              "validation"
            ],
            "properties": {
              "channel": {
                "type": "string",
                "const": "[5,5]"
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "validated_success",
                  "bounded_failure"
                ]
              },
              "candidate_id": {
                "type": "string"
              },
              "barrier_kcal_mol": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "imaginary_frequency_cm-1": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "validation": {
                "type": "object",
                "required": [
                  "converged",
                  "one_imaginary_frequency",
                  "displacement_supports_channel",
                  "evidence"
                ],
                "properties": {
                  "converged": {
                    "type": "boolean"
                  },
                  "one_imaginary_frequency": {
                    "type": "boolean"
                  },
                  "displacement_supports_channel": {
                    "type": "boolean"
                  },
                  "evidence": {
                    "type": "string"
                  }
                }
              },
              "attempts": {
                "type": "string"
              },
              "limitation": {
                "type": "string",
                "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
              }
            },
            "oneOf": [
              {
                "required": [
                  "attempts"
                ],
                "properties": {
                  "outcome": {
                    "const": "bounded_failure"
                  }
                }
              },
              {
                "properties": {
                  "outcome": {
                    "const": "validated_success"
                  }
                }
              }
            ]
          }
        }
      },
      "search_and_validation": {
        "type": "object",
        "required": [
          "candidate_generation",
          "deduplication",
          "coverage"
        ],
        "properties": {
          "candidate_generation": {
            "type": "string"
          },
          "deduplication": {
            "type": "string"
          },
          "coverage": {
            "type": "string"
          },
          "stopping_rule": {
            "type": "string",
            "description": "Optional commentary; not an independent scoring requirement."
          },
          "limitations": {
            "type": "string",
            "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
          }
        }
      },
      "conclusion": {
        "type": "string"
      }
    }
  }
}
