{
  "type": "object",
  "required": [
    "status",
    "systems",
    "overall_conclusion",
    "provenance"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "bounded_failure"
      ]
    },
    "systems": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "system_id",
          "identity",
          "system_conclusion"
        ],
        "properties": {
          "system_id": {
            "type": "string",
            "enum": [
              "dFHeptZ",
              "dClHeptZ",
              "dOMeHeptZ",
              "dMeHeptZ"
            ]
          },
          "identity": {
            "type": "object",
            "required": [
              "name",
              "formula",
              "smiles",
              "charge",
              "multiplicity",
              "evidence"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "formula": {
                "type": "string"
              },
              "smiles": {
                "type": "string"
              },
              "charge": {
                "const": 0
              },
              "multiplicity": {
                "const": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "system_conclusion": {
            "type": "string",
            "minLength": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "validation",
              "transitions",
              "orbital_localization"
            ],
            "properties": {
              "validation": {
                "type": "object",
                "required": [
                  "structure_3d",
                  "charge",
                  "multiplicity",
                  "optimization_converged",
                  "frequency_minimum",
                  "evidence"
                ],
                "properties": {
                  "structure_3d": {
                    "type": "string",
                    "minLength": 1
                  },
                  "charge": {
                    "const": 0
                  },
                  "multiplicity": {
                    "const": 1
                  },
                  "optimization_converged": {
                    "type": "boolean"
                  },
                  "frequency_minimum": {
                    "type": "boolean"
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "transitions": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "state_number",
                    "energy_eV",
                    "wavelength_nm",
                    "oscillator_strength",
                    "dominant_orbitals",
                    "band_selection",
                    "evidence"
                  ],
                  "properties": {
                    "state_number": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "energy_eV": {
                      "type": "number"
                    },
                    "wavelength_nm": {
                      "type": "number"
                    },
                    "oscillator_strength": {
                      "type": "number",
                      "minimum": 0
                    },
                    "dominant_orbitals": {
                      "type": "string",
                      "minLength": 1
                    },
                    "band_selection": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              "orbital_localization": {
                "type": "object",
                "required": [
                  "criterion",
                  "homo",
                  "lumo",
                  "evidence"
                ],
                "properties": {
                  "criterion": {
                    "type": "string",
                    "minLength": 1
                  },
                  "homo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lumo": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "required": [
              "failure_record"
            ],
            "properties": {
              "failure_record": {
                "type": "object",
                "required": [
                  "attempted_method",
                  "failure_point",
                  "evidence"
                ],
                "properties": {
                  "attempted_method": {
                    "type": "string",
                    "minLength": 1
                  },
                  "failure_point": {
                    "type": "string",
                    "minLength": 1
                  },
                  "limitation": {
                    "type": "string",
                    "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "overall_conclusion": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "software_or_code",
        "methods",
        "solvent",
        "state_count_or_scope"
      ],
      "properties": {
        "software_or_code": {
          "type": "string"
        },
        "methods": {
          "type": "string"
        },
        "solvent": {
          "type": "string"
        },
        "state_count_or_scope": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "string",
      "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
    }
  },
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "systems",
      "overall_conclusion"
    ],
    "properties": {
      "systems": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "validation",
            "transitions",
            "orbital_localization",
            "system_conclusion"
          ],
          "properties": {
            "validation": {
              "type": "object"
            },
            "transitions": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "orbital_localization": {
              "type": "object"
            },
            "system_conclusion": {
              "type": "string"
            }
          }
        }
      },
      "overall_conclusion": {
        "type": "string"
      },
      "limitations": {
        "type": "string",
        "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
      }
    }
  }
}
