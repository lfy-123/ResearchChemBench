      ]
    },
    {
      "key_point_id": "kp_binding_cycle",
      "statement": "Recompute G(host.Cl)-G(host)-G(Cl) for each family and DeltaDeltaG=DeltaGbind(Z)-DeltaGbind(E). Report interaction and distortion with compatible fragment geometry and BSSE conventions. Core rows: E_bind, Z_bind, Z_minus_E. Recompute delta_G_kJ_mol, delta_E_kJ_mol, conformational_cost_kJ_mol from the submitted linked raw outputs and numeric tables. No narrative-only control or reused old scalar receives endpoint credit.",
      "expected": "Recompute G(host.Cl)-G(host)-G(Cl) for each family and DeltaDeltaG=DeltaGbind(Z)-DeltaGbind(E). Report interaction and distortion with compatible fragment geometry and BSSE conventions. Core rows: E_bind, Z_bind, Z_minus_E. Recompute delta_G_kJ_mol, delta_E_kJ_mol, conformational_cost_kJ_mol from the submitted linked raw outputs and numeric tables. No narrative-only control or reused old scalar receives endpoint credit.",
