  "rules": [
    {
      "rule_id": "rule_identity",
      "reference_id": "kp_identity",
      "type": "condition",
      "expected": "Inspect species_registry, every input/geometry mapping and real raw log. Verify stoichiometry, charge/multiplicity, method/state, stationarity or constrained label, and consistent thermochemistry. Use the short C21H24F2NO4S radical and long C22H26F2NO4S homologue, both charge0/doublet. The sole long-chain edit inserts CH2 between short-map13 (N-benzyl carbon) and aromatic ipso14, retaining the radical at map10 and every other atom. For each chain independently compare DMSO and1,2-DCE at298.15K/1atm and two aryl closures: radical10 to either ortho carbon of the N-alkyl-tethered aryl or arenesulfonyl aryl ring. System-specific separated-reactant and uncyclized-radical zeros must be distinguished. Source experimental protocols also change additives; this solvent cross is a controlled model and does not isolate all experimental causes.",
      "binding": {
        "artifact_paths": [
          "report/results.json",
          "report/report.md"
        ],
        "fields": [
          "$.calculation_records",
          "$.methods",
          "$.results"
        ],
        "comparison": "Inspect species_registry, every input/geometry mapping and real raw log. Verify stoichiometry, charge/multiplicity, method/state, stationarity or constrained label, and consistent thermochemistry. Use the short C21H24F2NO4S radical and long C22H26F2NO4S homologue, both charge0/doublet. The sole long-chain edit inserts CH2 between short-map13 (N-benzyl carbon) and aromatic ipso14, retaining the radical at map10 and every other atom. For each chain independently compare DMSO and1,2-DCE at298.15K/1atm and two aryl closures: radical10 to either ortho carbon of the N-alkyl-tethered aryl or arenesulfonyl aryl ring. System-specific separated-reactant and uncyclized-radical zeros must be distinguished. Source experimental protocols also change additives; this solvent cross is a controlled model and does not isolate all experimental causes."
      }
    },
