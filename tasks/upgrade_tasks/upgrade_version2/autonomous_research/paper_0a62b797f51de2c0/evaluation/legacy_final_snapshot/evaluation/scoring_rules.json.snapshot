{
  "paper_id": "paper_0a62b797f51de2c0",
  "rules": [
    {
      "rule_id": "ar_rule_identity",
      "reference_id": "ar_process_identity",
      "type": "semantic",
      "expected": "All three public monomers are calculated with preserved identity and neutral-singlet metadata.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.molecules[*].id",
          "$.molecules[*].structure.smiles",
          "$.molecules[*].method.charge",
          "$.molecules[*].method.multiplicity"
        ],
        "comparison": "expert process comparison"
      }
    },
    {
      "rule_id": "ar_rule_validation",
      "reference_id": "ar_process_validation",
      "type": "semantic",
      "expected": "The agent explicitly validates optimization/conformer coverage and defines ESP comparison. Compare signed ESP on the stated common surface/grid and regional convention, using the same units for all three molecules; inspect actual regional values/maps rather than donor/acceptor labels.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.molecules",
          "$.comparison"
        ],
        "comparison": "expert process comparison"
      }
    },
    {
      "rule_id": "ar_rule_trend",
      "reference_id": "ar_result_trend",
      "type": "semantic",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.molecules",
          "$.comparison"
        ],
        "comparison": "reported ordering compared with source-supported trend"
      },
      "expected": "The reported cross-series comparison is supported by the three identified dipole values, pairwise differences, uncertainty and stated convention. An increasing 0CN-to-1CN-to-2CN trend is the source-supported reference, but an evidence-backed method-dependent departure is acceptable when explicitly reported and bounded; a statement without the values is not full completion."
    },
    {
      "rule_id": "ar_rule_pattern",
      "reference_id": "ar_result_pattern",
      "type": "semantic",
      "expected": "Opposed thiophene-side and cyano-side electrostatic regions are supported or qualified.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparison.trend_statement",
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "ar_rule_final",
      "reference_id": "ar_final_conclusion",
      "type": "semantic",
      "expected": "The submitted dipoles and consistently defined ESP observables establish the cross-series ground-state polarization comparison. Evaluate signed maps, atom regions and conventions using the supplied chemical identities; the source-supported result is an increasing 0CN-to-1CN-to-2CN polarization trend, while an evidence-backed method-dependent departure may be accepted when its values, uncertainty and limitation are explicit.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
