{
  "paper_id": "paper_80441aced6051d86",
  "rules": [
    {
      "rule_id": "r_input",
      "reference_id": "kp_input",
      "type": "condition",
      "expected": "Input verification identifies the 64-atom +2 singlet monomer and 128-atom +4 singlet dimer and reports connectivity checks.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.input_verification.monomer",
          "$.input_verification.dimer"
        ],
        "comparison": "expert condition comparison"
      }
    },
    {
      "rule_id": "r_min",
      "reference_id": "kp_min",
      "type": "condition",
      "expected": "Both systems have endpoint/stability validation, with no imaginary modes or a justified equivalent check.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.systems.monomer.validation",
          "$.systems.dimer.validation"
        ],
        "comparison": "expert condition comparison"
      }
    },
    {
      "rule_id": "r_mono_b",
      "reference_id": "kp_mono",
      "type": "numeric",
      "target": 50.66,
      "unit": "degree; mean of two benzyl-pyridinium acute least-squares interplanar angles",
      "tolerance": 3.0,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.systems.monomer.benzyl_pyridinium_dihedrals_deg[0]",
          "$.systems.monomer.benzyl_pyridinium_dihedrals_deg[1]"
        ],
        "comparison": "absolute difference of reported pair mean; aqueous primary model, correct atom/ring mapping and validated endpoint required. evaluation/author_results retains private author optimized structures as descriptor/identity references; no new RMSD criterion. Use the public ring sets and acos(abs(dot(n1,n2))/(norm(n1)*norm(n2))) in [0,90] degrees; signed four-atom torsions must not be compared directly."
      }
    },
    {
      "rule_id": "r_mono_p",
      "reference_id": "kp_mono",
      "type": "numeric",
      "target": 30.275,
      "unit": "degree; mean of two pyridinium-naphthalene acute least-squares interplanar angles",
      "tolerance": 3.0,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.systems.monomer.pyridinium_naphthalene_dihedrals_deg[0]",
          "$.systems.monomer.pyridinium_naphthalene_dihedrals_deg[1]"
        ],
        "comparison": "absolute difference of reported pair mean; aqueous primary model, correct atom/ring mapping and validated endpoint required. evaluation/author_results retains private author optimized structures as descriptor/identity references; no new RMSD criterion. Use the public ring sets and acos(abs(dot(n1,n2))/(norm(n1)*norm(n2))) in [0,90] degrees; signed four-atom torsions must not be compared directly."
      }
    },
    {
      "rule_id": "r_dist",
      "reference_id": "kp_dimer",
      "type": "numeric",
      "target": 3.63,
      "unit": "angstrom; interplanar stacking separation, not full centroid-vector length",
      "tolerance": 0.25,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.systems.dimer.naphthalene_interplanar_separation_A"
        ],
        "comparison": "absolute difference; aqueous primary model, correct atom/ring mapping and validated endpoint required. evaluation/author_results retains private author optimized structures as descriptor/identity references; no new RMSD criterion."
      }
    },
    {
      "rule_id": "r_slip",
      "reference_id": "kp_dimer",
      "type": "numeric",
      "target": 44.89,
      "unit": "degree",
      "tolerance": 5.0,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.systems.dimer.slip_angle_deg"
        ],
        "comparison": "absolute difference; aqueous primary model, correct atom/ring mapping and validated endpoint required. evaluation/author_results retains private author optimized structures as descriptor/identity references; no new RMSD criterion."
      }
    },
    {
      "rule_id": "r_final",
      "reference_id": "c_final",
      "type": "semantic",
      "expected": "The conclusion independently infers twisted monomer and offset parallel dimer packing from the computed descriptors and limits claims to the searched structures.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1",
  "evaluation_instructions": "Score real computational evidence and correctly identified scientific results. Ordinary limitations/stopping prose is optional and unscored. Partial or failed calculations receive only credit supported by completed work; a valid failure submission is not a completed scientific result. Additional attempts do not invalidate a successful main result. Apply all retained identity/state/condition rules and assess distinct completed observables within each conclusion without inventing additional targets or changing authored tolerances."
}
