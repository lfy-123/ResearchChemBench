              "then": {
                "properties": {
                  "charge": {
                    "const": -1
                  },
                  "multiplicity": {
                    "const": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "record_type": {
                    "const": "electronic_structure"
                  }
                }
              },
              "then": {
                "required": [
                  "charge",
                  "multiplicity",
                  "basis",
                  "geometry_role"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "completed"
                  },
                  "record_type": {
                    "const": "electronic_structure"
                  }
                }
              },
              "then": {
                "required": [
                  "geometry_file",
                  "electronic_energy_hartree",
                  "state_identity"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "record_type": {
                    "const": "analysis"
                  }
                }
              },
              "then": {
                "required": [
                  "analysis_type",
                  "source_evidence_files"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "failed"
                  }
                }
              },
              "then": {
                "required": [
                  "failure_reason"
                ]
              }
            }
          ]
