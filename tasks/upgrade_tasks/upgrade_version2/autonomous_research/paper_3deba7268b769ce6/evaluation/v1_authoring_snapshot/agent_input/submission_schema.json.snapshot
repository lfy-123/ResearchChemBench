              "items": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "system": {
                    "const": "dye3"
                  }
                }
              },
              "then": {
                "properties": {
                  "charge": {
                    "const": -1
                  },
                  "multiplicity": {
                    "const": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "system": {
                    "const": "dye4"
                  }
                }
              },
              "then": {
                "properties": {
                  "charge": {
                    "const": -1
                  },
                  "multiplicity": {
                    "const": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "system": {
                    "const": "methanol"
                  }
                }
              },
              "then": {
                "properties": {
                  "charge": {
                    "const": 0
                  },
                  "multiplicity": {
                    "const": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "system": {
                    "const": "dye3_MeOH"
                  }
                }
              },
              "then": {
                "properties": {
