    "required": [
      "paper_id",
      "status",
      "protocol",
      "object_records",
      "calculation_records",
      "raw_files",
      "resources"
    ],
    "additionalProperties": false,
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "complete"
            }
          }
        },
        "then": {
          "required": [
            "results",
            "hypothesis_tests",
            "sensitivity",
            "conclusion"
          ],
          "properties": {
            "calculation_records": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "successful"
                  },
                  "role": {
                    "not": {
                      "const": "density_analysis"
                    }
                  }
                },
                "required": [
                  "kind",
                  "role"
                ]
              },
              "minContains": 1,
              "minItems": 1
            },
            "resources": {
              "properties": {
                "allocated_cores": {
                  "minimum": 1
                }
              }
            },
            "object_records": {
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "object_id": {
                        "const": "12a"
                      }
                    },
                    "required": [
                      "object_id"
                    ]
                  }
                },
                {
                  "contains": {
                    "properties": {
                      "object_id": {
                        "const": "12d"
                      }
                    },
                    "required": [
                      "object_id"
                    ]
                  }
                }
              ],
              "minItems": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "partial",
                "bounded_failure"
              ]
            }
          }
        },
        "then": {
          "required": [
            "failure_report"
          ]
        }
      }
    ]
  },
  "scientific_boundary": "Contract acceptance is not scientific acceptance. Linked files require evaluator verification, including correct graph, state, raw output, coverage and recomputable quantities. Missing controls cannot be labeled indistinguishable.",
