{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "oneOf": [
      {
        "required": [
          "status",
          "system",
          "calculation",
          "result",
          "validation",
          "conclusion"
        ],
        "properties": {
          "status": {
            "const": "complete"
          },
          "result": {
            "type": "object",
            "required": [
              "s1_state_index",
              "s1_energy_eV",
              "s1_oscillator_strength",
              "radiative_lifetime_ns"
            ],
            "properties": {
              "s1_state_index": {
                "type": "integer",
                "minimum": 1
              },
              "s1_energy_eV": {
                "type": "number"
              },
              "s1_oscillator_strength": {
                "type": "number"
              },
              "radiative_lifetime_ns": {
                "type": "number"
              }
            }
          }
        }
      },
      {
        "required": [
          "status",
          "system",
          "calculation",
          "validation",
          "conclusion",
          "failure"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "failure": {
            "type": "object",
            "required": [
              "missing_endpoint",
              "completed_work",
              "coverage"
            ],
            "properties": {
              "missing_endpoint": {
                "type": "string",
                "minLength": 1
              },
              "completed_work": {
                "type": "string",
                "minLength": 1
              },
              "coverage": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "bounded_failure"
        ]
      },
      "system": {
        "type": "object",
        "required": [
          "compound_id",
          "formula",
          "charge",
          "multiplicity",
          "solvent"
        ],
        "properties": {
          "compound_id": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "charge": {
            "type": "integer"
          },
          "multiplicity": {
            "type": "integer"
          },
          "solvent": {
            "type": "string"
          }
        }
      },
      "calculation": {
        "type": "object",
        "required": [
          "software",
          "method",
          "geometry_convergence",
          "excited_state_convergence",
          "state_selection",
          "lifetime_equation",
          "coverage"
        ],
        "properties": {
          "software": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "geometry_convergence": {
            "type": "string"
          },
          "excited_state_convergence": {
            "type": "string"
          },
          "state_selection": {
            "type": "string"
          },
          "lifetime_equation": {
            "type": "string"
          },
          "coverage": {
            "type": "string"
          }
        }
      },
      "validation": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "type",
            "object",
            "outcome",
            "evidence"
          ],
          "properties": {
            "type": {
              "type": "string"
            },
            "object": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            }
          }
        }
      },
      "conclusion": {
        "type": "object",
        "required": [
          "transition_character",
          "text"
        ],
        "properties": {
          "transition_character": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "limitations": {
            "type": "string",
            "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
          }
        }
      }
    }
  }
}
