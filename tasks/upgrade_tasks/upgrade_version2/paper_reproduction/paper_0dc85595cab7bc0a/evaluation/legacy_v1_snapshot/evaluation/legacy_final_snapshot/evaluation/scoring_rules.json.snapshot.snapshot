{
  "paper_id": "paper_0dc85595cab7bc0a",
  "rules": [
    {
      "rule_id": "pr_r_process",
      "reference_id": "pr_kp_process",
      "type": "semantic",
      "expected": "Candidate-specific mappings, optimization provenance, stationary-point validation and explicit candidate coverage are present.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation.process_evidence",
          "$.coverage.searched_scope",
          "$.candidates"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "pr_r_first",
      "reference_id": "pr_kp_first",
      "type": "semantic",
      "expected": "The first-stage alternatives have a clear reported relative-free-energy ordering with units and uncertainty. Compare equal-composition candidates within each declared reaction stage with a common energy convention. Preserve atom mapping and stage identity; never compare unrelated absolute energies across stages.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparison.ordering_or_result",
          "$.candidates"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "pr_r_second",
      "reference_id": "pr_kp_second",
      "type": "semantic",
      "expected": "The second-stage alternatives and sequential connection to final product are explicitly compared and mapped. Compare equal-composition candidates within each declared reaction stage with a common energy convention. Preserve atom mapping and stage identity; never compare unrelated absolute energies across stages.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparison.ordering_or_result",
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "pr_r_orbital",
      "reference_id": "pr_kp_orbital",
      "type": "semantic",
      "expected": "Electronic selectivity evidence is specific to reactive sites and separated from thermodynamic claims.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparison.electronic_evidence"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "pr_r_final",
      "reference_id": "pr_c_final",
      "type": "semantic",
      "expected": "The computed and validated first-stage and sequential second-stage candidates, comparable free energies and electronic or structural evidence support the product-selectivity conclusion. Endpoint thermodynamic and site-electronic evidence supports a bounded selectivity interpretation, not a proven activation pathway or product rate. No new TS/IRC requirement is introduced.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
