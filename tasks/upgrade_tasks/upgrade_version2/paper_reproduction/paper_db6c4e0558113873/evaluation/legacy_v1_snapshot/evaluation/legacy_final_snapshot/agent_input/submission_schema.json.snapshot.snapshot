{
  "type": "object",
  "required": [
    "protocol",
    "states",
    "conclusion",
    "coverage",
    "uncertainty",
    "provenance",
    "failed_restarts",
    "conformer_handling"
  ],
  "properties": {
    "protocol": {
      "type": "object",
      "required": [
        "software",
        "method",
        "basis",
        "charge",
        "multiplicity",
        "solvent",
        "temperature_K",
        "frequency_validation",
        "standard_state",
        "geometry_convergence"
      ],
      "properties": {
        "software": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "charge": {
          "type": "integer"
        },
        "multiplicity": {
          "type": "integer"
        },
        "solvent": {
          "type": "string"
        },
        "temperature_K": {
          "type": "number"
        },
        "frequency_validation": {
          "type": "string"
        },
        "standard_state": {
          "type": "string"
        },
        "geometry_convergence": {
          "type": "string"
        }
      }
    },
    "states": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "outcome",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "syn_syn_Cu_Int_I_6b",
              "syn_anti_Cu_Int_I_6b"
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "validated",
              "bounded_failure"
            ]
          },
          "energy": {
            "type": "number"
          },
          "angle_deg": {
            "type": "number"
          },
          "validation_status": {
            "type": "string"
          },
          "atom_mapping": {
            "type": "string"
          },
          "final_geometry": {
            "type": "string"
          },
          "imaginary_modes": {
            "type": "string"
          },
          "failure_reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "energy",
              "angle_deg",
              "validation_status",
              "atom_mapping",
              "final_geometry",
              "imaginary_modes"
            ]
          },
          {
            "required": [
              "failure_reason"
            ]
          }
        ]
      }
    },
    "delta_g_kcal_mol": {
      "type": "number"
    },
    "conclusion": {
      "type": "string"
    },
    "limitations": {
      "type": "string",
      "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
    },
    "coverage": {
      "type": "string"
    },
    "uncertainty": {
      "type": "string"
    },
    "provenance": {
      "type": "string"
    },
    "failed_restarts": {
      "type": "string"
    },
    "conformer_handling": {
      "type": "string"
    }
  },
  "required_files": [
    "report/results.json"
  ]
}
