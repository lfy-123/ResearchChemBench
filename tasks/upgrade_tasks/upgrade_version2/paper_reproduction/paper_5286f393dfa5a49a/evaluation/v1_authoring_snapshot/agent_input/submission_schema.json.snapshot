                "mono_S"
              ]
            },
            "record_type": {
              "type": "string",
              "enum": [
                "electronic_structure",
                "analysis"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "completed",
                "failed"
              ]
            },
            "method": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty scientific explanation"
            },
            "environment": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty scientific explanation"
            },
            "input_file": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
            },
            "output_file": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
