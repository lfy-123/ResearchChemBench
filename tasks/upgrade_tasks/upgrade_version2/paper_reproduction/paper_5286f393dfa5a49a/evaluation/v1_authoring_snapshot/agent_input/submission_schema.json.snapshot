                "constrained_control",
                "single_point",
                "excited_state"
              ]
            },
            "geometry_file": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
