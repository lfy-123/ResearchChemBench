              "type": "integer"
            },
            "multiplicity": {
              "type": "integer",
              "minimum": 1
            },
            "basis": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty scientific explanation"
            },
            "geometry_role": {
              "type": "string",
              "enum": [
