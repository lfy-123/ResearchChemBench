          },
          "attempt_log": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
          }
        }
      },
      "calculation_records": {
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
