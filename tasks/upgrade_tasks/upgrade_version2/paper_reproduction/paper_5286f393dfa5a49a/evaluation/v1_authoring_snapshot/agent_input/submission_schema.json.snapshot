                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "system": {
                    "const": "di_R"
                  }
                }
              },
              "then": {
                "properties": {
                  "charge": {
                    "const": 0
                  },
                  "multiplicity": {
                    "const": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "system": {
                    "const": "di_S"
                  }
                }
              },
              "then": {
                "properties": {
                  "charge": {
                    "const": 0
                  },
                  "multiplicity": {
                    "const": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "system": {
                    "const": "mono_R"
                  }
                }
              },
              "then": {
                "properties": {
                  "charge": {
                    "const": 0
                  },
                  "multiplicity": {
                    "const": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "system": {
                    "const": "mono_S"
                  }
                }
              },
              "then": {
                "properties": {
                  "charge": {
                    "const": 0
                  },
                  "multiplicity": {
                    "const": 1
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "record_type": {
                    "const": "electronic_structure"
                  }
                }
              },
              "then": {
                "required": [
                  "charge",
                  "multiplicity",
                  "basis",
                  "geometry_role"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "completed"
                  },
                  "record_type": {
                    "const": "electronic_structure"
                  }
                }
              },
              "then": {
                "required": [
                  "geometry_file",
                  "electronic_energy_hartree",
                  "state_identity"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "record_type": {
                    "const": "analysis"
                  }
                }
              },
              "then": {
                "required": [
                  "analysis_type",
                  "source_evidence_files"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "failed"
                  }
                }
              },
              "then": {
                "required": [
                  "failure_reason"
                ]
              }
            }
