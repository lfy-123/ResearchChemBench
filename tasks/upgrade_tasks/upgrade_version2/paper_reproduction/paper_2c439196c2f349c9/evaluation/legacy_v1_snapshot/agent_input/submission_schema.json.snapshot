        "properties": {
          "assessment": {
            "enum": [
              "supported",
              "refuted",
              "indistinguishable",
              "incomplete"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "supported_scope": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string",
            "minLength": 1
          },
          "evidence_records": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "assessment",
          "statement",
          "supported_scope",
          "limitations",
          "evidence_records"
        ],
        "additionalProperties": false
      },
      "evidence_files": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)?(outputs|data|code)/[A-Za-z0-9_./+@=,: -]+$"
        },
        "minItems": 0
      },
      "resources": {
        "type": "object",
        "properties": {
          "scientific_engine_starts": {
            "type": "integer",
            "minimum": 0
          },
          "successful_starts": {
            "type": "integer",
            "minimum": 0
          },
          "failed_starts": {
            "type": "integer",
            "minimum": 0
          },
          "restarts": {
            "type": "integer",
            "minimum": 0
          },
          "allocated_cores": {
            "type": "integer",
            "minimum": 0
          },
          "wall_job_hours": {
            "type": "number",
            "minimum": 0
          },
          "cpu_core_hours": {
            "type": "number",
            "minimum": 0
          },
          "parallel_elapsed_hours": {
            "type": "number",
            "minimum": 0
          },
          "measurement_basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "scientific_engine_starts",
          "successful_starts",
          "failed_starts",
          "restarts",
          "allocated_cores",
          "wall_job_hours",
          "cpu_core_hours",
          "parallel_elapsed_hours",
          "measurement_basis"
        ],
        "additionalProperties": false
      },
      "failure_report": {
        "type": "object",
        "properties": {
          "attempted_scope": {
            "type": "string",
            "minLength": 1
          },
          "observed_failure": {
            "type": "string",
            "minLength": 1
          },
          "missing_endpoints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "release_conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "evidence_files": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)?(outputs|data|code)/[A-Za-z0-9_./+@=,: -]+$"
            },
            "minItems": 0
          }
        },
        "required": [
          "attempted_scope",
          "observed_failure",
          "missing_endpoints",
          "release_conditions",
          "evidence_files"
        ],
        "additionalProperties": false
      },
      "control_equivalence": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "reference_comparison_id": {
              "type": "string",
              "minLength": 1
            },
            "alternative_control_definition": {
              "type": "string",
              "minLength": 1
            },
            "held_factors": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "changed_factor": {
              "type": "string",
              "minLength": 1
            },
            "coverage_justification": {
              "type": "string",
              "minLength": 1
            },
            "evidence_files": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)?(outputs|data|code)/[A-Za-z0-9_./+@=,: -]+$"
              },
              "minItems": 0
            }
          },
          "required": [
            "reference_comparison_id",
            "alternative_control_definition",
            "held_factors",
            "changed_factor",
            "coverage_justification",
            "evidence_files"
          ],
          "additionalProperties": false
        },
        "minItems": 0
      }
    },
    "required": [
      "paper_id",
      "status",
      "reference_definition",
      "conclusion",
      "evidence_files",
      "resources"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "complete"
            }
          }
        },
        "then": {
          "required": [
            "methods",
            "calculation_records",
            "results",
            "hypotheses",
            "sensitivity"
          ],
          "properties": {
            "calculation_records": {
              "contains": {
                "properties": {
                  "outcome": {
                    "const": "converged"
                  }
                },
                "required": [
                  "outcome"
                ]
              },
              "minContains": 1
            },
            "conclusion": {
              "properties": {
                "assessment": {
                  "enum": [
                    "supported",
                    "refuted",
                    "indistinguishable"
                  ]
                },
                "evidence_records": {
                  "minItems": 1
                }
              }
            },
            "evidence_files": {
              "minItems": 1
            }
          }
        },
        "else": {
          "required": [
            "failure_report"
          ],
          "properties": {
            "conclusion": {
              "properties": {
                "assessment": {
                  "const": "incomplete"
                }
              }
            }
          }
        }
      }
    ]
  },
  "validation_boundary": "Format only. Raw outputs, controls, arithmetic and state identity must pass the scientific evaluator. A bounded failure is accepted for reporting, never as scientific completion."
}
