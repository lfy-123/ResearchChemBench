{
  "paper_id": "paper_a3892396b1843698",
  "rules": [
    {
      "rule_id": "r_pr_kp_ts",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.channels.shift_33.validation",
          "$.channels.shift_55.validation"
        ],
        "comparison": "expert validation"
      },
      "type": "condition",
      "reference_id": "kp_pr_process_ts",
      "expected": "all required validation booleans are true for validated candidates Validation flags alone are insufficient: inspect each actual mode/path/endpoint evidence under the public channel requirements. Distinct starting files for one channel do not establish separate mechanisms."
    },
    {
      "rule_id": "r_pr_kp_ref",
      "expected": "common 3a reference and disclosed consistent thermochemistry",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.method.reference_state",
          "$.method.thermochemistry"
        ],
        "comparison": "expert semantic comparison"
      },
      "type": "semantic",
      "reference_id": "kp_pr_process_reference"
    },
    {
      "rule_id": "r_pr_barrier_33",
      "target": 23.5,
      "unit": "kcal/mol",
      "tolerance": 3,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.channels.shift_33.barrier_kcal_mol"
        ],
        "comparison": "absolute difference"
      },
      "type": "numeric",
      "reference_id": "kp_pr_result_barriers"
    },
    {
      "rule_id": "r_pr_barrier_55",
      "target": 26.2,
      "unit": "kcal/mol",
      "tolerance": 3,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.channels.shift_55.barrier_kcal_mol"
        ],
        "comparison": "absolute difference"
      },
      "type": "numeric",
      "reference_id": "kp_pr_result_barriers"
    },
    {
      "rule_id": "r_pr_order",
      "expected": "[3,3] barrier lower than [5,5]",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert ordering comparison"
      },
      "type": "ordering",
      "reference_id": "kp_pr_result_comparison"
    },
    {
      "rule_id": "r_pr_final",
      "expected": "validated lower [3,3] barrier and source-consistent barrier magnitudes Check common 3a reference and consistent thermochemical/qRRHO components. Limit the ordering to the two validated channels, not the globally best pathway over an unsearched surface.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      },
      "type": "semantic",
      "reference_id": "c_pr_final"
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
