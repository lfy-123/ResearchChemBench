{
  "paper_id": "paper_a0f6b899582cb9f7",
  "rules": [
    {
      "rule_id": "pr_rule_process_opt",
      "reference_id": "pr_process_optimization",
      "type": "condition",
      "expected": "optimization and stationary-point validation are documented, or bounded failure is honestly documented",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation"
        ],
        "comparison": "expert check of convergence and validation evidence"
      }
    },
    {
      "rule_id": "pr_rule_process_struct",
      "reference_id": "pr_process_structure",
      "type": "condition",
      "expected": "axis convention, planarity metric, and N-S metric are explicitly reported Re-extract the plane normal from the declared mapped atoms and project the raw Cartesian quadrupole onto it, retaining origin and units. A traceless tensor or a different origin/axis cannot be substituted without the explicit transformation.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.method.axis_convention",
          "$.observables.planarity_rms_angstrom",
          "$.observables.ns_distance_angstrom"
        ],
        "comparison": "expert check of object-specific structural validation"
      }
    },
    {
      "rule_id": "pr_rule_qzz",
      "reference_id": "pr_result_tensor",
      "type": "numeric",
      "target": -108.35,
      "unit": "Debye angstrom",
      "tolerance": 5,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.observables.qzz_stacking_debye_angstrom"
        ],
        "comparison": "absolute difference in declared stacking-axis component"
      }
    },
    {
      "rule_id": "pr_rule_dipole",
      "reference_id": "pr_result_dipole",
      "type": "semantic",
      "expected": "the reported dipole and tensor are interpreted as evidence for or against a net-dipole-cancelled quadrupolar description, with scope limits",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.observables.dipole_debye",
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "pr_rule_final",
      "reference_id": "pr_final_conclusion",
      "type": "semantic",
      "expected": "The validated M3 calculation determines planarity, the mapped N-S contact, dipole and stacking-axis raw quadrupole, using the specified origin, axes and units.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
