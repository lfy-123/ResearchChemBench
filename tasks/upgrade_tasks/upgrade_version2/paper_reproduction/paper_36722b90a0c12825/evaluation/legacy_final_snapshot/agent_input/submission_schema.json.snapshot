{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "validation",
      "conclusion"
    ],
    "properties": {
      "status": {
        "type": "string"
      },
      "validation": {
        "type": "object",
        "required": [
          "close",
          "open"
        ],
        "properties": {
          "close": {
            "type": "string"
          },
          "open": {
            "type": "string"
          }
        }
      },
      "sensitivity": {
        "type": "string"
      },
      "conclusion": {
        "type": "string"
      },
      "comparison": {
        "type": "object",
        "required": [
          "open_minus_close",
          "unit",
          "reference_convention"
        ],
        "properties": {
          "open_minus_close": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "reference_convention": {
            "type": "string"
          }
        }
      },
      "bounded_failure": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "endpoint",
            "attempted_computation",
            "observed_failure"
          ],
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "attempted_computation": {
              "type": "string"
            },
            "observed_failure": {
              "type": "string"
            },
            "next_limitation": {
              "type": "string",
              "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
            }
          }
        }
      }
    },
    "oneOf": [
      {
        "required": [
          "comparison",
          "sensitivity"
        ]
      },
      {
        "required": [
          "bounded_failure"
        ]
      }
    ]
  }
}
