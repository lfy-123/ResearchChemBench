{
  "paper_id": "paper_36722b90a0c12825",
  "rules": [
    {
      "rule_id": "pr_r1",
      "reference_id": "pr_process",
      "type": "semantic",
      "expected": "Both named endpoints have explicit method, convergence and stationary-point evidence in their individual validation fields, or endpoint-specific bounded failure details.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation.close",
          "$.validation.open"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "pr_r2",
      "reference_id": "pr_result",
      "type": "numeric",
      "target": 0.997,
      "unit": "eV",
      "tolerance": 0.25,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparison.open_minus_close"
        ],
        "comparison": "absolute difference"
      },
      "applicability": "Evaluate each obtained required observable against this rule. A missing or failed required observable receives no scientific-result credit; truthful partial or failed submissions remain valid and may receive credit for other completed work."
    },
    {
      "rule_id": "pr_r3",
      "reference_id": "pr_final",
      "type": "semantic",
      "expected": "The validated close and open structures and primary-protocol G(open)-G(close) determine their relative thermodynamic stability. Assess any near-degeneracy interpretation against the actual computed energy difference, without forcing agreement with that interpretation. Inspect the publicly required sensitivity test: the same physical comparison, actual successful values and resulting change must be traceable. Failed retries are not a completed sensitivity result. Missing required sensitivity remains incomplete, not not_applicable.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparison",
          "$.sensitivity",
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
