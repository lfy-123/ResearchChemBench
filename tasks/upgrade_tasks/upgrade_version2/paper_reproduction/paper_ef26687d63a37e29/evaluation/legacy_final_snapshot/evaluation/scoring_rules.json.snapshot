    },
    {
      "rule_id": "r_pr_H_charge",
      "type": "semantic",
      "reference_id": "kp_pr_charge",
      "expected": "Report all N-ethyl alphaH/betaH ADCH charges with atom mappings. Highlighted contact-H values must use the same nearest H atoms selected by the public O49 distance rule on that species; no hidden source-selected H is required. The free species has no O contact selection. Preserve signed per-site values; any means are auxiliary, not replacements for individual sites.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.species[*].charges",
          "$.charge_summary",
          "$.species[*].distances",
          "$.method.mapping_notes"
        ],
        "comparison": "expert semantic comparison Report all N-ethyl alphaH/betaH ADCH charges with atom mappings. Highlighted contact-H values must use the same nearest H atoms selected by the public O49 distance rule on that species; no hidden source-selected H is required. The free species has no O contact selection. Preserve signed per-site values; any means are auxiliary, not replacements for individual sites."
      }
    }
  ],
  "paper_id": "paper_ef26687d63a37e29",
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
