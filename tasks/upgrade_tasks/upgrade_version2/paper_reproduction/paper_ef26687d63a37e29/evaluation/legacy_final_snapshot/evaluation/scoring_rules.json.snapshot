      }
    },
    {
      "rule_id": "r_pr_P_charge_free",
      "type": "numeric",
      "reference_id": "kp_pr_charge",
      "target": -0.018,
      "unit": "e",
      "tolerance": 0.03,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.charge_summary.free.P_e"
        ],
        "comparison": "absolute difference of absolute P ADCH charge; not alpha-H"
      }
    },
    {
      "rule_id": "r_pr_P_charge_PO",
      "type": "numeric",
      "reference_id": "kp_pr_charge",
      "target": 0.447,
      "unit": "e",
      "tolerance": 0.03,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.charge_summary.PO.P_e"
        ],
        "comparison": "absolute difference of absolute P ADCH charge; not alpha-H"
      }
    },
    {
      "rule_id": "r_pr_P_charge_PA",
      "type": "numeric",
      "reference_id": "kp_pr_charge",
