{
  "rules": [
    {
      "rule_id": "r_pr_minima",
      "type": "condition",
      "expected": "Each species has a frequency validation and structure artifact, or an exact bounded-failure record.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.species[*].imaginary_frequency_count",
          "$.species[*].structure_file",
          "$.species[*].status"
        ],
        "comparison": "expert scientific comparison"
      },
      "reference_id": "kp_pr_process_minima"
    },
    {
      "rule_id": "r_pr_mapping",
      "type": "semantic",
      "expected": "Atom-indexed distances use explicit per-species identities and αH/βH definitions. Use public input-map O49/P46 and the graph-derived N-ethyl alpha/beta H sets, preserving renumbering. On each optimized species use the same designated oxygen for the three primary distances; match each reported contact-H ADCH value to that selected H. The optional summary must agree with species.distances.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.species[*].distances[*].atom_indices",
          "$.method.mapping_notes",
          "$.contact_summary"
        ],
        "comparison": "expert semantic comparison The primary contact oxygen is input atom-map ID 49 in each of PO and PA; P is ID 46. PA O49 is the oxygen drawn as C48=O49 in the supplied mapped graph, not O50 or acyl O51. Track the designated input atoms under documented equivalent renumbering; do not exchange oxygens based on distances or target agreement. Use the same O49 for O_P_A and both H contacts on each optimized geometry; select the nearest H separately within all N-ethyl alphaH and betaH graph-defined sets. Break exact H-distance ties by the smallest input atom-map ID and disclose the tie. No averaging or minimization across different oxygens. Verify summaries against species[].distances and method.mapping_notes; keep other O/H contacts as auxiliary evidence."
      },
      "reference_id": "kp_pr_process_mapping"
    },
    {
      "rule_id": "r_pr_mep",
      "type": "semantic",
      "expected": "Signed MEP observations address the positive phosphorus-containing region and negative carboxylate region with explicit artifacts and scope; distinguish electrostatic potential from electron density using the signed potential rather than conflating it with electron density.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.species[*].mep_observation"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "kp_pr_mep"
    },
    {
      "rule_id": "r_pr_final",
      "type": "semantic",
      "expected": "The calculated contact geometries, mapped ADCH charges and signed MEP provide an integrated assessment of phosphorus-centred noncovalent interactions with the specified oxygen-containing environments, using the established contact aggregation.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion.mechanistic_claim",
          "$.conclusion.supporting_observations"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "con_pr_final"
    },
    {
      "rule_id": "r_pr_po_OP",
      "type": "numeric",
      "reference_id": "kp_pr_distances",
      "target": 1.828,
      "unit": "angstrom",
      "tolerance": 0.25,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.contact_summary.PO.O_P_A"
        ],
        "comparison": "absolute difference; explicitly named species/contact; Figure 6 source target The primary contact oxygen is input atom-map ID 49 in each of PO and PA; P is ID 46. PA O49 is the oxygen drawn as C48=O49 in the supplied mapped graph, not O50 or acyl O51. Track the designated input atoms under documented equivalent renumbering; do not exchange oxygens based on distances or target agreement. Use the same O49 for O_P_A and both H contacts on each optimized geometry; select the nearest H separately within all N-ethyl alphaH and betaH graph-defined sets. Break exact H-distance ties by the smallest input atom-map ID and disclose the tie. No averaging or minimization across different oxygens. Verify summaries against species[].distances and method.mapping_notes; keep other O/H contacts as auxiliary evidence."
      }
    },
    {
      "rule_id": "r_pr_po_OalphaH",
      "type": "numeric",
      "reference_id": "kp_pr_distances",
