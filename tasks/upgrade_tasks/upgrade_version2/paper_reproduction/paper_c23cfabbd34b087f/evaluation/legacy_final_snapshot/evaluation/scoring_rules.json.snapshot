{
  "paper_id": "paper_c23cfabbd34b087f",
  "rules": [
    {
      "rule_id": "pr_r_geom",
      "reference_id": "pr_process_geometry",
      "type": "semantic",
      "expected": "validated converged stationary point and reported frequency/curvature result",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation.stationary_point_test",
          "$.validation.imaginary_frequency_count"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "pr_r_state",
      "reference_id": "pr_process_state",
      "type": "semantic",
      "expected": "state selection is supported by state-resolved energy/oscillator and orbital or transition-density evidence",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation.state_selection_evidence",
          "$.investigation.selection_rule"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "pr_r_wave",
      "reference_id": "pr_wavelength",
      "type": "numeric",
      "target": 735,
      "unit": "nm",
      "tolerance": 25,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.result.wavelength_nm"
        ],
        "comparison": "absolute difference"
      }
    },
    {
      "rule_id": "pr_r_osc",
      "reference_id": "pr_oscillator",
      "type": "numeric",
      "target": 1.24,
      "unit": "dimensionless",
      "tolerance": 0.25,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.result.oscillator_strength"
        ],
        "comparison": "absolute difference"
      }
    },
    {
      "rule_id": "pr_r_char",
      "reference_id": "pr_character",
      "type": "semantic",
      "expected": "HOMO-to-LUMO transition with delocalized pi orbitals and pi-pi* character",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.result.dominant_transition",
          "$.result.transition_character"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "pr_r_final",
      "reference_id": "pr_final",
      "type": "semantic",
      "expected": "The validated neutral-singlet model has the required intense low-energy vertical transition, wavelength and oscillator strength with delocalized HOMO-to-LUMO pi-pi* character supported by the transition analysis.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.result.conclusion"
        ],
        "comparison": "expert semantic comparison"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
