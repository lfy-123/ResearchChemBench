                                "required": [
                                  "present",
                                  "frequency_cm_inverse",
                                  "absence_reason"
                                ],
                                "properties": {
                                  "present": {
                                    "const": false
                                  },
                                  "frequency_cm_inverse": {
                                    "const": null
                                  },
                                  "absence_reason": {
                                    "type": "string",
                                    "minLength": 1,
                                    "description": "Nonempty scientific explanation"
                                  }
                                }
                              }
                            ]
                          },
                          "mode_assignment_file": {
                            "type": "string",
                            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
                          },
                          "phase_limit": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Nonempty scientific explanation"
                          },
                          "calculation_ids": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "description": "Nonempty scientific explanation"
                            }
                          },
                          "evidence_files": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
                            }
                          },
                          "outcome": {
                            "const": "resolved"
                          }
                        }
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "outcome",
                          "destination_id",
                          "initial_geometry",
                          "final_geometry",
                          "trajectory_evidence",
                          "physical_interpretation"
                        ],
                        "properties": {
                          "outcome": {
                            "const": "collapsed_to_other_basin"
                          },
                          "destination_id": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Nonempty scientific explanation"
                          },
                          "initial_geometry": {
                            "type": "string",
                            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
                          },
                          "final_geometry": {
                            "type": "string",
                            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
                          },
                          "trajectory_evidence": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
                            }
                          },
                          "physical_interpretation": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Nonempty scientific explanation"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "solvent_species_attribution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fixed_species_shift_nm",
              "ensemble_shift_nm",
              "observed_shift_nm",
              "population_table_file",
              "temperature_K",
              "crossobservable_consistency",
              "preferred_support_set",
              "prediction_before_comparison",
              "alternative_falsifier",
              "calculation_ids",
              "evidence_files"
            ],
            "properties": {
              "fixed_species_shift_nm": {
                "type": "number"
              },
              "ensemble_shift_nm": {
                "type": "number"
              },
              "observed_shift_nm": {
                "type": "number"
              },
              "population_table_file": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
              },
              "temperature_K": {
                "const": 298.15
              },
              "crossobservable_consistency": {
                "type": "string",
                "minLength": 1,
                "description": "Nonempty scientific explanation"
              },
              "preferred_support_set": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "7a_ZHK",
                    "7a_EHK",
                    "7a_AE",
                    "7a_AK"
                  ]
                }
              },
              "prediction_before_comparison": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
              },
              "alternative_falsifier": {
                "type": "string",
                "minLength": 1,
                "description": "Nonempty scientific explanation"
              },
              "calculation_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Nonempty scientific explanation"
                }
              },
              "evidence_files": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
                }
              }
            }
          }
        }
      },
      "hypotheses": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "prediction",
            "falsifier",
            "discriminating_panel"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty scientific explanation"
            },
            "prediction": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty scientific explanation"
            },
            "falsifier": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty scientific explanation"
            },
            "discriminating_panel": {
              "type": "string",
              "enum": [
                "matched_absorption",
                "species_crosscheck",
                "solvent_species_attribution"
              ]
            }
          }
        }
      },
      "sensitivity": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "setting",
            "baseline_value",
            "perturbed_value",
            "unit",
            "conclusion_changed",
            "uncertainty_basis",
            "calculation_ids",
            "evidence_files"
          ],
          "properties": {
            "setting": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty scientific explanation"
            },
            "baseline_value": {
              "type": "number"
            },
            "perturbed_value": {
              "type": "number"
            },
            "unit": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty scientific explanation"
            },
            "conclusion_changed": {
              "type": "boolean"
            },
            "uncertainty_basis": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty scientific explanation"
            },
            "calculation_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "description": "Nonempty scientific explanation"
              }
            },
            "evidence_files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
              }
            }
          }
        }
      },
      "failure_report": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempted_scope",
          "observed_failure",
          "missing_endpoints",
          "recovery_condition",
          "evidence_files"
        ],
        "properties": {
          "attempted_scope": {
            "type": "string",
            "minLength": 1,
            "description": "Nonempty scientific explanation"
          },
          "observed_failure": {
            "type": "string",
            "minLength": 1,
            "description": "Nonempty scientific explanation"
          },
          "missing_endpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1,
              "description": "Nonempty scientific explanation"
            }
          },
          "recovery_condition": {
            "type": "string",
            "minLength": 1,
            "description": "Nonempty scientific explanation"
          },
          "evidence_files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?:\\./)*(?:outputs|analysis|structures)/[A-Za-z0-9_.\\-/]+$"
            }
          }
        }
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "complete"
            }
          }
        },
        "then": {
          "required": [
            "results",
            "hypotheses",
            "sensitivity"
          ],
          "properties": {
            "conclusion": {
              "properties": {
                "verdict": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "refuted",
                    "indistinguishable"
                  ]
                }
              }
            },
            "calculation_records": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "completed"
                  },
                  "record_type": {
                    "const": "electronic_structure"
                  }
                },
                "required": [
                  "kind",
                  "record_type"
                ]
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "bounded_failure",
                "blocked"
              ]
            }
          }
        },
        "then": {
          "required": [
            "failure_report"
          ],
          "properties": {
            "conclusion": {
              "properties": {
                "verdict": {
                  "const": "not_established"
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "calculation_records": {
              "maxItems": 0
            }
          }
        },
        "then": {
          "properties": {
            "resources": {
              "properties": {
                "engine_calls": {
                  "const": 0
                }
              }
            }
          }
        }
      }
    ]
  }
}
