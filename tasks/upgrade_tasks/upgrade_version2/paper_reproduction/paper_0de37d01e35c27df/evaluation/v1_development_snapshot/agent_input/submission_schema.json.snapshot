          "uncertainty",
          "uncertainty_basis",
          "calculation_ids",
          "raw_files"
        ],
        "additionalProperties": false
      },
      "conclusion": {
        "type": "object",
        "properties": {
          "outcome": {
            "enum": [
              "supported",
              "refuted",
              "indistinguishable"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "supporting_rows": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "core_matrix_complete": {
            "const": true
          }
        },
        "required": [
          "outcome",
          "statement",
          "supporting_rows",
          "limitations",
          "core_matrix_complete"
        ],
        "additionalProperties": false
      },
      "raw_files": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(?:\\./)?(?:outputs|structures|analysis|logs)/(?!(?:.*\\/)?\\.\\.(?:/|$))[^\\\\\\x00]+$"
        },
        "minItems": 1
      },
      "resources": {
        "type": "object",
        "properties": {
          "engine_starts": {
            "type": "integer",
            "minimum": 0
          },
          "failed_starts": {
            "type": "integer",
            "minimum": 0
          },
          "restart_starts": {
            "type": "integer",
            "minimum": 0
          },
          "allocated_cores": {
            "type": "integer",
            "minimum": 0
          },
          "summed_job_hours": {
            "type": "number",
            "minimum": 0
          },
          "calendar_hours": {
            "type": "number",
            "minimum": 0
          },
          "core_hours": {
            "type": "number",
            "minimum": 0
          },
          "measurement_basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "engine_starts",
          "failed_starts",
          "restart_starts",
          "allocated_cores",
          "summed_job_hours",
          "calendar_hours",
          "core_hours",
          "measurement_basis"
        ],
        "additionalProperties": false
      },
      "failure_report": {
        "type": "object",
        "properties": {
          "observed_failure": {
            "type": "string",
            "minLength": 1
          },
          "attempted_scope": {
            "type": "string",
            "minLength": 1
          },
          "missing_endpoints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "next_required_evidence": {
            "type": "string",
            "minLength": 1
          },
          "raw_files": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:\\./)?(?:outputs|structures|analysis|logs)/(?!(?:.*\\/)?\\.\\.(?:/|$))[^\\\\\\x00]+$"
            },
            "minItems": 1
          }
        },
        "required": [
          "observed_failure",
          "attempted_scope",
          "missing_endpoints",
          "next_required_evidence",
          "raw_files"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "paper_id",
      "status",
      "protocol",
      "object_records",
      "calculation_records",
      "raw_files",
      "resources"
    ],
    "additionalProperties": false,
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "allOf": [
      {
        "if": {
          "properties": {
            "status": {
              "const": "complete"
            }
          }
        },
        "then": {
          "required": [
            "results",
            "hypothesis_tests",
            "sensitivity",
            "conclusion"
          ],
          "properties": {
            "calculation_records": {
              "contains": {
                "properties": {
                  "kind": {
                    "const": "successful"
                  },
                  "role": {
                    "not": {
                      "const": "density_analysis"
                    }
                  }
                },
                "required": [
                  "kind",
                  "role"
                ]
              },
              "minContains": 1,
              "minItems": 1
            },
            "resources": {
              "properties": {
                "allocated_cores": {
                  "minimum": 1
                }
              }
            },
            "object_records": {
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "object_id": {
                        "const": "nor_neutral"
                      }
                    },
                    "required": [
                      "object_id"
                    ]
                  }
                },
                {
                  "contains": {
                    "properties": {
                      "object_id": {
                        "const": "nor_cation"
                      }
                    },
                    "required": [
                      "object_id"
                    ]
                  }
                },
                {
                  "contains": {
                    "properties": {
                      "object_id": {
                        "const": "DTCO_neutral"
                      }
                    },
                    "required": [
                      "object_id"
                    ]
                  }
                },
                {
                  "contains": {
                    "properties": {
                      "object_id": {
                        "const": "DTCO_cation"
                      }
                    },
                    "required": [
                      "object_id"
                    ]
                  }
                }
              ],
              "minItems": 1
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "partial",
                "bounded_failure"
              ]
            }
          }
        },
        "then": {
          "required": [
            "failure_report"
          ]
        }
      }
    ]
  },
  "scientific_boundary": "Contract acceptance is not scientific acceptance. Linked files require evaluator verification, including correct graph, state, raw output, coverage and recomputable quantities. Missing controls cannot be labeled indistinguishable.",
  "development_status": "expanded_reference_verified_phase1"
