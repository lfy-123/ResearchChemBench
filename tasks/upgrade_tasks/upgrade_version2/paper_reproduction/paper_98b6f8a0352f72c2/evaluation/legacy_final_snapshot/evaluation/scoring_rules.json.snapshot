{
  "paper_id": "paper_98b6f8a0352f72c2",
  "rules": [
    {
      "rule_id": "pr_r1",
      "type": "semantic",
      "expected": "System identity, charge, multiplicity, solvent and optimization convergence are explicitly and correctly documented.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.system",
          "$.calculation.geometry_convergence"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "pr_process_1"
    },
    {
      "rule_id": "pr_r2",
      "type": "semantic",
      "expected": "S1 selection and an object-bound independent validation are documented.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.calculation.state_selection",
          "$.validation"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "pr_process_2"
    },
    {
      "rule_id": "pr_r3",
      "type": "numeric",
      "target": 3.65,
      "unit": "eV",
      "tolerance": 0.2,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.result.s1_energy_eV"
        ],
        "comparison": "absolute difference"
      },
      "applicability": {
        "field": "$.status",
        "equals": "complete"
      },
      "reference_id": "pr_result_1"
    },
    {
      "rule_id": "pr_r4",
      "type": "numeric",
      "target": 0.64,
      "unit": "dimensionless",
      "tolerance": 0.1,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.result.s1_oscillator_strength"
        ],
        "comparison": "absolute difference"
      },
      "applicability": {
        "field": "$.status",
        "equals": "complete"
      },
      "reference_id": "pr_result_2"
    },
    {
      "rule_id": "pr_r5",
      "type": "numeric",
      "target": 2.7,
      "unit": "ns",
      "tolerance": 0.6,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.result.radiative_lifetime_ns"
        ],
        "comparison": "absolute difference"
      },
      "applicability": {
        "field": "$.status",
        "equals": "complete"
      },
      "reference_id": "pr_result_3"
    },
    {
      "rule_id": "pr_c1",
      "type": "semantic",
      "expected": "The validated 12a/CHCl3 calculation recovers S1 near 3.65 eV, oscillator strength near 0.64 and a derived radiative lifetime near 2.70 ns.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion.text"
        ],
        "comparison": "expert semantic comparison"
      },
      "applicability": {
        "field": "$.status",
        "equals": "complete"
      },
      "reference_id": "pr_final_1"
    },
    {
      "rule_id": "pr_c2",
      "type": "semantic",
      "expected": "The transition analysis supports charge transfer from the aromatic amine toward the phenazine unit and delocalization over the phenazine framework.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion.transition_character",
          "$.conclusion.text"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "pr_final_2",
      "applicability": {
        "field": "$.status",
        "equals": "complete"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
