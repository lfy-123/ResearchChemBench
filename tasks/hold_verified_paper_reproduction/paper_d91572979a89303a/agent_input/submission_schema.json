{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "oneOf": [
      {
        "required": [
          "status",
          "method",
          "candidates",
          "profiles",
          "conclusion",
          "coverage"
        ],
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      {
        "required": [
          "status",
          "method",
          "attempted_candidates",
          "limiting_missing_result",
          "conclusion",
          "coverage"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "attempted_candidates": {
            "type": "array"
          },
          "limiting_missing_result": {
            "type": "string"
          }
        }
      }
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "bounded_failure"
        ]
      },
      "method": {
        "type": "object",
        "required": [
          "software_or_code",
          "model",
          "thermochemistry"
        ]
      },
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "state_type",
            "connectivity",
            "charge_multiplicity",
            "geometry_provenance",
            "frequency_validation",
            "connectivity_validation",
            "connected_state_ids",
            "status"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "state_type": {
              "type": "string"
            },
            "connectivity": {
              "type": "string"
            },
            "charge_multiplicity": {
              "type": "string"
            },
            "geometry_provenance": {
              "type": "string"
            },
            "frequency_validation": {
              "type": "string"
            },
            "connectivity_validation": {
              "type": "string"
            },
            "connected_state_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "status": {
              "type": "string"
            }
          }
        }
      },
      "profiles": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "pathway_id",
            "catalyst_context",
            "states",
            "barriers"
          ],
          "properties": {
            "pathway_id": {
              "type": "string"
            },
            "catalyst_context": {
              "type": "string"
            },
            "states": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "barriers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "comparison_label",
                  "transition_state_id",
                  "value",
                  "unit",
                  "reference_state",
                  "validation_evidence"
                ],
                "properties": {
                  "comparison_label": {
                    "type": "string"
                  },
                  "transition_state_id": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "reference_state": {
                    "type": "string"
                  },
                  "validation_evidence": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "conclusion": {
        "type": "string"
      },
      "coverage": {
        "type": "string"
      },
      "limitations": {
        "type": "string",
        "description": "Optional commentary; omission or an empty value does not affect scientific or process scores."
      }
    }
  }
}
