{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "oneOf": [
      {
        "required": [
          "status",
          "method",
          "conformers",
          "comparison",
          "conclusion"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "complete",
              "completed",
              "success"
            ]
          },
          "method": {
            "type": "object",
            "required": [
              "level",
              "temperature_K",
              "free_energy_convention",
              "approach_justification",
              "standard_state_correction"
            ]
          },
          "conformers": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "optimization",
                "frequency_validation",
                "free_energy_kcal_mol",
                "validation_evidence"
              ]
            }
          },
          "comparison": {
            "type": "object",
            "required": [
              "reference_id",
              "ordering",
              "relative_energies_kcal_mol"
            ],
            "properties": {
              "ordering": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "conclusion": {
            "type": "object",
            "required": [
              "claim"
            ]
          }
        }
      },
      {
        "required": [
          "status",
          "method",
          "conformers",
          "comparison",
          "conclusion",
          "failure"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "bounded_failure",
              "failed"
            ]
          },
          "method": {
            "type": "object",
            "required": [
              "level",
              "temperature_K",
              "free_energy_convention",
              "approach_justification",
              "standard_state_correction"
            ]
          },
          "conformers": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "optimization",
                "frequency_validation",
                "free_energy_kcal_mol",
                "validation_evidence"
              ]
            }
          },
          "comparison": {
            "type": "object",
            "required": [
              "not_computed_reason"
            ],
            "properties": {
              "ordering": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "conclusion": {
            "type": "object",
            "required": [
              "claim"
            ]
          },
          "failure": {
            "type": "object",
            "required": [
              "failed_ids",
              "attempted_remedies"
            ]
          }
        }
      }
    ]
  }
}
