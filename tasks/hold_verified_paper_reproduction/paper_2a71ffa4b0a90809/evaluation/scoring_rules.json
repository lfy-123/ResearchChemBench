{
  "paper_id": "paper_2a71ffa4b0a90809",
  "rules": [
    {
      "rule_id": "r_input",
      "reference_id": "kp_input",
      "type": "semantic",
      "expected": "Identity and atom mapping match the supplied XYZ.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.system"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "r_profile",
      "reference_id": "kp_profile",
      "type": "condition",
      "expected": "Profile coverage and state validation satisfy the task contract.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.scan_states",
          "$.validation"
        ],
        "comparison": "expert condition check"
      }
    },
    {
      "rule_id": "r_barrier",
      "reference_id": "kp_barrier",
      "type": "numeric",
      "target": 31.0,
      "unit": "kcal/mol",
      "tolerance": 1.0,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.barrier_result.barrier_kcal_mol"
        ],
        "comparison": "absolute difference"
      },
      "applicability": {
        "when": {
          "field": "$.status",
          "equals": "complete"
        },
        "otherwise": "not_applicable_for_bounded_failure"
      }
    },
    {
      "rule_id": "r_limits",
      "reference_id": "kp_limits",
      "type": "semantic",
      "expected": "Assess the actual control and numerical barrier change, not generic caveats.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.sensitivity",
          "$.barrier_result"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "r_final",
      "reference_id": "c_final",
      "type": "semantic",
      "expected": "Evaluate real calculations and scientifically correct results; ordinary disclaimers, search-round counts and generic limitations are not scored. A truthful failure is a valid submission, not achievement of missing scientific results. Credit only actually supported components; extra failed attempts do not invalidate a successful main result. Verify identity, units, energy references and calculation evidence before numerical agreement. States extracted barrier, maximum location and whether the evidence supports rigid/atropisomeric behavior within the computational boundary.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      },
      "applicability": {
        "when": {
          "field": "$.status",
          "equals": "complete"
        },
        "otherwise": "not_applicable_for_bounded_failure"
      }
    }
  ],
  "scoring_policy": "dual_axis_100.scientific_results.v1"
}
