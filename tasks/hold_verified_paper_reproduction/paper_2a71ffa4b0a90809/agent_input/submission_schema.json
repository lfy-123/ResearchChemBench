{
  "required_files": [
    "report/results.json",
    "report/README.md"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "system",
      "scan_states",
      "validation"
    ],
    "oneOf": [
      {
        "properties": {
          "status": {
            "const": "complete"
          },
          "barrier_result": {
            "required": [
              "barrier_kcal_mol",
              "reference_state",
              "maximum_state_id",
              "extraction_method",
              "profile_coverage"
            ]
          },
          "sensitivity": {
            "required": [
              "test_description",
              "result",
              "barrier_change_kcal_mol"
            ]
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          },
          "scan_states": {
            "minItems": 5,
            "contains": {
              "properties": {
                "converged": {
                  "const": true
                }
              },
              "required": [
                "converged",
                "gibbs_relative_kcal_mol"
              ]
            },
            "minContains": 5
          }
        },
        "required": [
          "barrier_result",
          "sensitivity",
          "conclusion"
        ]
      },
      {
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "barrier_result": {
            "type": "object"
          },
          "sensitivity": {
            "type": "object"
          },
          "conclusion": {
            "type": "string",
            "minLength": 1
          },
          "failure_summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "failure_summary",
          "conclusion"
        ]
      }
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "bounded_failure"
        ],
        "minLength": 1
      },
      "system": {
        "type": "object",
        "required": [
          "formula",
          "charge",
          "multiplicity",
          "coordinate_file",
          "solvent_boundary",
          "temperature_K",
          "dihedral_definition",
          "atom_indices"
        ],
        "properties": {
          "formula": {
            "type": "string",
            "minLength": 1
          },
          "charge": {
            "type": "integer"
          },
          "multiplicity": {
            "type": "integer"
          },
          "coordinate_file": {
            "type": "string",
            "minLength": 1
          },
          "solvent_boundary": {
            "type": "string",
            "minLength": 1
          },
          "temperature_K": {
            "type": "number"
          },
          "dihedral_definition": {
            "type": "string",
            "minLength": 1
          },
          "atom_indices": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 4,
            "maxItems": 4
          }
        }
      },
      "scan_states": {
        "type": "array",
        "minItems": 0,
        "items": {
          "type": "object",
          "required": [
            "state_id",
            "dihedral_deg",
            "converged",
            "validation_evidence"
          ],
          "oneOf": [
            {
              "properties": {
                "converged": {
                  "const": true
                },
                "gibbs_relative_kcal_mol": {
                  "type": "number"
                }
              },
              "required": [
                "gibbs_relative_kcal_mol"
              ]
            },
            {
              "properties": {
                "converged": {
                  "const": false
                },
                "failure_reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "failure_reason"
              ]
            }
          ],
          "properties": {
            "state_id": {
              "type": "string",
              "minLength": 1
            },
            "dihedral_deg": {
              "type": "number"
            },
            "gibbs_relative_kcal_mol": {
              "type": "number"
            },
            "converged": {
              "type": "boolean"
            },
            "validation_evidence": {
              "type": "string",
              "minLength": 1
            },
            "failure_reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "uniqueItems": true
      },
      "barrier_result": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "barrier_kcal_mol",
              "reference_state",
              "maximum_state_id",
              "extraction_method",
              "profile_coverage"
            ],
            "properties": {
              "barrier_kcal_mol": {
                "type": "number"
              },
              "reference_state": {
                "type": "string",
                "minLength": 1
              },
              "maximum_state_id": {
                "type": "string",
                "minLength": 1
              },
              "extraction_method": {
                "type": "string",
                "minLength": 1
              },
              "profile_coverage": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "required": [
              "barrier_status",
              "profile_coverage",
              "failure_reason"
            ],
            "properties": {
              "barrier_status": {
                "type": "string",
                "minLength": 1
              },
              "profile_coverage": {
                "type": "string",
                "minLength": 1
              },
              "limitation": {
                "type": "string",
                "minLength": 1
              },
              "failure_reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      },
      "validation": {
        "type": "object",
        "required": [
          "optimization_convergence",
          "connectivity_preserved",
          "profile_continuity",
          "frequency_or_stationarity_check"
        ],
        "properties": {
          "optimization_convergence": {
            "type": "string",
            "minLength": 1
          },
          "connectivity_preserved": {
            "type": "string",
            "minLength": 1
          },
          "profile_continuity": {
            "type": "string",
            "minLength": 1
          },
          "frequency_or_stationarity_check": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "string"
          }
        }
      },
      "sensitivity": {
        "anyOf": [
          {
            "type": "object",
            "required": [
              "test_description",
              "result",
              "barrier_change_kcal_mol"
            ],
            "properties": {
              "test_description": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "minLength": 1
              },
              "barrier_change_kcal_mol": {
                "type": "number"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "test_description",
              "result"
            ],
            "properties": {
              "test_description": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "minLength": 1
              },
              "barrier_change_kcal_mol": {
                "type": "number"
              }
            }
          }
        ]
      },
      "conclusion": {
        "type": "string",
        "minLength": 1
      },
      "limitations": {
        "type": "string"
      }
    },
    "$schema": "https://json-schema.org/draft/2020-12/schema"
  }
}
