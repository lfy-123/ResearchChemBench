{
  "paper_id": "paper_aee0b405e92e6966",
  "rules": [
    {
      "rule_id": "r_ar_kp_minima",
      "type": "condition",
      "expected": "Both named states have explicit minimum validation evidence or a concrete bounded failure.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.states[0].minimum_status",
          "$.states[0].validation_evidence",
          "$.states[1].minimum_status",
          "$.states[1].validation_evidence"
        ],
        "comparison": "expert condition check"
      },
      "reference_id": "kp_ar_process_minima"
    },
    {
      "rule_id": "r_ar_kp_coverage",
      "type": "condition",
      "expected": "The method record states conformer/search coverage or a justified two-state limitation.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.method_record.environment",
          "$.method_record.convergence",
          "$.coverage"
        ],
        "comparison": "expert condition check"
      },
      "reference_id": "kp_ar_process_coverage"
    },
    {
      "rule_id": "r_ar_order",
      "type": "semantic",
      "expected": "The conclusion identifies A-NH_O as lower.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion",
          "$.explanation"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "kp_ar_result_order"
    },
    {
      "rule_id": "r_ar_energy",
      "type": "numeric",
      "target": 5.3,
      "unit": "kcal/mol",
      "tolerance": 1.0,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparison.relative_energy"
        ],
        "comparison": "absolute difference"
      },
      "reference_id": "kp_ar_result_magnitude"
    },
    {
      "rule_id": "r_ar_final",
      "type": "semantic",
      "expected": "Independent validated computation supports A-NH_O lower, with method-dependent uncertainty disclosed.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion",
          "$.explanation"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "c_ar_final"
    },
    {
      "rule_id": "r_ar_limit",
      "type": "semantic",
      "expected": "The conclusion is limited to the two-state computation and does not overclaim experiments.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion",
          "$.limitations"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "c_ar_limit"
    }
  ]
}
