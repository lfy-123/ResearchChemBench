{
  "paper_id": "paper_d2d08c91f34da1cb",
  "rules": [
    {
      "rule_id": "ar_r1",
      "type": "condition",
      "expected": "An independent reproducible route and both state attempts are documented.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.route",
          "$.states"
        ],
        "comparison": "expert check"
      },
      "reference_id": "ar_process_independent_route"
    },
    {
      "rule_id": "ar_r2",
      "type": "condition",
      "expected": "Imaginary modes, window, matching and coverage are explicit.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.states",
          "$.comparison"
        ],
        "comparison": "expert check"
      },
      "reference_id": "ar_process_auditable_validation"
    },
    {
      "rule_id": "ar_r3",
      "type": "semantic",
      "expected": "The report supplies MAE and maximum absolute deviation for observed pairs when available, and gives a calibrated agreement/uncertainty interpretation for the independently chosen model; the source-reported below-3 cm^-1 result is contextual evidence, not a universal pass threshold.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparison.metrics",
          "$.comparison.coverage",
          "$.limitations"
        ],
        "comparison": "expert scientific comparison"
      },
      "reference_id": "ar_result_agreement"
    },
    {
      "rule_id": "ar_r4",
      "type": "semantic",
      "expected": "Structural interpretation is tied to displacement evidence and treats mixed-mode assignments as tentative.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion",
          "$.limitations"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "ar_result_physical_interpretation"
    },
    {
      "rule_id": "ar_c1",
      "type": "semantic",
      "expected": "An independently reasoned conclusion evaluates agreement and uncertainty without claiming more than the fixed frequency task supports.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion",
          "$.limitations"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "ar_final_validation"
    }
  ]
}
