{
  "rules": [
    {
      "rule_id": "ar_r1",
      "type": "condition",
      "expected": "minimum validation is documented and imaginary-mode outcome is reported",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation.minimum_test",
          "$.validation.imaginary_modes"
        ],
        "comparison": "expert condition comparison"
      },
      "reference_id": "ar_process_minimum"
    },
    {
      "rule_id": "ar_r2",
      "type": "condition",
      "expected": "five individually indexed torsions and a stated convention are present",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.torsions"
        ],
        "comparison": "expert structural audit"
      },
      "reference_id": "ar_process_torsion_trace"
    },
    {
      "rule_id": "ar_r3",
      "type": "numeric",
      "target": 27.1,
      "unit": "degree",
      "tolerance": 2.0,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.mean_torsion_deg"
        ],
        "comparison": "absolute difference",
        "applicability": {"field": "$.status", "equals": "complete"}
      },
      "reference_id": "ar_result_mean"
    },
    {
      "rule_id": "ar_r4",
      "type": "semantic",
      "expected": "validated independent calculation supports a bounded isolated-molecule conclusion",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
      "fields": ["$.interpretation", "$.limitations"],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "ar_final",
      "applicability": {"field": "$.status", "equals": "complete"}
    },
    {
      "rule_id": "au_extra_cope",
      "reference_id": "ar_result_scope",
      "type": "semantic",
      "expected": "model, conformer, gas-phase and torsion-convention limitations are stated",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": ["$.limitations", "$.interpretation"],
        "comparison": "expert condition comparison"
      },
      "applicability": {"field": "$.status", "equals": "complete"}
    }
  ],
  "paper_id": "paper_746e066c163800d8"
}
