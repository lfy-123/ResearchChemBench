  "rules": [
    {
      "rule_id": "ar_r1",
      "reference_id": "ar_process_minimum",
      "type": "condition",
      "expected": "No imaginary frequencies are documented and the reported system is neutral singlet, or bounded failure is transparently documented.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.success.minimum_validation",
          "$.failure"
        ],
        "comparison": "expert validation of submitted frequency evidence"
      }
    },
    {
      "rule_id": "ar_r2",
      "reference_id": "ar_process_consistency",
      "type": "semantic",
