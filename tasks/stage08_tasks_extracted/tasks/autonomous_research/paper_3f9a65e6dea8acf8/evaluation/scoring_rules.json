      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.success.formula_check"
        ],
        "comparison": "expert consistency check"
      }
    },
    {
      "rule_id": "ar_r3",
      "reference_id": "ar_result_gap",
      "type": "numeric",
