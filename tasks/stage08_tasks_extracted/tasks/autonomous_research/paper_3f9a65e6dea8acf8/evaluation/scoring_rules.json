      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.success.gap_eV"
        ],
        "comparison": "absolute difference"
      }
    },
    {
      "rule_id": "ar_r4",
      "reference_id": "ar_result_descriptors",
      "type": "semantic",
