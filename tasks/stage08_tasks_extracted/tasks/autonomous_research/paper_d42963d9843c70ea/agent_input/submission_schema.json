{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "hypotheses",
      "method",
      "states",
      "comparison",
      "conclusion",
      "limitations"
    ],
    "properties": {
      "hypotheses": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "method": {
        "type": "string"
      },
      "states": {
        "type": "array",
        "minItems": 3,
        "items": {
          "type": "object",
          "required": [
            "id",
            "outcome",
            "structure",
            "validation",
            "convergence_evidence",
            "electronic_sampling",
            "extrema_or_crossing",
            "gap_result",
            "orbital_evidence"
          ],
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "unstrained",
                "compressive_2pct",
                "tensile_2pct"
              ]
            },
            "outcome": {
              "type": "string",
              "enum": [
                "completed",
                "bounded_failure"
              ]
            },
            "structure": {
              "type": "string"
            },
            "validation": {
              "type": "string"
            },
            "convergence_evidence": {
              "type": "string"
            },
            "electronic_sampling": {
              "type": "string"
            },
            "extrema_or_crossing": {
              "type": "string"
            },
            "gap_result": {
              "type": "object",
              "required": [
                "classification",
                "gap_value"
              ],
              "properties": {
                "classification": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "gap_value": {
                  "type": [
                    "number",
                    "null"
                  ]
                }
              }
            },
            "orbital_evidence": {
              "type": "string"
            }
          }
        }
      },
      "comparison": {
        "type": "string"
      },
      "conclusion": {
        "type": "string"
      },
      "limitations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    }
  }
}
