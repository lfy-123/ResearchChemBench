{
    "paper_id": "paper_0543918936df2fba",
    "rules": [
        {
            "rule_id": "r_ar_process_search",
            "applies_when": "status is complete",
            "reference_id": "ar_process_search",
            "type": "semantic",
            "expected": "Independent per-surface candidate inventories, validation, deduplication and stopping are reported.",
            "binding": {
                "artifact_paths": [
                    "report/results.json"
                ],
                "fields": [
                    "$.surfaces",
                    "$.ni111_coverage_and_stopping",
                    "$.nipt111_coverage_and_stopping"
                ],
                "comparison": "expert semantic comparison"
            }
        },
        {
            "rule_id": "r_ar_process_path",
            "applies_when": "status is complete",
            "reference_id": "ar_process_path",
            "type": "semantic",
            "expected": "Both per-surface paths and convergence sensitivity are validated.",
            "binding": {
                "artifact_paths": [
                    "report/results.json"
                ],
                "fields": [
                    "$.surfaces",
                    "$.ni111_path_validation",
                    "$.nipt111_path_validation",
                    "$.convergence_test"
                ],
                "comparison": "expert semantic comparison"
            }
        },
        {
            "rule_id": "r_ar_h2_ni",
            "applies_when": "status is complete",
            "reference_id": "ar_h2_ni",
            "type": "numeric",
            "target": -0.38,
            "unit": "eV",
            "tolerance": 0.15,
            "binding": {
                "artifact_paths": [
                    "report/results.json"
                ],
                "fields": [
                    "$.ni111_h2_adsorption_energy_ev"
                ],
                "comparison": "absolute difference"
            }
        },
        {
            "rule_id": "r_ar_h2_nipt",
            "applies_when": "status is complete",
            "reference_id": "ar_h2_nipt",
            "type": "numeric",
            "target": -0.23,
            "unit": "eV",
            "tolerance": 0.15,
            "binding": {
                "artifact_paths": [
                    "report/results.json"
                ],
                "fields": [
                    "$.nipt111_h2_adsorption_energy_ev"
                ],
                "comparison": "absolute difference"
            }
        },
        {
            "rule_id": "r_ar_barrier_ni",
            "applies_when": "status is complete",
            "reference_id": "ar_barrier_ni",
            "type": "numeric",
            "target": 0.55,
            "unit": "eV",
            "tolerance": 0.15,
            "binding": {
                "artifact_paths": [
                    "report/results.json"
                ],
                "fields": [
                    "$.ni111_parallel_to_tilted_barrier_ev"
                ],
                "comparison": "absolute difference"
            }
        },
        {
            "rule_id": "r_ar_barrier_nipt",
            "applies_when": "status is complete",
            "reference_id": "ar_barrier_nipt",
            "type": "numeric",
            "target": 0.34,
            "unit": "eV",
            "tolerance": 0.15,
            "binding": {
                "artifact_paths": [
                    "report/results.json"
                ],
                "fields": [
                    "$.nipt111_parallel_to_tilted_barrier_ev"
                ],
                "comparison": "absolute difference"
            }
        },
        {
            "rule_id": "r_ar_ordering",
            "applies_when": "status is complete",
            "reference_id": "ar_ordering",
            "type": "condition",
            "expected": "tilted-minus-parallel energy is positive on both surfaces",
            "binding": {
                "artifact_paths": [
                    "report/results.json"
                ],
                "fields": [
                    "$.ni111_tilted_minus_parallel_energy_ev",
                    "$.nipt111_tilted_minus_parallel_energy_ev"
                ],
                "comparison": "sign and expert verification"
            }
        },
        {
            "rule_id": "r_ar_final_effect",
            "applies_when": "status is complete",
            "reference_id": "ar_final_effect",
            "type": "semantic",
            "expected": "The independent comparison concludes weaker H2 binding and lower HMF reorientation barrier after Pt substitution within model scope.",
            "binding": {
                "artifact_paths": [
                    "report/results.json"
                ],
                "fields": [
                    "$.comparative_conclusion"
                ],
                "comparison": "expert semantic comparison"
            }
        },
        {
            "rule_id": "r_ar_limitations",
            "applies_when": "status is complete or bounded_failure",
            "reference_id": "ar_limitations",
            "type": "semantic",
            "expected": "Limitations distinguish ideal-slab electronic energies from supported-catalyst kinetics and selectivity.",
            "binding": {
                "artifact_paths": [
                    "report/results.json"
                ],
                "fields": [
                    "$.limitations"
                ],
                "comparison": "expert semantic comparison"
            }
        }
    ]
}
