{
  "required_files": ["report/results.json"],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "properties": {
      "status": {"type":"string"},
      "provenance": {"type":"object"},
      "geometry_validation": {"type":"object","required":["optimization_converged","minimum_check","imaginary_frequency_count","notes"],"properties":{"optimization_converged":{"type":"boolean"},"minimum_check":{"type":"string"},"imaginary_frequency_count":{"type":"integer","minimum":0},"notes":{"type":"string"}}},
      "transitions": {"type":"array","minItems":2,"items":{"type":"object","required":["state","label","wavelength_nm","oscillator_strength","dominant_transition","contribution_percent","validation_notes"],"properties":{"state":{"type":"string","enum":["S1","S2"]},"label":{"type":"string"},"wavelength_nm":{"type":"number"},"oscillator_strength":{"type":"number"},"dominant_transition":{"type":"string"},"contribution_percent":{"type":"number"},"validation_notes":{"type":"string"}}}},
      "attempted_calculations":{"type":"array","minItems":1,"items":{"type":"string"}}, "conclusion":{"type":"string"}, "limitations":{"type":"string"}, "failure_reason":{"type":"string"}
    },
    "oneOf": [
      {
        "type": "object",
        "required": ["status", "provenance", "geometry_validation", "transitions", "conclusion", "limitations"],
        "properties": {
          "status": {"const": "success"},
          "provenance": {"$ref": "#/$defs/provenance"},
          "geometry_validation": {"$ref": "#/$defs/geometry_validation"},
          "transitions": {"$ref": "#/$defs/transitions"},
          "conclusion": {"type": "string"},
          "limitations": {"type": "string"}
        }
      },
      {
        "type": "object",
        "required": ["status", "provenance", "geometry_validation", "attempted_calculations", "conclusion", "limitations", "failure_reason"],
        "properties": {
          "status": {"const": "bounded_failure"},
          "provenance": {"$ref": "#/$defs/provenance"},
          "geometry_validation": {"$ref": "#/$defs/geometry_validation"},
          "attempted_calculations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "conclusion": {"type": "string"},
          "limitations": {"type": "string"},
          "failure_reason": {"type": "string"}
        }
      }
    ],
    "$defs": {
      "provenance": {
        "type": "object",
        "required": ["input_file", "charge", "multiplicity", "software", "method", "basis", "solvent", "settings"],
        "properties": {
          "input_file": {"type": "string"}, "charge": {"type": "integer"}, "multiplicity": {"type": "integer"},
          "software": {"type": "string"}, "method": {"type": "string"}, "basis": {"type": "string"},
          "solvent": {"type": "string"}, "settings": {"type": "object"}
        }
      },
      "geometry_validation": {
        "type": "object",
        "required": ["optimization_converged", "minimum_check", "imaginary_frequency_count", "notes"],
        "properties": {
          "optimization_converged": {"type": "boolean"}, "minimum_check": {"type": "string"},
          "imaginary_frequency_count": {"type": "integer", "minimum": 0}, "notes": {"type": "string"}
        }
      },
      "transitions": {
        "type": "array", "minItems": 2,
        "items": {
          "type": "object",
          "required": ["state", "label", "wavelength_nm", "oscillator_strength", "dominant_transition", "contribution_percent", "validation_notes"],
          "properties": {
            "state": {"type": "string", "enum": ["S1", "S2"]}, "label": {"type": "string"},
            "wavelength_nm": {"type": "number"}, "oscillator_strength": {"type": "number"},
            "dominant_transition": {"type": "string"}, "contribution_percent": {"type": "number"},
            "validation_notes": {"type": "string"}
          }
        }
      }
    }
  }
}
