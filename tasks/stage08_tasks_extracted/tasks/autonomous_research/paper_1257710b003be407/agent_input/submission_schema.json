{
  "type": "object",
  "required": ["required_files", "primary_result_file", "result_schema"],
  "properties": {
    "required_files": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "primary_result_file": {"type": "string"}
  },
  "required_files": ["report/results.json"],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": ["status", "hypotheses", "candidates", "selected", "coverage_stopping", "conclusion", "limitations"],
    "properties": {
      "status": {"type": "string", "enum": ["validated_success", "partial_discovery", "bounded_failure"]},
      "hypotheses": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["hypothesis_id", "description", "discrimination_test"], "properties": {"hypothesis_id": {"type": "string"}, "description": {"type": "string"}, "discrimination_test": {"type": "string"}}}},
      "candidates": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["candidate_id", "hypothesis_id", "reactant_structure", "frequency_validation", "connectivity_validation", "validation_status"], "properties": {"candidate_id": {"type": "string"}, "hypothesis_id": {"type": "string"}, "reactant_structure": {"type": "string"}, "ts_structure": {"type": "string"}, "frequency_validation": {"type": "object", "required": ["reactant_imaginary_count", "ts_imaginary_count", "mode_description"], "properties": {"reactant_imaginary_count": {"type": "integer"}, "ts_imaginary_count": {"type": "integer"}, "mode_description": {"type": "string"}}}, "connectivity_validation": {"type": "object", "required": ["method", "result"], "properties": {"method": {"type": "string"}, "result": {"type": "string"}}}, "validation_status": {"type": "string", "enum": ["validated", "failed"]}, "deltaG_activation_kcal_mol": {"type": "number"}, "failure_reason": {"type": "string"}}}},
      "selected": {"oneOf": [{"type": "object", "required": ["candidate_id", "deltaG_activation_kcal_mol", "validation_summary"], "properties": {"candidate_id": {"type": "string"}, "deltaG_activation_kcal_mol": {"type": "number"}, "validation_summary": {"type": "string"}}}, {"type": "object", "required": ["candidate_id", "validation_summary", "failure_reason"], "properties": {"candidate_id": {"type": "string"}, "validation_summary": {"type": "string"}, "failure_reason": {"type": "string"}}}]},
      "coverage_stopping": {"type": "string"},
      "conclusion": {"type": "string"},
      "limitations": {"type": "string"}
    }
  }
}
