          "pressure_atm": {
            "type": "number"
          }
        }
      },
      "system": {
        "type": "object",
        "required": [
          "charge",
          "multiplicity",
          "force_site_indices"
        ],
        "properties": {
          "charge": {
            "type": "integer"
          },
          "multiplicity": {
            "type": "integer"
          },
          "force_site_indices": {
            "type": "array",
