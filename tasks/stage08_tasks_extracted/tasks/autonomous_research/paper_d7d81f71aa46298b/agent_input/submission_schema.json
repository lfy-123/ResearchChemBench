        ],
        "properties": {
          "force_HAT_barrier_kJ_mol": {
            "type": [
              "number",
              "null"
            ]
          },
          "thermal_barrier_kJ_mol": {
            "type": [
              "number",
              "null"
            ]
          },
          "statement": {
            "type": "string"
          }
        }
      },
      "limitations": {
        "type": "string"
      },
      "hypotheses": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "hypothesis_id",
            "description",
            "candidates"
          ],
          "properties": {
            "hypothesis_id": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "candidate_id",
                  "regime",
                  "reactant",
                  "product",
                  "charge",
                  "multiplicity",
                  "validation",
                  "barrier_kJ_mol"
                ],
                "properties": {
                  "candidate_id": {
                    "type": "string"
                  },
                  "regime": {
                    "type": "string"
                  },
                  "reactant": {
                    "type": "string"
                  },
                  "product": {
                    "type": "string"
                  },
                  "validation": {
                    "type": "object",
                    "required": [
                      "imaginary_frequency_count",
                      "connectivity_test"
                    ],
                    "properties": {
                      "imaginary_frequency_count": {
                        "type": "integer"
                      },
                      "connectivity_test": {
                        "type": "string"
                      }
                    }
                  },
                  "barrier_kJ_mol": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "charge": {
                    "type": "integer"
                  },
                  "multiplicity": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
