      "selected_results": {
        "type": "object",
        "required": [
          "force_barrier_kJ_mol",
          "thermal_barrier_kJ_mol",
          "comparison"
        ],
        "properties": {
          "force_barrier_kJ_mol": {
            "type": [
              "number",
              "null"
            ]
          },
          "thermal_barrier_kJ_mol": {
            "type": [
              "number",
              "null"
            ]
          },
          "comparison": {
            "type": "string"
          }
        }
      },
      "coverage": {
        "type": "string"
      }
    }
  }
}
