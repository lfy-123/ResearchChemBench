{"paper_id":"paper_5d94285cfbd51973","rules":[{"rule_id":"ar_r_process","reference_id":"ar_process","type":"semantic","expected":"candidate-specific conformer identities, advancement evidence, and minimum validation are present","binding":{"artifact_paths":["report/results.json"],"fields":["$.conformer_search.candidates","$.stationarity.evidence"],"comparison":"expert semantic comparison"}},{"rule_id":"ar_r_method","reference_id":"ar_method","type":"semantic","expected":"software, electronic-structure method, representation, gas-phase boundary, and scientific justification are independently reported","binding":{"artifact_paths":["report/results.json"],"fields":["$.method.software","$.method.electronic_structure_method","$.method.basis_or_representation","$.method.phase","$.method.justification"],"comparison":"expert semantic comparison"}},{"rule_id":"ar_r_search","reference_id":"ar_search","type":"semantic","expected":"search counts, candidate-specific records, energy span, stopping evidence, and coverage rationale are reported","binding":{"artifact_paths":["report/results.json"],"fields":["$.conformer_search.generated_count","$.conformer_search.deduplicated_count","$.conformer_search.advanced_count","$.conformer_search.frequency_validated_count","$.conformer_search.energy_span_kcal_mol","$.conformer_search.stopping_evidence","$.conformer_search.coverage_rationale"],"comparison":"expert semantic comparison"}},{"rule_id":"ar_r_structure","reference_id":"ar_structure","type":"semantic","expected":"selected XYZ structure and selection basis are supplied and tied to stationarity evidence","binding":{"artifact_paths":["report/results.json"],"fields":["$.selected_structure.xyz","$.selected_structure.selection_basis","$.stationarity.imaginary_frequency_count","$.stationarity.evidence"],"comparison":"expert semantic comparison"}},{"rule_id":"ar_r_sensitivity","reference_id":"ar_sensitivity","type":"semantic","expected":"a motivated sensitivity test reports HOMO, LUMO, gap, 