{
  "rules": [
    {
      "rule_id": "r_ar_kp_identity",
      "type": "semantic",
      "expected": "The supplied molecular identity, states and sulfur pair are verified.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.states"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "kp_ar_process_identity"
    },
    {
      "rule_id": "r_ar_kp_validation",
      "type": "semantic",
      "expected": "Each selected structure has diagnostics or a truthful bounded-failure explanation.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.states[*].validation",
          "$.validation"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "kp_ar_process_validation"
    },
    {
      "rule_id": "r_ar_kp_change",
      "type": "numeric",
      "expected": "The oxidation-induced distance change is quantitatively reported and provenance-bound.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.states[*].sulfur_distance_angstrom",
          "$.distance_change.value_angstrom"
        ],
        "comparison": "absolute difference"
      },
      "reference_id": "kp_ar_result_change",
      "target": 0.073,
      "unit": "angstrom",
      "tolerance": 0.2
    },
    {
      "rule_id": "r_ar_con_final",
      "type": "semantic",
      "expected": "The conclusion states contraction/expansion and carefully bounds the structural inference.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "con_ar_final"
    },
    {
      "rule_id": "r_ar_con_limit",
      "type": "semantic",
      "expected": "Limitations of method, conformers, spin and isolated-molecule boundary are stated.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.limitations"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "con_ar_limit"
    }
  ],
  "paper_id": "paper_0de37d01e35c27df"
}