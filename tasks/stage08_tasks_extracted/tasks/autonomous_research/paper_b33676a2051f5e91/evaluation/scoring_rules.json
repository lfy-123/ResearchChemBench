{"paper_id":"paper_b33676a2051f5e91","rules":[{"rule_id":"ar_r1","reference_id":"ar_process_search","type":"condition","expected":"Candidate hypotheses, atom mapping, coverage and stopping are reported.","binding":{"artifact_paths":["report/results.json"],"fields":["$.search"],"comparison":"expert comparison"}},{"rule_id":"ar_r2","reference_id":"ar_process_validation","type":"condition","expected":"Each advanced channel includes frequency and connection validation.","binding":{"artifact_paths":["report/results.json"],"fields":["$.channels[].frequency_validation","$.channels[].connection_validation"],"comparison":"candidate-level expert comparison","applies_when":{"field":"$.status","equals":"validated_result"}}},{"rule_id":"ar_r3","reference_id":"ar_result_channel","type":"semantic","expected":"Selected channel is explicitly identified with atom-balanced products and comparative rationale.","binding":{"artifact_paths":["report/results.json"],"fields":["$.conclusion.selected_channel","$.conclusion.rationale","$.channels[].channel_id","$.channels[].products","$.channels[].atom_mapping"],"comparison":"candidate-level expert semantic comparison","applies_when":{"field":"$.status","equals":"validated_result"}}},{"rule_id":"ar_r4","reference_id":"ar_result_barrier","type":"numeric","target":9.07,"unit":"kcal/mol","tolerance":2.0,"binding":{"artifact_paths":["report/results.json"],"fields":["$.conclusion.barrier_kcal_mol"],"comparison":"absolute difference when a validated acetophenone channel is selected","applies_when":{"field":"$.status","equals":"validated_result"}}},{"rule_id":"ar_r5","reference_id":"ar_final","type":"semantic","expected":"Validated conclusion is bounded by search and validation scope; bounded failure reports attempted candidates and limitations.","binding":{"artifact_paths":["report/results.json"],"fields":["$.conclusion","$.failure"],"comparison":"outcome-branch expert semantic comparison"}}]}
