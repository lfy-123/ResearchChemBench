{
    "required_files": [
        "report/results.json",
        "report/methods.md"
    ],
    "primary_result_file": "report/results.json",
    "result_schema": {
        "type": "object",
        "required": [
            "status"
        ],
        "properties": {
            "status": {
                "type": "string",
                "enum": [
                    "complete",
                    "bounded_failure"
                ]
            },
            "selected_conformer": {
                "type": "object",
                "required": [
                    "id",
                    "generation_count",
                    "deduplication",
                    "optimization",
                    "stability"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "generation_count": {
                        "type": "integer",
                        "minimum": 1
                    },
                    "deduplication": {
                        "type": "string"
                    },
                    "optimization": {
                        "type": "string"
                    },
                    "stability": {
                        "type": "string"
                    }
                }
            },
            "conformer_evaluations": {
                "type": "array",
                "minItems": 1,
                "items": {
                    "type": "object",
                    "required": [
                        "id",
                        "relative_energy",
                        "energy_unit",
                        "optimization",
                        "stability"
                    ],
                    "properties": {
                        "id": {"type": "string"},
                        "relative_energy": {"type": "number"},
                        "energy_unit": {"type": "string"},
                        "optimization": {"type": "string"},
                        "stability": {"type": "string"}
                    }
                }
            },
            "states": {
                "type": "array",
                "minItems": 5,
                "items": {
                    "type": "object",
                    "required": [
                        "state",
                        "energy_eV",
                        "wavelength_nm",
                        "oscillator_strength",
                        "configuration"
                    ],
                    "properties": {
                        "state": {
                            "type": "integer"
                        },
                        "energy_eV": {
                            "type": "number"
                        },
                        "wavelength_nm": {
                            "type": "number"
                        },
                        "oscillator_strength": {
                            "type": "number"
                        },
                        "configuration": {
                            "type": "string"
                        }
                    }
                }
            },
            "ground_state_gap_eV": {
                "type": "number"
            },
            "sensitivity_check": {
                "type": "object",
                "required": [
                    "method",
                    "result"
                ],
                "properties": {
                    "method": {
                        "type": "string"
                    },
                    "result": {
                        "type": "string"
                    }
                }
            },
            "interpretation": {
                "type": "string"
            },
            "limitations": {
                "type": "string"
            },
            "failure": {
                "type": "object",
                "required": [
                    "failed_observable",
                    "reason",
                    "completed_work"
                ],
                "properties": {
                    "failed_observable": {
                        "type": "string"
                    },
                    "reason": {
                        "type": "string"
                    },
                    "completed_work": {
                        "type": "string"
                    }
                }
            }
        },
        "oneOf": [
            {
                "properties": {
                    "status": {
                        "const": "complete"
                    }
                },
                "required": [
                    "status",
                    "selected_conformer",
                    "conformer_evaluations",
                    "states",
                    "ground_state_gap_eV",
                    "sensitivity_check",
                    "interpretation",
                    "limitations"
                ]
            },
            {
                "properties": {
                    "status": {
                        "const": "bounded_failure"
                    }
                },
                "required": [
                    "status",
                    "failure",
                    "limitations"
                ]
            }
        ]
    }
}
