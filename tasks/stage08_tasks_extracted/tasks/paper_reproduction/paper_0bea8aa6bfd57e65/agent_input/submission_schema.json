          "protocol": {"type": "object", "required": ["software", "model_chemistry", "counterpoise_definition", "charge_multiplicity"], "properties": {"software": {"type": "string"}, "model_chemistry": {"type": "string"}, "counterpoise_definition": {"type": "string"}, "charge_multiplicity": {"type": "string"}}},
          "coverage": {"type": "object", "required": ["generation", "stopping_rule", "limitation"], "properties": {"generation": {"type": "string"}, "stopping_rule": {"type": "string"}, "limitation": {"type": "string"}}},
          "conclusion": {"type": "object", "required": ["ordering", "interpretation", "hypothesis_test"], "properties": {"ordering": {"type": "array", "items": {"type": "string"}}, "interpretation": {"type": "string"}, "hypothesis_test": {"type": "string"}}},
          "limitations": {"type": "string"}, "bounded_failure": {"type": "string"}
        }
      }
