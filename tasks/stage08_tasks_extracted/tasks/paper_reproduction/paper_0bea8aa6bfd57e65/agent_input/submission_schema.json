          "conclusion": {"type": "object", "required": ["ordering", "interpretation", "hypothesis_test"], "properties": {"ordering": {"type": "array", "items": {"type": "string"}}, "interpretation": {"type": "string"}, "hypothesis_test": {"type": "string"}}},
          "limitations": {"type": "string"}
