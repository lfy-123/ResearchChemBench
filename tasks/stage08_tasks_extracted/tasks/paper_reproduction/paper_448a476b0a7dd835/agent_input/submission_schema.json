{
  "required_files":["report/results.json","report/validation.json"],
  "primary_result_file":"report/results.json",
  "result_schema":{
    "type":"object",
    "oneOf":[
      {
        "properties":{"status":{"const":"complete"}},
        "required":["status","selected_candidate","interaction_enthalpy","thermochemistry","geometry","conclusion"]
      },
      {
        "properties":{"status":{"const":"bounded_failure"}},
        "required":["status","conclusion"]
      }
    ],
    "properties":{
      "status":{"type":"string","enum":["complete","bounded_failure"]},
      "selected_candidate":{"type":"object","required":["id","coordinates_file"],"properties":{"id":{"type":"string"},"coordinates_file":{"type":"string"}}},
      "interaction_enthalpy":{"type":"object","required":["value","unit","energy_definition"],"properties":{"value":{"type":"number"},"unit":{"type":"string"},"energy_definition":{"type":"string"}}},
      "thermochemistry":{"type":"object","required":["pair","IIPO_monomer","oIPP_monomer","units"],"properties":{"pair":{"type":"number"},"IIPO_monomer":{"type":"number"},"oIPP_monomer":{"type":"number"},"units":{"type":"string"}}},
      "geometry":{"type":"object","required":["cap_carbon_distance_angstrom","planarity_metric","minimum_validation"],"properties":{"cap_carbon_distance_angstrom":{"type":"number"},"planarity_metric":{"type":"number"},"minimum_validation":{"type":"string"}}},
      "conclusion":{"type":"string"}
    }
  },
  "validation_schema":{
    "type":"object",
    "required":["search","candidates","stopping","minimum_validation","energy_bookkeeping","convergence","provenance"],
    "properties":{
      "search":{"type":"object"},
      "candidates":{"type":"array","items":{"type":"object","required":["id","identity","advancement_status"],"properties":{"id":{"type":"string"},"identity":{"type":"string"},"advancement_status":{"type":"string"}}}},
      "stopping":{"type":"object"},
      "minimum_validation":{"type":"object"},
      "energy_bookkeeping":{"type":"object"},
      "convergence":{"type":"object"},
      "provenance":{"type":"object"}
    }
  }
}
