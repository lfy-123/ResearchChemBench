{
  "type": "object",
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "method",
      "candidates",
      "validation",
      "mechanism_conclusion",
      "limitations"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "bounded_failure"
        ]
      },
      "method": {
        "type": "object",
        "required": [
          "electronic_structure",
          "solvent",
          "temperature_K",
          "charge",
          "multiplicity"
        ],
        "properties": {
          "electronic_structure": {
            "type": "string"
          },
          "solvent": {
            "type": "string"
          },
          "temperature_K": {
            "type": "number"
          },
          "charge": {
            "type": "integer"
          },
          "multiplicity": {
            "type": "integer"
          }
        }
      },
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "candidate_id",
            "role",
            "geometry_or_source",
            "frequency_summary",
            "disposition"
          ],
          "properties": {
            "candidate_id": {
              "type": "string"
            },
            "role": {
              "type": "string"
            },
            "geometry_or_source": {
              "type": "string"
            },
            "frequency_summary": {
              "type": "string"
            },
            "disposition": {
              "type": "string"
            }
          }
        }
      },
      "validation": {
        "type": "object",
        "required": [
          "reactant_minimum",
          "transition_state",
          "connectivity_test"
        ],
        "properties": {
          "reactant_minimum": {
            "type": "string"
          },
          "transition_state": {
            "type": "string"
          },
          "connectivity_test": {
            "type": "string"
          }
        }
      },
      "barrier_kcal_mol": {
        "type": "number"
      },
      "mechanism_conclusion": {
        "type": "string"
      },
      "limitations": {
        "type": "string"
      },
      "failure_reason": {
        "type": "string"
      }
    },
    "oneOf": [
      {
        "required": [
          "status",
          "barrier_kcal_mol"
        ],
        "properties": {
          "status": {
            "const": "complete"
          }
        }
      },
      {
        "required": [
          "status",
          "failure_reason"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          }
        }
      }
    ]
  }
}
