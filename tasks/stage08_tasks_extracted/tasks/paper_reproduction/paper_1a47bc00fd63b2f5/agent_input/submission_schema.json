{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required_files": ["report/results.json"],
  "primary_result_file": "report/results.json",
  "result_schema": {
   "type": "object",
   "required": ["status", "system", "candidates", "coverage", "conclusion"],
   "properties": {
    "status": {"type": "string", "enum": ["completed", "bounded_failure"]},
    "system": {"type": "object", "required": ["substrate_id", "catalyst_id", "reference_state", "method"], "properties": {"substrate_id": {"type": "string"}, "catalyst_id": {"type": "string"}, "reference_state": {"type": "string"}, "method": {"type": "object"}}},
    "candidates": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["candidate_id", "channel", "structure_identity", "validation_status", "validation_evidence", "frequency_evidence", "irc_evidence"], "properties": {"candidate_id": {"type": "string"}, "channel": {"type": "string", "enum": ["ortho_4_hydroxybenzofuran", "para_6_hydroxybenzofuran"]}, "structure_identity": {"type": "string"}, "validation_status": {"type": "string"}, "validation_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "frequency_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "irc_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "gibbs_barrier_kcal_mol": {"type": "number"}, "imaginary_frequency_cm-1": {"type": "number"}, "irc_endpoint": {"type": "string"}}}},
    "coverage": {"type": "object", "required": ["conformer_generation", "deduplication", "stopping_basis", "unresolved_alternatives"], "properties": {"conformer_generation": {"type": "string"}, "deduplication": {"type": "string"}, "stopping_basis": {"type": "string"}, "unresolved_alternatives": {"type": "array", "items": {"type": "string"}}}},
    "barrier_comparison": {"type": "object", "oneOf": [{"required": ["ortho_barrier_kcal_mol", "para_barrier_kcal_mol", "signed_delta_delta_g_kcal_mol", "sign_convention"], "properties": {"ortho_barrier_kcal_mol": {"type": "number"}, "para_barrier_kcal_mol": {"type": "number"}, "signed_delta_delta_g_kcal_mol": {"type": "number"}, "sign_convention": {"type": "string"}}}, {"required": ["availability", "reason"], "properties": {"availability": {"const": "not_available"}, "reason": {"type": "string"}}}]},
    "failure_report": {"type": "object", "required": ["failed_channels", "attempted_candidate_ids", "limitation"], "properties": {"failed_channels": {"type": "array", "minItems": 1, "items": {"type": "string", "enum": ["ortho_4_hydroxybenzofuran", "para_6_hydroxybenzofuran"]}}, "attempted_candidate_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "limitation": {"type": "string"}}},
    "conclusion": {"type": "object", "required": ["claim", "limitations"], "properties": {"claim": {"type": "string"}, "limitations": {"type": "array", "items": {"type": "string"}}}}
   },
   "oneOf": [{"properties": {"status": {"const": "completed"}, "barrier_comparison": {"required": ["ortho_barrier_kcal_mol", "para_barrier_kcal_mol", "signed_delta_delta_g_kcal_mol", "sign_convention"]}}, "required": ["barrier_comparison"]}, {"properties": {"status": {"const": "bounded_failure"}, "barrier_comparison": {"required": ["availability", "reason"]}}, "required": ["barrier_comparison", "failure_report"]}]
  }
}
