{
  "paper_id": "paper_a21b91f97ce3c68f",
  "rules": [
    {
      "rule_id": "r_ar_minimum",
      "type": "condition",
      "expected": "Minimum/stationarity evidence is present and scientifically interpretable.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.minimum_validation"
        ],
        "comparison": "expert check"
      },
      "reference_id": "kp_ar_process_minimum"
    },
    {
      "rule_id": "r_ar_pairs",
      "type": "condition",
      "expected": "Three pair objects identify Sn atom, carbon atom and distance.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.sn_bu_pairs"
        ],
        "comparison": "expert check"
      },
      "reference_id": "kp_ar_process_pairs"
    },
    {
      "rule_id": "r_ar_mean",
      "type": "numeric",
      "target": -217,
      "unit": "Hz",
      "tolerance": 15,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.sn_bu_pairs",
          "$.mean_coupling_hz",
          "$.method"
        ],
        "comparison": "absolute difference"
      },
      "reference_id": "kp_ar_result_mean",
      "expected": "Recompute the signed arithmetic mean of all three identified full Sn-C coupling values. FC-only, absolute-value or empirically corrected values cannot silently replace the declared full coupling."
    },
    {
      "rule_id": "r_ar_conclusion",
      "type": "semantic",
      "expected": "A validated, sign-aware coupling result is reported with limitations and interpretation bounded to the supplied system.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion",
          "$.limitations"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "c_ar_final"
    }
  ]
}
