{
  "paper_id": "paper_3d1d9b7f6df049da",
  "rules": [
    {
      "rule_id": "r_input",
      "type": "semantic",
      "expected": "validation documented",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation.input_checks",
          "$.validation.frequency_run"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "kp_input",
      "target": null
    },
    {
      "rule_id": "r_assign",
      "type": "semantic",
      "expected": "per-mode assignment evidence",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.validation.assignment_rule",
          "$.isomers.Ih.modes[].assignment_evidence",
          "$.isomers.D5h.modes[].assignment_evidence"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "kp_assign",
      "target": null
    },
    {
      "rule_id": "r_ih",
      "type": "numeric",
      "expected": "Ih four-mode source set from SI Table S3a: 49.9,54.9,65.2,68.9 cm-1; do not omit the fourth lateral mode.",
      "unit": "cm-1",
      "tolerance": 12,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": ["$.isomers.Ih.modes[].frequency_cm-1"],
        "comparison": "Sort four physically assigned lateral modes and the four reference frequencies; each absolute paired difference must be <=12 cm-1. Disclose mode mixing and additional candidates. Do not use gold proximity to choose modes."
      },
      "reference_id": "kp_ih",
      "target": [49.9, 54.9, 65.2, 68.9]
    },
    {
      "rule_id": "r_d5h",
      "type": "numeric",
      "expected": "D5h four-mode source set from SI Table S3b: 67.4,81.9,90.2,93.8 cm-1.",
      "unit": "cm-1",
      "tolerance": 12,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": ["$.isomers.D5h.modes[].frequency_cm-1"],
        "comparison": "Sort four physically assigned lateral modes and the four reference frequencies; each absolute paired difference must be <=12 cm-1. Disclose mode mixing and additional candidates. Do not use gold proximity to choose modes."
      },
      "reference_id": "kp_d5h",
      "target": [67.4, 81.9, 90.2, 93.8]
    },
    {
      "rule_id": "r_trend",
      "type": "ordering",
      "expected": "D5h higher",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.comparison.direction"
        ],
        "comparison": "expert ordering comparison"
      },
      "reference_id": "c_trend",
      "target": null
    },
    {
      "rule_id": "r_relax",
      "type": "semantic",
      "expected": "higher D5h modes support longer T1 and limitations",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.interpretation",
          "$.limitations"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "c_relax",
      "target": null
    }
  ]
}
