{
  "required_files": ["report/results.json"],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": ["status", "method", "validation", "reaction_1a", "reaction_1h", "comparison", "limitations"],
    "properties": {
      "status": {"type": "string", "enum": ["complete", "bounded_failure"]},
      "method": {"type": "object", "required": ["software", "electronic_structure_method", "solvation_model", "thermal_convention", "reference_construction"], "properties": {"software": {"type": "string"}, "electronic_structure_method": {"type": "string"}, "solvation_model": {"type": "string"}, "thermal_convention": {"type": "string"}, "reference_construction": {"type": "string"}}},
      "validation": {"type": "object", "required": ["state_checks", "conformer_coverage", "minimum_validation", "convergence_criterion"], "properties": {"state_checks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["species_id", "charge", "multiplicity", "stoichiometry_checked"], "properties": {"species_id": {"type": "string"}, "charge": {"type": "integer"}, "multiplicity": {"type": "integer"}, "stoichiometry_checked": {"type": "boolean"}}}}, "conformer_coverage": {"type": "string"}, "minimum_validation": {"type": "string"}, "convergence_criterion": {"type": "string"}}},
      "reaction_1a": {"type": "object", "oneOf": [{"required": ["outcome", "potential_V_vs_Fc", "reaction_free_energy_kJ_mol", "validation_summary", "coverage"], "properties": {"outcome": {"const": "computed"}, "potential_V_vs_Fc": {"type": "number"}, "reaction_free_energy_kJ_mol": {"type": "number"}, "validation_summary": {"type": "string", "minLength": 1}, "coverage": {"type": "string", "minLength": 1}}}, {"required": ["outcome", "potential_V_vs_Fc", "reaction_free_energy_kJ_mol", "validation_summary", "failure_reason", "coverage"], "properties": {"outcome": {"const": "not_computed"}, "potential_V_vs_Fc": {"type": "null"}, "reaction_free_energy_kJ_mol": {"type": "null"}, "validation_summary": {"type": "string", "minLength": 1}, "failure_reason": {"type": "string", "minLength": 1}, "coverage": {"type": "string", "minLength": 1}}}]},
      "reaction_1h": {"type": "object", "oneOf": [{"required": ["outcome", "potential_V_vs_Fc", "reaction_free_energy_kJ_mol", "validation_summary", "coverage"], "properties": {"outcome": {"const": "computed"}, "potential_V_vs_Fc": {"type": "number"}, "reaction_free_energy_kJ_mol": {"type": "number"}, "validation_summary": {"type": "string", "minLength": 1}, "coverage": {"type": "string", "minLength": 1}}}, {"required": ["outcome", "potential_V_vs_Fc", "reaction_free_energy_kJ_mol", "validation_summary", "failure_reason", "coverage"], "properties": {"outcome": {"const": "not_computed"}, "potential_V_vs_Fc": {"type": "null"}, "reaction_free_energy_kJ_mol": {"type": "null"}, "validation_summary": {"type": "string", "minLength": 1}, "failure_reason": {"type": "string", "minLength": 1}, "coverage": {"type": "string", "minLength": 1}}}]},
      "comparison": {"oneOf": [{"required": ["ordering", "difference_V", "conclusion"], "properties": {"ordering": {"type": "string", "minLength": 1}, "difference_V": {"type": "number"}, "conclusion": {"type": "string", "minLength": 1}}}, {"required": ["ordering", "difference_V", "conclusion", "failure_reason"], "properties": {"ordering": {"type": "null"}, "difference_V": {"type": "null"}, "conclusion": {"type": "string", "minLength": 1}, "failure_reason": {"type": "string", "minLength": 1}}}]},
      "limitations": {"type": "array", "items": {"type": "string"}}
    }
  }
}
