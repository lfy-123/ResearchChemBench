{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "required": [
      "status",
      "method",
      "candidate_search",
      "minimum",
      "candidates",
      "conclusion",
      "limitations",
      "outcome"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "validated_success",
          "bounded_failure"
        ]
      },
      "method": {
        "type": "object",
        "required": [
          "software",
          "method_description"
        ],
        "properties": {
          "software": {
            "type": "string"
          },
          "method_description": {
            "type": "string"
          }
        }
      },
      "candidate_search": {
        "type": "object",
        "required": [
          "generation_rule",
          "deduplication_rule",
          "stopping_rule",
          "coverage_statement"
        ],
        "properties": {
          "generation_rule": {
            "type": "string"
          },
          "deduplication_rule": {
            "type": "string"
          },
          "stopping_rule": {
            "type": "string"
          },
          "coverage_statement": {
            "type": "string"
          }
        }
      },
      "minimum": {
        "type": "object",
        "required": [
          "energy_hartree",
          "imaginary_frequency_count",
          "frequency_evidence"
        ],
        "properties": {
          "energy_hartree": {
            "type": "number"
          },
          "imaginary_frequency_count": {
            "type": "integer",
            "minimum": 0
          },
          "frequency_evidence": {
            "type": "string"
          }
        }
      },
      "candidates": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "candidate_id",
            "outcome",
            "imaginary_frequency_count",
            "imaginary_mode_evidence",
            "connectivity_evidence"
          ],
          "properties": {
            "candidate_id": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            },
            "energy_hartree": {
              "type": "number"
            },
            "imaginary_frequency_count": {
              "type": "integer",
              "minimum": 0
            },
            "imaginary_mode_evidence": {
              "type": "string"
            },
            "connectivity_evidence": {
              "type": "string"
            }
          }
        }
      },
      "selected_candidate_id": {
        "type": "string"
      },
      "conclusion": {
        "type": "string"
      },
      "limitations": {
        "type": "string"
      },
      "outcome": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "barrier"
            ],
            "properties": {
            "barrier": {"type":"object","required":["value","unit","calculation"],"properties":{"value":{"type":"number"},"unit":{"type":"string"},"calculation":{"type":"string"}}}
            }
          },
          {
            "type": "object",
            "required": [
              "failure_reason"
            ],
            "properties": {
              "failure_reason": {"type":"string"}
            }
          }
        ]
      }
    }
  }
}
