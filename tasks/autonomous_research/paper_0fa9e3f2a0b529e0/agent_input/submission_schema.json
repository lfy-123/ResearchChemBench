      "validation": {"type": "object", "required": ["optimization_converged", "minimum_check", "imaginary_frequency_count", "identity_check", "details"], "properties": {"optimization_converged": {"type": "boolean"}, "minimum_check": {"type": "string"}, "imaginary_frequency_count": {"type": "integer"}, "identity_check": {"type": "boolean"}, "details": {"type": "string"}}},
