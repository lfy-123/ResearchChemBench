{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "oneOf": [
      {
        "required": [
          "status",
          "system",
          "candidates",
          "selected_transition",
          "conclusion"
        ],
        "properties": {
          "status": {
            "const": "complete"
          },
          "system": {
            "type": "object",
            "required": [
              "smiles",
              "charge",
              "multiplicity",
              "solvent"
            ],
            "properties": {
              "smiles": {
                "type": "string"
              },
              "charge": {
                "type": "integer"
              },
              "multiplicity": {
                "type": "integer"
              },
              "solvent": {
                "type": "string"
              }
            }
          },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "candidate_id",
                "structure_reference",
                "minimum_validation",
                "state_selection_evidence"
              ],
              "properties": {
                "candidate_id": {
                  "type": "string"
                },
                "structure_reference": {
                  "type": "string"
                },
                "minimum_validation": {
                  "type": "string"
                },
                "state_selection_evidence": {
                  "type": "string"
                }
              }
            }
          },
          "selected_transition": {
            "type": "object",
            "required": [
              "candidate_id",
              "state_label",
              "energy_kcal_mol",
              "oscillator_strength",
              "character",
              "evidence"
            ],
            "properties": {
              "candidate_id": {
                "type": "string"
              },
              "state_label": {
                "type": "string"
              },
              "energy_kcal_mol": {
                "type": "number"
              },
              "oscillator_strength": {
                "type": "number"
              },
              "character": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            }
          },
          "conclusion": {
            "type": "string"
          }
        }
      },
      {
        "required": [
          "status",
          "failure"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "failure": {
            "type": "object",
            "required": [
              "attempts",
              "limitation"
            ],
            "properties": {
              "attempts": {
                "type": "string"
              },
              "limitation": {
                "type": "string"
              }
            }
          }
        }
      }
    ]
  }
}
