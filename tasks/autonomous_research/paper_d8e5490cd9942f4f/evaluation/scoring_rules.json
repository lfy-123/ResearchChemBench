{
  "paper_id": "paper_d8e5490cd9942f4f",
  "rules": [
    {
      "rule_id": "r_kp_process_minima",
      "reference_id": "kp_process_minima",
      "type": "semantic",
      "expected": "Two endpoint validation records with imaginary-mode diagnostics.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.endpoints[].id",
          "$.endpoints[].identity",
          "$.endpoints[].validation_status",
          "$.endpoints[].imaginary_mode_count",
          "$.investigation"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "r_kp_process_consistency",
      "reference_id": "kp_process_consistency",
      "type": "semantic",
      "expected": "Same treatment and a clearly stated anti-minus-syn difference.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.endpoints[].id",
          "$.endpoints[].free_energy",
          "$.endpoints[].free_energy_unit",
          "$.route",
          "$.investigation",
          "$.investigation"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "r_kp_result_delta_g",
      "reference_id": "kp_result_delta_g",
      "type": "numeric",
      "target": 4.2,
      "unit": "kcal/mol",
      "tolerance": 1.0,
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion.delta_g_conf",
          "$.conclusion.delta_g_unit"
        ],
        "comparison": "absolute difference"
      }
    },
    {
      "rule_id": "r_c_final_preference",
      "reference_id": "c_final_preference",
      "type": "semantic",
      "expected": "The supplied syn endpoint is preferred under the source convention, with positive G(anti) \u2212 G(syn).",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      }
    },
    {
      "rule_id": "r_c_limitation",
      "reference_id": "c_limitation",
      "type": "semantic",
      "expected": "The conclusion is conditional on the selected model, standard state and sampled endpoints.",
      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
