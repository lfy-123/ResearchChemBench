      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": ["$.harmonic.status", "$.harmonic.imaginary_modes"],
        "comparison": "condition"
      },
      "reference_id": "ar_result_harmonic"
    },
    {
      "rule_id": "ar_r4",
      "type": "condition",
      "expected": "When finite_temperature.status is completed, finite_temperature.retained is true for the sampled interval; when status is bounded_failure, the submission reports the attempted scope and reason without fabricating finite-temperature observables.",
