          "status": {"const": "bounded_failure"},
          "failure": {"type": "object", "required": ["failed_object", "attempted_method", "evidence"], "properties": {"failed_object": {"type": "string"}, "attempted_method": {"type": "string"}, "evidence": {"type": "string"}}},
          "limitations": {"type": "string"}
        }
      }
    ]
  }
}
