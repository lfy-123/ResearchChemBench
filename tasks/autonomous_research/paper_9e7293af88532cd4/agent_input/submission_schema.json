          "endpoints": {"type": "array", "minItems": 2, "items": {"type": "object", "required": ["name", "geometry_path_or_summary", "charge", "multiplicity", "energy", "energy_unit", "converged", "validation_evidence"], "properties": {"name": {"type": "string", "enum": ["reactant_1", "product_3"]}, "geometry_path_or_summary": {"type": "string"}, "charge": {"type": "integer"}, "multiplicity": {"type": "integer"}, "energy": {"type": "number"}, "energy_unit": {"type": "string"}, "converged": {"type": "boolean"}, "validation_evidence": {"type": "array", "items": {"type": "string"}}}}},
          "delta_g_product_minus_reactant_kcal_mol": {"type": "number"},
          "diagnostic": {"type": "object", "required": ["description", "result", "evidence"], "properties": {"description": {"type": "string"}, "result": {"type": "string"}, "evidence": {"type": "array", "items": {"type": "string"}}}},
          "interpretation": {"type": "string"},
          "conclusion": {"type": "string"},
          "limitations": {"type": "string"}
        }
      },
      {
        "required": ["status", "failure", "limitations"],
