        "fields": [
          "$.conformers",
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "kp_result_01"
    },
    {
      "rule_id": "r_kp_result_02",
      "target_type": "key_point",
      "type": "semantic",
