      "binding": {
        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.population_analysis",
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "kp_result_02"
    },
    {
      "rule_id": "r_kp_result_03",
      "target_type": "key_point",
