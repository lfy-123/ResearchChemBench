        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.protocol",
          "$.validation"
        ],
        "comparison": "expert verification"
      },
      "reference_id": "ar_process_md"
    },
    {
      "rule_id": "ar_rule_rmsd",
