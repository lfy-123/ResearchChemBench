          "report/results.json"
        ],
        "fields": [
          "$.observables.rmsd",
          "$.conclusion"
        ],
        "comparison": "expert semantic comparison"
      },
      "reference_id": "ar_rmsd"
    },
    {
      "rule_id": "ar_rule_contacts",
