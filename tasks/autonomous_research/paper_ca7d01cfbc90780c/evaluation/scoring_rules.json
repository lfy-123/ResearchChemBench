        "artifact_paths": [
          "report/results.json"
        ],
        "fields": [
          "$.poses",
          "$.validation.stopping_reason"
        ],
        "comparison": "expert verification"
      },
      "reference_id": "ar_process_search"
    },
    {
      "rule_id": "ar_rule_md",
      "type": "condition",
      "expected": "Protocol and validation fields document physical checks and analysis definitions.",
