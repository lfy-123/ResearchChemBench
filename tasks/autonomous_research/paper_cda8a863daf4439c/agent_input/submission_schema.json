{
  "required_files": [
    "report/results.json"
  ],
  "primary_result_file": "report/results.json",
  "result_schema": {
    "type": "object",
    "oneOf": [
      {
        "required": [
          "status",
          "candidates",
          "validation",
          "comparison",
          "competing_explanations",
          "conclusion"
        ],
        "properties": {
          "status": {
            "const": "complete"
          },
          "candidates": {
            "type": "array",
            "minItems": 12
          },
          "validation": {
            "type": "array",
            "minItems": 12
          }
        }
      },
      {
        "required": [
          "status",
          "candidates",
          "validation",
          "comparison",
          "competing_explanations",
          "conclusion",
          "missing_objects",
          "search_coverage"
        ],
        "properties": {
          "status": {
            "const": "bounded_failure"
          },
          "missing_objects": {
            "type": "array",
            "minItems": 1
          },
          "search_coverage": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": [
          "complete",
          "bounded_failure"
        ]
      },
      "candidates": {
        "type": "array",
        "items": {
          "type": "object",
          "oneOf": [
            {
              "required": [
                "candidate_id",
                "object_id",
                "medium",
                "coverage_id",
                "step",
                "deltaG_eV",
                "barrier_eV",
                "identity",
                "selection_context"
              ]
            },
            {
              "required": [
                "candidate_id",
                "object_id",
                "medium",
                "coverage_id",
                "step",
                "failure_reason",
                "selection_context"
              ]
            }
          ],
          "properties": {
            "candidate_id": {
              "type": "string"
            },
            "object_id": {
              "type": "string"
            },
            "medium": {
              "type": "string"
            },
            "coverage_id": {
              "type": "string"
            },
            "step": {
              "type": "string"
            },
            "deltaG_eV": {
              "type": "number"
            },
            "barrier_eV": {
              "type": "number"
            },
            "failure_reason": {
              "type": "string"
            },
            "identity": {
              "type": "object",
              "required": [
                "structure_hash",
                "charge",
                "multiplicity"
              ],
              "properties": {
                "structure_hash": {
                  "type": "string"
                },
                "charge": {
                  "type": "number",
                  "description": "Net cell charge in units of e; grand-canonical electrode calculations may have fractional charge. State the neutral electron-count convention in method or identity."
                },
                "multiplicity": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "description": "Molecular spin multiplicity when defined; null for a periodic grand-canonical state without a pure spin multiplicity."
                },
                "electron_count": {
                  "type": "number"
                },
                "potential_vs_SHE": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            },
            "selection_context": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "validation": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "candidate_id",
            "endpoint_continuity",
            "optimization_converged",
            "ts_or_path_evidence"
          ],
          "properties": {
            "candidate_id": {
              "type": "string"
            },
            "endpoint_continuity": {
              "type": "boolean"
            },
            "optimization_converged": {
              "type": "boolean"
            },
            "ts_or_path_evidence": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "comparison": {
        "type": "object",
        "required": [
          "medium_comparison",
          "coverage_comparison",
          "sensitivity"
        ],
        "properties": {
          "medium_comparison": {
            "type": "string"
          },
          "coverage_comparison": {
            "type": "string"
          },
          "sensitivity": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "competing_explanations": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "conclusion": {
        "type": "string"
      },
      "missing_objects": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "search_coverage": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
