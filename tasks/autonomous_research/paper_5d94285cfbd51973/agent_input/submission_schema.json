      "properties": {"type": "object", "required": ["homo_ev", "lumo_ev", "gap_ev", "dipole_debye", "ip_ev", "ea_ev", "hardness_ev", "softness_ev_inverse", "chemical_potential_ev", "electronegativity_ev", "electrophilicity_ev"], "properties": {"homo_ev": {"type": "number"}, "lumo_ev": {"type": "number"}, "gap_ev": {"type": "number"}, "dipole_debye": {"type": "number"}, "ip_ev": {"type": "number"}, "ea_ev": {"type": "number"}, "hardness_ev": {"type": "number"}, "softness_ev_inverse": {"type": "number"}, "chemical_potential_ev": {"type": "number"}, "electronegativity_ev": {"type": "number"}, "electrophilicity_ev": {"type": "number"}}},
