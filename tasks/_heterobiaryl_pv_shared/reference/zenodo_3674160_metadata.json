{"created": "2020-02-19T00:50:57.677053+00:00", "modified": "2024-07-22T12:29:42.359491+00:00", "id": 3674160, "conceptrecid": "3662845", "doi": "10.5281/zenodo.3674160", "conceptdoi": "10.5281/zenodo.3662845", "doi_url": "https://doi.org/10.5281/zenodo.3674160", "metadata": {"title": "Data Supporting GoodVibes: automated thermochemistry for heterogeneous computational chemistry data", "doi": "10.5281/zenodo.3674160", "publication_date": "2020-02-11", "description": "<p>These files are provided in support of the use case in a recent manuscript showing the use of the Python package <a href=\"https://github.com/bobbypaton/GoodVibes\">GoodVibes</a>.</p>\n\n<p>This data set contains Gaussian optimization and frequency calculations on 25 molecules, along with 25 corresponding ORCA single point energy calculations, a YAML file to dictate and format the reaction pathway, and example outputs of the tabulated thermochemistry and a PNG of the potential energy surface graph output.<br>\nTo generate these output files, the command:</p>\n\n<pre><code class=\"language-bash\">python -m goodvibes *.log --spc DLPNO --pes PhPy.yaml --graph PhPy.yaml -t 353.15 --imag --invertifreq -5 --media ethanol -c 1\n</code></pre>\n\n<p>was run in the directory containing the calculation output (.log and .out) files.</p>", "access_right": "open", "creators": [{"name": "Luchini, Guilian", "affiliation": "Colorado State University", "orcid": "0000-0003-0135-9624"}, {"name": "Alegre-Requena, Juan V.", "affiliation": "Colorado State University", "orcid": "0000-0002-0769-7168"}, {"name": "Paton, Robert S.", "affiliation": "Colorado State University", "orcid": "0000-0002-0104-4166"}], "keywords": ["GoodVibes", "Thermodynamics", "Thermochemistry", "Quantum Chemistry", "Automation", "quasi-harmonic", "quasi-RRHO"], "related_identifiers": [{"identifier": "10.5281/zenodo.595246.", "relation": "references", "resource_type": "software", "scheme": "doi"}], "version": "1.0", "language": "eng", "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "relations": {"version": [{"index": 1, "is_last": true, "parent": {"pid_type": "recid", "pid_value": "3662845"}}]}}, "title": "Data Supporting GoodVibes: automated thermochemistry for heterogeneous computational chemistry data", "links": {"self": "https://zenodo.org/api/records/3674160", "self_html": "https://zenodo.org/records/3674160", "preview_html": "https://zenodo.org/records/3674160?preview=1", "doi": "https://doi.org/10.5281/zenodo.3674160", "self_doi": "https://doi.org/10.5281/zenodo.3674160", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.3674160", "reserve_doi": "https://zenodo.org/api/records/3674160/draft/pids/doi", "parent": "https://zenodo.org/api/records/3662845", "parent_html": "https://zenodo.org/records/3662845", "parent_doi": "https://doi.org/10.5281/zenodo.3662845", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.3662845", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:3674160/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:3674160/sequence/default", "files": "https://zenodo.org/api/records/3674160/files", "media_files": "https://zenodo.org/api/records/3674160/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:3674160:Rxn_profile_PhPy.png/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:3674160:Rxn_profile_PhPy.png/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:3674160:Rxn_profile_PhPy.png/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:3674160:Rxn_profile_PhPy.png/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:3674160:Rxn_profile_PhPy.png/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:3674160:Rxn_profile_PhPy.png/full/%5E1200,/0/default.jpg"}, "archive": "https://zenodo.org/api/records/3674160/files-archive", "archive_media": "https://zenodo.org/api/records/3674160/media-files-archive"