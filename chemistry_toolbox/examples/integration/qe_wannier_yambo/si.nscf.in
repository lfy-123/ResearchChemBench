&CONTROL
  calculation = 'nscf'
  prefix = 'si'
  outdir = './tmp'
  pseudo_dir = './pseudo'
/
&SYSTEM
  ibrav = 2
  celldm(1) = 10.26
  nat = 2
  ntyp = 1
  ecutwfc = 30.0
  ecutrho = 240.0
  nbnd = 4
  nosym = .true.
  noinv = .true.
/
&ELECTRONS
  conv_thr = 1.0d-8
  diago_full_acc = .true.
/
