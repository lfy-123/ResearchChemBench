new file mode 100644
index 0000000..fcbe663
--- /dev/null
+++ b/kinbot/ase_modules/calculators/nwchem.py
@@ -0,0 +1,53 @@
+import os
+import hashlib
+from pathlib import Path
+
+from ase.calculators.nwchem import NWChem as _AseNWChem
+
+
+class NWChem(_AseNWChem):
+    """ASE NWChem calculator with a portable KinBot command override."""
+
+    command = os.environ.get(
+        "KINBOT_NWCHEM_COMMAND", "nwchem PREFIX.nwi > PREFIX.out"
+    )
+
+    def __init__(self, *args, **kwargs):
+        # KinBot 2.2.x emits keywords for an older ASE NWChem writer.
+        # Translate them to the nested blocks expected by current ASE.
+        mult = kwargs.pop("mult", 1)
+        odft = kwargs.pop("odft", False)
+        dft = dict(kwargs.pop("dft", {}))
+        dft["mult"] = mult
+        if odft:
+            dft["odft"] = None
+        kwargs["dft"] = dft
+
+        driver_mode = kwargs.pop("driver", None)
+        driver = {}
+        if driver_mode and driver_mode != "default":
+            driver[driver_mode] = None
+        for key in ("maxiter", "clear", "inhess"):
+            if key in kwargs:
+                driver[key] = kwargs.pop(key)
+        if driver:
+            kwargs["driver"] = driver
+
+        short_root = os.environ.get("KINBOT_NWCHEM_WORK_ROOT")
+        if short_root:
+            job_key = hashlib.sha256(os.getcwd().encode("utf-8")).hexdigest()[:12]
+            job_root = Path(short_root) / job_key
+            scratch = job_root / "scratch"
+            permanent = job_root / "perm"
+            scratch.mkdir(parents=True, exist_ok=True)
+            permanent.mkdir(parents=True, exist_ok=True)
+            kwargs.pop("scratch_dir", None)
+            kwargs.pop("permanent_dir", None)
+            kwargs["scratch"] = str(scratch)
+            kwargs["perm"] = str(permanent)
+        else:
+            if "scratch_dir" in kwargs:
+                kwargs["scratch"] = kwargs.pop("scratch_dir")
+            if "permanent_dir" in kwargs:
+                kwargs["perm"] = kwargs.pop("permanent_dir")
+        super().__init__(*args, **kwargs)
